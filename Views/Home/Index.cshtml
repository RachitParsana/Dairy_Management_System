@model Dairy_Management_System.Models.Dashboard.AdminDashboardViewModel
@using System.Security.Claims
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Admin Dashboard";
    ViewData["ActiveMenu"] = "Dashboard";

    var adminUsername = User.Identity?.Name ?? "admin";
    var adminFullName = User.FindFirst(ClaimTypes.GivenName)?.Value;
    var adminDisplayName = !string.IsNullOrWhiteSpace(adminFullName) ? adminFullName : adminUsername;

    // Shift metrics safely retrieved
    var morningShift = Model.ShiftBreakdown.FirstOrDefault(s => string.Equals(s.Shift, "Morning", StringComparison.OrdinalIgnoreCase))
                       ?? new Dairy_Management_System.Models.Dashboard.TodayDeliveryShiftBreakdownDto { Shift = "Morning" };
    var eveningShift = Model.ShiftBreakdown.FirstOrDefault(s => string.Equals(s.Shift, "Evening", StringComparison.OrdinalIgnoreCase))
                       ?? new Dairy_Management_System.Models.Dashboard.TodayDeliveryShiftBreakdownDto { Shift = "Evening" };
}

<!-- Environment & Status Header Bar -->
<div class="card border-0 bg-white shadow-sm mb-4">
    <div class="card-body py-3 px-3 px-md-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle p-2 text-white bg-success d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background-color: #059669 !important;">
                <i class="cil-speedometer fs-4"></i>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h5 class="mb-0 fw-bold text-dark">Enterprise Overview</h5>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Live Database</span>
                </div>
                <div class="text-muted small">
                    Administrator: <strong>@adminDisplayName</strong> &bull; Dairy Operations &amp; Receivables Hub
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-secondary border px-3 py-2 font-tabular">
                <i class="cil-calendar me-1"></i> @DateTime.Now.ToString("MMMM dd, yyyy")
            </span>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                <i class="cil-check-circle me-1"></i> System Operational
            </span>
        </div>
    </div>
</div>

<!-- Primary Real-Time Operational KPI Cards Row -->
<div class="row g-3 mb-4">
    <!-- KPI 1: Active Customers -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Active Customers</span>
                    <div class="p-2 bg-success bg-opacity-10 text-success rounded-3">
                        <i class="cil-people fs-5"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-1">
                    <h3 class="mb-0 fw-bold text-dark font-tabular">@Model.ActiveCustomers</h3>
                    <span class="text-muted small">/ @Model.TotalCustomers total</span>
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small mt-2">
                    <span>Active Route Roster</span>
                    <a href="~/Customer" class="text-success text-decoration-none fw-medium">View Master &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI 2: Today's Delivery Volume & Drops -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Today's Delivery</span>
                    <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3">
                        <i class="cil-drop fs-5"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-1">
                    <h3 class="mb-0 fw-bold text-dark font-tabular">@Model.TodayDeliveredLitres.ToString("N2") <span class="fs-6 fw-normal text-muted">L</span></h3>
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small mt-2">
                    <span>
                        <span class="text-success fw-semibold">@Model.TodayCompletedDrops done</span> &bull; 
                        <span class="text-warning fw-semibold">@Model.TodayPendingDrops pend</span>
                    </span>
                    <a href="~/DailyMilk/AdminIndex" class="text-primary text-decoration-none fw-medium">Runsheet &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI 3: Current Month Invoiced Amount -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Monthly Invoiced</span>
                    <div class="p-2 bg-info bg-opacity-10 text-info rounded-3">
                        <i class="cil-description fs-5"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-1">
                    <h3 class="mb-0 fw-bold text-dark font-tabular">₹ @Model.CurrentMonthBillingTotal.ToString("N2")</h3>
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small mt-2">
                    <span>Collected: ₹ @Model.CurrentMonthCollectedTotal.ToString("N2")</span>
                    <span class="badge @(Model.CurrentMonthCollectionEfficiencyPercent >= 80 ? "bg-success-subtle text-success border border-success-subtle" : "bg-warning-subtle text-warning border border-warning-subtle")">
                        @Model.CurrentMonthCollectionEfficiencyPercent.ToString("F1")%
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI 4: Total Outstanding Receivables -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Total Outstanding</span>
                    <div class="p-2 bg-danger bg-opacity-10 text-danger rounded-3">
                        <i class="cil-cash fs-5"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-1">
                    <h3 class="mb-0 fw-bold text-danger font-tabular">₹ @Model.TotalOutstandingBalance.ToString("N2")</h3>
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small mt-2">
                    <span>@Model.UnpaidInvoicesCount Unpaid Bills</span>
                    <a href="~/Billing/Reports" class="text-danger text-decoration-none fw-medium">Collections &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Approved Month-Based Ageing Receivables Strip -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3 p-md-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <div>
                <h6 class="fw-bold text-dark mb-0"><i class="cil-clock text-secondary me-2"></i>Approved Customer Balance Ageing Buckets</h6>
                <div class="text-muted small">Strictly calculated from unpaid invoice ledger balances</div>
            </div>
            <a href="~/Reports/CustomerAging" class="btn btn-sm btn-outline-secondary">
                Detailed Aging Register &rarr;
            </a>
        </div>
        <div class="row g-2 text-center">
            <div class="col-6 col-md">
                <div class="p-2 rounded bg-light border">
                    <div class="text-muted small fw-medium">1 Mo (Current)</div>
                    <div class="fw-bold text-dark font-tabular fs-6">₹ @Model.UnpaidBalance1Month.ToString("N2")</div>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="p-2 rounded bg-light border">
                    <div class="text-muted small fw-medium">2 Months</div>
                    <div class="fw-bold text-dark font-tabular fs-6">₹ @Model.UnpaidBalance2Months.ToString("N2")</div>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="p-2 rounded bg-light border">
                    <div class="text-muted small fw-medium">3 Months</div>
                    <div class="fw-bold text-dark font-tabular fs-6">₹ @Model.UnpaidBalance3Months.ToString("N2")</div>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="p-2 rounded bg-light border">
                    <div class="text-muted small fw-medium">4–5 Months</div>
                    <div class="fw-bold text-warning-emphasis font-tabular fs-6">₹ @Model.UnpaidBalance4To5Months.ToString("N2")</div>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="p-2 rounded bg-danger bg-opacity-10 border border-danger border-opacity-25">
                    <div class="text-danger small fw-medium">6+ Months</div>
                    <div class="fw-bold text-danger font-tabular fs-6">₹ @Model.UnpaidBalance6PlusMonths.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js Analytics & Shift Rollup Row -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Current Month Billing Settlement Breakdown -->
    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                <h6 class="mb-0 fw-bold text-dark">
                    <i class="cil-chart-pie text-success me-2"></i>Current Month Billing &amp; Collections
                </h6>
                <span class="badge bg-light text-secondary border font-tabular">@DateTime.Now.ToString("MMMM yyyy")</span>
            </div>
            <div class="card-body p-3 p-md-4">
                <div style="height: 260px; position: relative;">
                    <canvas id="adminBillingChart"></canvas>
                </div>
                <div class="d-flex justify-content-around text-center mt-3 pt-3 border-top small text-muted">
                    <div>
                        <span class="d-block fw-bold text-dark font-tabular fs-6">₹ @Model.CurrentMonthBillingTotal.ToString("N2")</span>
                        <span>Total Invoiced</span>
                    </div>
                    <div>
                        <span class="d-block fw-bold text-success font-tabular fs-6">₹ @Model.CurrentMonthCollectedTotal.ToString("N2")</span>
                        <span>Total Collected</span>
                    </div>
                    <div>
                        <span class="d-block fw-bold text-danger font-tabular fs-6">₹ @Model.TotalOutstandingBalance.ToString("N2")</span>
                        <span>Total Outstanding</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 2: Today's Shift Distribution Breakdown -->
    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                <h6 class="mb-0 fw-bold text-dark">
                    <i class="cil-layers text-primary me-2"></i>Today's Shift Distribution
                </h6>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-tabular">@Model.ActiveDeliveryBoys Delivery Boys</span>
            </div>
            <div class="card-body p-3 p-md-4">
                <div style="height: 220px; position: relative;">
                    <canvas id="adminShiftChart"></canvas>
                </div>
                <div class="row g-2 mt-2 pt-2 border-top text-center">
                    <div class="col-6">
                        <div class="p-2 rounded bg-light border">
                            <span class="badge bg-primary text-white mb-1">Morning Shift</span>
                            <div class="fw-bold text-dark font-tabular fs-6">@morningShift.DeliveredLitres.ToString("N2") L</div>
                            <div class="text-muted small">@morningShift.CompletedDeliveries Done &bull; @morningShift.PendingDeliveries Pend</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded bg-light border">
                            <span class="badge bg-warning text-dark mb-1">Evening Shift</span>
                            <div class="fw-bold text-dark font-tabular fs-6">@eveningShift.DeliveredLitres.ToString("N2") L</div>
                            <div class="text-muted small">@eveningShift.CompletedDeliveries Done &bull; @eveningShift.PendingDeliveries Pend</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Operational Deliveries Ledger & Quick Actions -->
<div class="row g-4 mb-4">
    <!-- Recent Deliveries Table -->
    <div class="col-12 col-xl-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                <h6 class="mb-0 fw-bold text-dark">
                    <i class="cil-list text-secondary me-2"></i>Recent Operational Deliveries
                </h6>
                <a href="~/DailyMilk/AdminIndex" class="btn btn-sm btn-outline-secondary">
                    All Deliveries &rarr;
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 font-tabular">
                        <thead class="table-light fs-7 text-uppercase text-secondary">
                            <tr>
                                <th class="ps-3">Date / Shift</th>
                                <th>Customer</th>
                                <th>Route</th>
                                <th>Category</th>
                                <th class="text-end">Volume</th>
                                <th class="text-end">Amount</th>
                                <th class="text-center pe-3">Status</th>
                            </tr>
                        </thead>
                        <tbody class="fs-6">
                            @if (Model.RecentDeliveries.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        <i class="cil-info fs-4 d-block mb-1 text-secondary"></i>
                                        No recent delivery records found for today.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.RecentDeliveries)
                                {
                                    <tr>
                                        <td class="ps-3 text-nowrap">
                                            <div class="fw-semibold text-dark">@item.EntryDate.ToString("MMM dd")</div>
                                            <span class="badge @(item.Shift == "Morning" ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-warning-subtle text-warning-emphasis border border-warning-subtle") fs-7">
                                                @item.Shift
                                            </span>
                                        </td>
                                        <td>
                                            <span class="fw-medium text-dark">@item.CustomerName</span>
                                        </td>
                                        <td>
                                            <span class="text-secondary small">@item.RouteName</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-secondary border">@item.PrimaryCategoryName</span>
                                        </td>
                                        <td class="text-end fw-semibold">
                                            @item.TotalLiquidVolumeLitres.ToString("N2") L
                                        </td>
                                        <td class="text-end fw-bold text-dark">
                                            ₹ @item.TotalAmount.ToString("N2")
                                        </td>
                                        <td class="text-center pe-3">
                                            @if (item.DeliveryStatus == "Delivered")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    <i class="cil-check me-1"></i> Delivered
                                                </span>
                                            }
                                            else if (item.DeliveryStatus == "Vacation")
                                            {
                                                <span class="badge bg-info-subtle text-info border border-info-subtle">
                                                    <i class="cil-beach me-1"></i> Vacation
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border">
                                                    @item.DeliveryStatus
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Operations & System Actions Card -->
    <div class="col-12 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-dark">
                    <i class="cil-bolt text-warning me-2"></i>Quick Administrative Actions
                </h6>
            </div>
            <div class="card-body p-3 p-md-4 d-flex flex-column gap-2 justify-content-between">
                <div class="list-group list-group-flush border-bottom mb-3">
                    <a href="~/Customer/Create" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-2 border-0">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 bg-success bg-opacity-10 text-success rounded-3">
                                <i class="cil-user-plus fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-semibold text-dark">Enroll New Customer</div>
                                <small class="text-muted">Register customer with subscription &amp; route</small>
                            </div>
                        </div>
                        <i class="cil-chevron-right text-muted"></i>
                    </a>

                    <a href="~/Billing/BulkBilling" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-2 border-0">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3">
                                <i class="cil-calculator fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-semibold text-dark">Monthly Billing Generation</div>
                                <small class="text-muted">Generate &amp; publish route statement cycles</small>
                            </div>
                        </div>
                        <i class="cil-chevron-right text-muted"></i>
                    </a>

                    <a href="~/Export" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-2 border-0">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 bg-secondary bg-opacity-10 text-secondary rounded-3">
                                <i class="cil-cloud-download fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-semibold text-dark">Export Data Hub</div>
                                <small class="text-muted">Download RFC 4180 compliant CSV statements</small>
                            </div>
                        </div>
                        <i class="cil-chevron-right text-muted"></i>
                    </a>

                    <a href="~/Notification" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-2 border-0">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 bg-warning bg-opacity-10 text-warning-emphasis rounded-3">
                                <i class="cil-bullhorn fs-5"></i>
                            </div>
                            <div>
                                <div class="fw-semibold text-dark">Broadcast System Alert</div>
                                <small class="text-muted">Notify route delivery boys and staff</small>
                            </div>
                        </div>
                        <i class="cil-chevron-right text-muted"></i>
                    </a>
                </div>

                <div class="alert alert-light border small text-muted mb-0 d-flex align-items-center gap-2">
                    <i class="cil-shield-alt text-success fs-5"></i>
                    <span>Role-Based Least Privilege Security Active. All database actions audited.</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof Chart === 'undefined') {
                console.warn('Chart.js library is not loaded. Displaying graceful fallback.');
                const chartCanvases = [document.getElementById('adminBillingChart'), document.getElementById('adminShiftChart')];
                chartCanvases.forEach(function (canvas) {
                    if (canvas && canvas.parentElement) {
                        canvas.parentElement.innerHTML = '<div class="text-center text-muted py-5 small"><i class="cil-chart-line fs-3 d-block mb-2 text-secondary"></i>Graphical visualization unavailable (CDN offline). Core metrics are detailed in the metric cards above.</div>';
                    }
                });
                return;
            }

            // Chart 1: Current Month Billing Settlement Breakdown
            const billingCtx = document.getElementById('adminBillingChart');
            if (billingCtx) {
                const invoiced = @Model.CurrentMonthBillingTotal;
                const collected = @Model.CurrentMonthCollectedTotal;
                const outstanding = @Model.TotalOutstandingBalance;

                new Chart(billingCtx, {
                    type: 'bar',
                    data: {
                        labels: ['Invoiced', 'Collected', 'Total Outstanding'],
                        datasets: [{
                            label: 'Amount (₹)',
                            data: [invoiced, collected, outstanding],
                            backgroundColor: [
                                'rgba(5, 150, 105, 0.8)',   // Emerald (Invoiced)
                                'rgba(16, 185, 129, 0.8)',  // Light Emerald (Collected)
                                'rgba(239, 68, 68, 0.8)'    // Red (Outstanding)
                            ],
                            borderColor: [
                                '#059669',
                                '#10b981',
                                '#ef4444'
                            ],
                            borderWidth: 1.5,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return ' ₹ ' + context.parsed.y.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) {
                                        return '₹ ' + value.toLocaleString('en-IN');
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // Chart 2: Today's Shift Distribution Doughnut
            const shiftCtx = document.getElementById('adminShiftChart');
            if (shiftCtx) {
                const morningVol = @morningShift.DeliveredLitres;
                const eveningVol = @eveningShift.DeliveredLitres;
                const hasData = (morningVol + eveningVol) > 0;

                new Chart(shiftCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Morning Shift (L)', 'Evening Shift (L)'],
                        datasets: [{
                            data: hasData ? [morningVol, eveningVol] : [1, 0],
                            backgroundColor: hasData
                                ? ['rgba(37, 99, 235, 0.85)', 'rgba(245, 158, 11, 0.85)']
                                : ['rgba(209, 213, 219, 0.5)', 'rgba(209, 213, 219, 0.5)'],
                            borderColor: ['#ffffff', '#ffffff'],
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { boxWidth: 12, font: { size: 11 } }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return hasData
                                            ? context.label + ': ' + context.parsed.toFixed(2) + ' L'
                                            : 'No deliveries recorded yet today';
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
