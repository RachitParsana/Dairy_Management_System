@model Dairy_Management_System.Models.Dashboard.DeliveryBoyDashboardViewModel
@using System.Security.Claims
@{
    Layout = "_LayoutDeliveryBoy";
    ViewData["Title"] = "Delivery Partner Portal";
    ViewData["ActiveMenu"] = "Dashboard";

    var dbUsername = User.Identity?.Name ?? "deliveryboy";
    var dbFullName = !string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName : (User.FindFirst(ClaimTypes.GivenName)?.Value ?? dbUsername);
    var dbPhone = User.FindFirst(ClaimTypes.MobilePhone)?.Value ?? "";
    var dbUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "0";

    var totalDrops = Model.CompletedDropsToday + Model.PendingDropsToday;
    var completionPercent = totalDrops > 0 ? (int)Math.Round(((double)Model.CompletedDropsToday / totalDrops) * 100) : 0;
}

<!-- Delivery Boy Route Header Bar -->
<div class="card border-0 bg-white shadow-sm mb-4">
    <div class="card-body py-3 px-3 px-md-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle p-2 text-white bg-primary d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                <i class="cil-bike fs-5"></i>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h5 class="mb-0 fw-bold text-dark">Partner: @dbFullName</h5>
                    <span class="badge bg-primary text-white">@(!string.IsNullOrEmpty(Model.AssignedRouteName) ? Model.AssignedRouteName : "Route Active")</span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle d-none d-sm-inline font-tabular">
                        ID: #DB-@dbUserId.PadLeft(3, '0')
                    </span>
                </div>
                <div class="text-muted small">
                    Registered Mobile: @(string.IsNullOrEmpty(dbPhone) ? "N/A" : dbPhone) &bull; Operational Portal
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-secondary border px-3 py-2 font-tabular">
                <i class="cil-calendar me-1"></i> @DateTime.Now.ToString("MMM dd, yyyy")
            </span>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
                <i class="cil-check-circle me-1"></i> Route Connected
            </span>
        </div>
    </div>
</div>

<!-- Primary Real-Time Operational KPI Cards Row -->
<div class="row g-3 mb-4">
    <!-- KPI 1: Assigned Route Customers -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Assigned Route</span>
                    <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3">
                        <i class="cil-map fs-5"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-1">
                    <h4 class="mb-0 fw-bold text-dark text-truncate" style="max-width: 200px;">
                        @(string.IsNullOrWhiteSpace(Model.AssignedRouteName) ? "Unassigned" : Model.AssignedRouteName)
                    </h4>
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small mt-2">
                    <span><strong>@Model.TotalRouteCustomers</strong> Active Customers</span>
                    <a href="~/DailyMilk/MyCustomers" class="text-primary text-decoration-none fw-medium">Roster &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI 2: Today's Litres Delivered -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Today's Delivered</span>
                    <div class="p-2 bg-success bg-opacity-10 text-success rounded-3">
                        <i class="cil-drop fs-5"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-1">
                    <h3 class="mb-0 fw-bold text-dark font-tabular">@Model.TodayDeliveredLitres.ToString("N2") <span class="fs-6 fw-normal text-muted">L</span></h3>
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small mt-2">
                    <span>Liquid Milk Volume</span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Completed</span>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI 3: Today's Drops Progress -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Delivery Drops</span>
                    <div class="p-2 bg-info bg-opacity-10 text-info rounded-3">
                        <i class="cil-task fs-5"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-1">
                    <h3 class="mb-0 fw-bold text-dark font-tabular">@Model.CompletedDropsToday <span class="fs-6 fw-normal text-muted">/ @totalDrops drops</span></h3>
                </div>
                <div class="progress mt-2 mb-1" style="height: 6px;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: @(completionPercent)%;" aria-valuenow="@completionPercent" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small mt-1">
                    <span>@completionPercent% Done</span>
                    <span class="text-warning fw-medium">@Model.PendingDropsToday Pending</span>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI 4: Unread Route Notifications -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Route Bulletins</span>
                    <div class="p-2 bg-warning bg-opacity-10 text-warning rounded-3">
                        <i class="cil-bell fs-5"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2 mb-1">
                    <h3 class="mb-0 fw-bold text-dark font-tabular">@Model.UnreadNotificationsCount <span class="fs-6 fw-normal text-muted">unread</span></h3>
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small mt-2">
                    <span>Alerts &amp; Notices</span>
                    <a href="~/Notification/DeliveryBoyNotifications" class="text-primary text-decoration-none fw-medium">View Alerts &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Action Operations Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm h-100 bg-primary text-white p-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="p-2 bg-white bg-opacity-25 rounded-3">
                    <i class="cil-pencil fs-4"></i>
                </div>
                <span class="badge bg-white text-primary fw-bold">Daily Distribution</span>
            </div>
            <h5 class="fw-bold mb-1">Daily Milk Runsheet</h5>
            <p class="small text-white-50 mb-3">Record Morning/Evening delivery drops, liquid volumes, and vacation skips.</p>
            <a href="~/DailyMilk" class="btn btn-light text-primary fw-semibold mt-auto">
                <i class="cil-check me-1"></i> Open Runsheet
            </a>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm h-100 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3">
                    <i class="cil-people fs-4"></i>
                </div>
                <span class="badge bg-light text-secondary border font-tabular">@Model.TotalRouteCustomers Customers</span>
            </div>
            <h5 class="fw-bold text-dark mb-1">Assigned Customer Roster</h5>
            <p class="small text-muted mb-3">Inspect your route sequence, delivery addresses, landmarks, and daily subscribed milk.</p>
            <a href="~/DailyMilk/MyCustomers" class="btn btn-outline-primary fw-semibold mt-auto">
                <i class="cil-list me-1"></i> View Route Roster
            </a>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm h-100 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="p-2 bg-warning bg-opacity-10 text-warning rounded-3">
                    <i class="cil-bell fs-4"></i>
                </div>
                <span class="badge @(Model.UnreadNotificationsCount > 0 ? "bg-danger text-white" : "bg-light text-secondary border")">
                    @Model.UnreadNotificationsCount Active
                </span>
            </div>
            <h5 class="fw-bold text-dark mb-1">Route Announcements</h5>
            <p class="small text-muted mb-3">Read supervisor broadcasts, route change notices, and newly published monthly customer bills.</p>
            <a href="~/Notification/DeliveryBoyNotifications" class="btn btn-outline-secondary fw-semibold mt-auto">
                <i class="cil-bullhorn me-1"></i> View Notifications
            </a>
        </div>
    </div>
</div>

<!-- Operational Instructions Notice -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3 p-md-4">
        <div class="d-flex align-items-center gap-3">
            <div class="p-3 bg-light rounded-circle text-primary">
                <i class="cil-info fs-3"></i>
            </div>
            <div>
                <h6 class="fw-bold text-dark mb-1">Daily Field Partner Operating Protocol</h6>
                <p class="text-muted small mb-0">
                    Always confirm subscription quantities prior to dispatch. Customers on approved vacation are automatically excluded from the runsheet. If a customer requests unscheduled extra milk, obtain admin authorization or note it for supervisor review.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- ONE-TIME BILL PUBLICATION POPUP MODAL (Persists Across Logins via dbo.NotificationPopupSeen) -->
@if (Model.UnacknowledgedBillPopups != null && Model.UnacknowledgedBillPopups.Count > 0)
{
    <div class="modal fade" id="billPublishedPopupModal" tabindex="-1" aria-labelledby="billPublishedModalTitle" aria-hidden="true" data-coreui-backdrop="static" data-coreui-keyboard="false">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white py-3">
                    <h5 class="modal-title fw-bold" id="billPublishedModalTitle">
                        <i class="cil-bell me-2"></i> Monthly Bills Published on Your Route
                    </h5>
                </div>
                <div class="modal-body p-3 p-md-4">
                    <div class="alert alert-primary-subtle text-primary border border-primary-subtle small mb-3">
                        <i class="cil-info me-1"></i> New monthly billing statements have been published for customers on <strong>@(string.IsNullOrEmpty(Model.AssignedRouteName) ? "your assigned route" : Model.AssignedRouteName)</strong>. Please note the updated statement amounts for payment collections.
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle font-tabular mb-0">
                            <thead class="table-light fs-7 text-uppercase text-secondary">
                                <tr>
                                    <th>Customer</th>
                                    <th>Billing Month</th>
                                    <th class="text-end">Invoice Amount</th>
                                    <th class="text-end">Total Outstanding</th>
                                </tr>
                            </thead>
                            <tbody class="fs-6">
                                @foreach (var popup in Model.UnacknowledgedBillPopups)
                                {
                                    <tr data-popup-notif-id="@popup.NotificationId">
                                        <td>
                                            <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(popup.CustomerNameSnapshot) ? popup.Title : popup.CustomerNameSnapshot)</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-secondary border">@(string.IsNullOrWhiteSpace(popup.BillingMonthYear) ? "Current Cycle" : popup.BillingMonthYear)</span>
                                        </td>
                                        <td class="text-end fw-semibold">
                                            ₹ @(popup.UpdatedBillAmount.HasValue ? popup.UpdatedBillAmount.Value.ToString("N2") : "0.00")
                                        </td>
                                        <td class="text-end fw-bold text-danger">
                                            ₹ @(popup.NewTotalOutstandingBalance.HasValue ? popup.NewTotalOutstandingBalance.Value.ToString("N2") : "0.00")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="text-muted small mt-2">
                        * Dismissing this modal marks these alerts as seen on your account so this popup will not reappear on subsequent logins.
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-3">
                    <button type="button" class="btn btn-primary px-4" id="btnDismissBillPopups">
                        <i class="cil-check me-1"></i> Understood &amp; Dismiss
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Auto-trigger the Bill Published Modal if unacknowledged popups exist
            var modalEl = document.getElementById('billPublishedPopupModal');
            if (modalEl) {
                var popupModal = new coreui.Modal(modalEl);
                popupModal.show();

                var btnDismiss = document.getElementById('btnDismissBillPopups');
                if (btnDismiss) {
                    btnDismiss.addEventListener('click', async function () {
                        btnDismiss.disabled = true;
                        btnDismiss.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Dismissing...';

                        // Collect all notification IDs in the modal
                        var rows = modalEl.querySelectorAll('tbody tr[data-popup-notif-id]');
                        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

                        var promises = [];
                        rows.forEach(function (row) {
                            var notifId = row.getAttribute('data-popup-notif-id');
                            if (notifId) {
                                var formData = new URLSearchParams();
                                formData.append('notificationId', notifId);
                                formData.append('__RequestVerificationToken', token);

                                promises.push(fetch('/Notification/DismissPopup', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                    body: formData
                                }));
                            }
                        });

                        try {
                            await Promise.all(promises);
                        } catch (e) {
                            console.error('Error recording popup dismissal', e);
                        }

                        popupModal.hide();
                    });
                }
            }
        });
    </script>
}
