<!-- Inline Quick-Add Route Modal (Reusable across DeliveryBoy & Customer Forms) -->
<div class="modal fade" id="quickAddRouteModal" tabindex="-1" aria-labelledby="quickAddRouteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fs-6 fw-bold" id="quickAddRouteModalLabel">
                    <i class="cil-location-pin me-1"></i> Add New Delivery Route
                </h5>
                <button type="button" class="btn-close btn-close-white" data-coreui-dismiss="modal" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="quickRouteErrorAlert" class="alert alert-danger small py-2 d-none" role="alert"></div>

                <div class="mb-3">
                    <label for="quickRouteCode" class="form-label fw-semibold small text-muted">Route Code <span class="text-danger">*</span></label>
                    <input type="text" id="quickRouteCode" class="form-control text-uppercase" placeholder="e.g. RT-03" maxlength="20" />
                </div>
                <div class="mb-3">
                    <label for="quickRouteName" class="form-label fw-semibold small text-muted">Route Name <span class="text-danger">*</span></label>
                    <input type="text" id="quickRouteName" class="form-control" placeholder="e.g. 150 Feet Ring Road Route" maxlength="100" />
                </div>
                <div class="mb-0">
                    <label for="quickRouteDescription" class="form-label fw-semibold small text-muted">Description (Optional)</label>
                    <textarea id="quickRouteDescription" class="form-control" rows="2" placeholder="Major neighborhoods or societies covered..." maxlength="250"></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-coreui-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success btn-sm text-white px-4" id="btnQuickSaveRoute">
                    <i class="cil-check me-1"></i> Add &amp; Select Route
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        let targetSelectId = null;
        let labelFormat = 'code-first'; // 'code-first' => "RT-03 - Name" | 'name-first' => "Name (RT-03)"

        window.openQuickAddRouteModal = function (selectId, format) {
            targetSelectId = selectId;
            labelFormat = format || 'code-first';

            document.getElementById('quickRouteCode').value = '';
            document.getElementById('quickRouteName').value = '';
            document.getElementById('quickRouteDescription').value = '';
            const errBox = document.getElementById('quickRouteErrorAlert');
            errBox.classList.add('d-none');
            errBox.textContent = '';

            const modalEl = document.getElementById('quickAddRouteModal');
            if (window.coreui && window.coreui.Modal) {
                window.coreui.Modal.getOrCreateInstance(modalEl).show();
            }
        };

        document.addEventListener('DOMContentLoaded', function () {
            const saveBtn = document.getElementById('btnQuickSaveRoute');
            if (!saveBtn) return;

            saveBtn.addEventListener('click', async function () {
                const code = (document.getElementById('quickRouteCode').value || '').trim().toUpperCase();
                const name = (document.getElementById('quickRouteName').value || '').trim();
                const description = (document.getElementById('quickRouteDescription').value || '').trim();
                const errBox = document.getElementById('quickRouteErrorAlert');

                if (!code || !name) {
                    errBox.textContent = 'Both Route Code and Route Name are required.';
                    errBox.classList.remove('d-none');
                    return;
                }

                const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                const csrfToken = tokenEl ? tokenEl.value : '';

                saveBtn.disabled = true;
                errBox.classList.add('d-none');

                try {
                    const response = await fetch('/Route/CreateQuick', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': csrfToken
                        },
                        body: JSON.stringify({
                            routeCode: code,
                            routeName: name,
                            description: description || null
                        })
                    });

                    const payload = await response.json();
                    if (!response.ok || !payload.success) {
                        errBox.textContent = payload.message || 'Could not create route.';
                        errBox.classList.remove('d-none');
                        return;
                    }

                    // Append and auto-select new option in the target route dropdown
                    const selectEl = targetSelectId ? document.getElementById(targetSelectId) : null;
                    if (selectEl && payload.route) {
                        const r = payload.route;
                        const optionLabel = labelFormat === 'name-first'
                            ? `${r.routeName} (${r.routeCode})`
                            : `${r.routeCode} - ${r.routeName}`;

                        const opt = document.createElement('option');
                        opt.value = String(r.routeId);
                        opt.textContent = optionLabel;
                        opt.selected = true;
                        selectEl.appendChild(opt);
                        selectEl.value = String(r.routeId);
                        selectEl.dispatchEvent(new Event('change'));
                    }

                    const modalEl = document.getElementById('quickAddRouteModal');
                    if (window.coreui && window.coreui.Modal) {
                        window.coreui.Modal.getOrCreateInstance(modalEl).hide();
                    }
                } catch (err) {
                    errBox.textContent = 'Network error while creating route. Please try again.';
                    errBox.classList.remove('d-none');
                } finally {
                    saveBtn.disabled = false;
                }
            });
        });
    })();
</script>
