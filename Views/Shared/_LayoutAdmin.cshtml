@using System.Security.Claims
@inject Dairy_Management_System.Services.INotificationService NotificationService
@{
    var adminUsername = User.Identity?.Name ?? "Admin";
    var adminFullName = User.FindFirst(ClaimTypes.GivenName)?.Value;
    var adminDisplayName = !string.IsNullOrWhiteSpace(adminFullName) ? adminFullName : adminUsername;
    var adminPhone = User.FindFirst(ClaimTypes.MobilePhone)?.Value ?? "";
    var adminInitials = !string.IsNullOrWhiteSpace(adminDisplayName)
        ? (adminDisplayName.Length >= 2 ? adminDisplayName.Substring(0, 2).ToUpper() : adminDisplayName.ToUpper())
        : "AD";

    int unreadAlertsCount = 0;
    IReadOnlyList<Dairy_Management_System.Models.Notification.NotificationListItemDto> recentAdminAlerts = Array.Empty<Dairy_Management_System.Models.Notification.NotificationListItemDto>();
    try
    {
        var adminUserId = int.TryParse(User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var parsedId) ? parsedId : 1;
        recentAdminAlerts = await NotificationService.GetUserNotificationsAsync(adminUserId, "Admin", null, null);
        unreadAlertsCount = recentAdminAlerts.Count(n => !n.IsAcknowledged);
    }
    catch
    {
        // Safe fallback
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dairy Management System Admin</title>

    <!-- Inter Font -->
    <link rel="stylesheet" href="~/lib/inter/css/inter.css" />

    <!-- CoreUI CSS (Bootstrap 5 compatible) -->
    <link rel="stylesheet" href="~/lib/coreui/css/coreui.min.css" />

    <!-- CoreUI Icons Free -->
    <link rel="stylesheet" href="~/lib/coreui-icons/css/free.min.css" />

    <!-- DMS Core & Admin Theme Stylesheets -->
    <link rel="stylesheet" href="~/css/dms-core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dms-admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Collapsible Admin Sidebar -->
    <div class="sidebar sidebar-fixed border-end sidebar-admin" id="sidebar">
        <div class="sidebar-header border-bottom">
            <a class="sidebar-brand text-decoration-none" href="~/Home/Index">
                <i class="cil-drop fs-4 text-success" style="color: #34d399 !important;"></i>
                <span>DairyMS</span>
                <span class="brand-badge ms-auto">Admin</span>
            </a>
            <button class="btn-close d-lg-none" type="button" aria-label="Close" data-dms-toggle="sidebar"></button>
        </div>

        <!-- Strict 10-Item Sidebar Navigation Order -->
        <ul class="sidebar-nav" data-coreui="navigation">
            <li class="nav-item">
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Dashboard" || ViewData["ActiveMenu"] == null ? "active" : "")" href="~/Home/Index">
                    <i class="nav-icon cil-speedometer"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "DeliveryBoy" || ViewData["ActiveMenu"]?.ToString() == "Compensation" ? "active" : "")" href="~/DeliveryBoy">
                    <i class="nav-icon cil-bike"></i> Delivery Boy Management
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Customers" ? "active" : "")" href="~/Customer">
                    <i class="nav-icon cil-user"></i> Customer Management
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Billing" ? "active" : "")" href="~/Billing">
                    <i class="nav-icon cil-description"></i> Monthly Billing Management
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Reports" ? "active" : "")" href="~/Reports">
                    <i class="nav-icon cil-chart-line"></i> Reports
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Exports" ? "active" : "")" href="~/Export">
                    <i class="nav-icon cil-cloud-download"></i> Export Management
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Notifications" ? "active" : "")" href="~/Notification">
                    <i class="nav-icon cil-bell"></i> Notification Management
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Settings" ? "active" : "")" href="~/Settings">
                    <i class="nav-icon cil-settings"></i> Settings
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Help" ? "active" : "")" href="~/HelpSupport">
                    <i class="nav-icon cil-info"></i> Help &amp; Support
                </a>
            </li>
            <li class="nav-item mt-3 pt-3 border-top border-secondary border-opacity-25">
                <form asp-controller="Auth" asp-action="Logout" method="post" id="adminSidebarLogoutForm" class="d-inline w-100">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-link text-danger-emphasis btn btn-link text-start w-100 border-0" style="background: transparent;">
                        <i class="nav-icon cil-account-logout text-danger"></i> Logout
                    </button>
                </form>
            </li>
        </ul>

        <div class="sidebar-footer border-top d-none d-md-flex justify-content-end p-2">
            <button class="sidebar-toggler" type="button" data-coreui-toggle="unfoldable" title="Toggle fold"></button>
        </div>
    </div>

    <!-- Main Content Wrapper -->
    <div class="wrapper d-flex flex-column min-vh-100 bg-light">
        <!-- Top Header Bar -->
        <header class="header header-sticky header-admin p-0 mb-4">
            <div class="container-fluid px-4 py-2 d-flex align-items-center justify-content-between">
                <!-- Mobile / Desktop Sidebar Toggler & Brand Title -->
                <div class="d-flex align-items-center gap-3">
                    <button class="header-toggler btn btn-sm btn-outline-secondary border-0 p-1" type="button" data-dms-toggle="sidebar" aria-label="Toggle navigation">
                        <i class="cil-menu fs-4"></i>
                    </button>
                    <div class="d-flex align-items-center gap-2">
                        <h1 class="header-brand-title mb-0">Dairy Management System - Admin</h1>
                        <span class="badge-role-admin d-none d-sm-inline-block">System Administrator</span>
                    </div>
                </div>

                <!-- Header Actions: Notifications, Profile Dropdown -->
                <div class="d-flex align-items-center gap-3">
                    <!-- Notification Bell -->
                    <div class="dropdown">
                        <button class="btn btn-link text-secondary p-1 position-relative text-decoration-none" type="button" data-coreui-toggle="dropdown" aria-expanded="false" title="Notifications">
                            <i class="cil-bell fs-5"></i>
                            @if (unreadAlertsCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                                    @(unreadAlertsCount > 9 ? "9+" : unreadAlertsCount.ToString())
                                </span>
                            }
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" style="min-width: 300px;">
                            <li class="dropdown-header fw-bold text-uppercase fs-7 text-muted border-bottom pb-2 d-flex justify-content-between align-items-center">
                                <span>System Alerts</span>
                                @if (unreadAlertsCount > 0)
                                {
                                    <span class="badge bg-danger rounded-pill">@unreadAlertsCount New</span>
                                }
                            </li>
                            @if (recentAdminAlerts.Count > 0)
                            {
                                @foreach (var alert in recentAdminAlerts.Take(4))
                                {
                                    <li class="border-bottom">
                                        <a class="dropdown-item py-2 px-3" href="~/Notification">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <strong class="small text-truncate" style="max-width: 180px;">@alert.Title</strong>
                                                <span class="badge @(alert.IsAcknowledged ? "bg-light text-secondary border" : "bg-primary-subtle text-primary")" style="font-size: 0.65rem;">
                                                    @(alert.IsAcknowledged ? "Read" : "New")
                                                </span>
                                            </div>
                                            <div class="text-muted small text-truncate" style="max-width: 250px;">@alert.Message</div>
                                            <div class="text-secondary font-tabular" style="font-size: 0.7rem;">@alert.CreatedAt.ToString("MMM dd, HH:mm")</div>
                                        </a>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="p-3 text-center text-muted small">
                                    <i class="cil-bell text-secondary fs-4 d-block mb-1"></i>
                                    No active unread notifications
                                </li>
                            }
                            <li class="pt-2 pb-1 text-center bg-light">
                                <a class="small text-primary fw-medium text-decoration-none" href="~/Notification">Manage all notifications &rarr;</a>
                            </li>
                        </ul>
                    </div>

                    <!-- Authenticated Admin Profile Dropdown -->
                    <div class="dropdown">
                        <a class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle" href="#" role="button" data-coreui-toggle="dropdown" aria-expanded="false">
                            <span class="header-user-avatar border shadow-sm" style="background-color: #ecfdf5; color: #065f46;">@adminInitials</span>
                            <span class="d-none d-lg-inline-block fw-semibold text-dark small">@adminDisplayName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" style="min-width: 220px;">
                            <li class="dropdown-header small text-muted">
                                <div class="fw-bold text-dark">@adminDisplayName</div>
                                <div>@@@adminUsername &bull; Admin</div>
                                @if (!string.IsNullOrEmpty(adminPhone))
                                {
                                    <div class="text-secondary small mt-1"><i class="cil-phone me-1"></i>@adminPhone</div>
                                }
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li><a class="dropdown-item small" href="~/Settings"><i class="cil-settings me-2"></i> Settings</a></li>
                            <li><a class="dropdown-item small" href="~/HelpSupport"><i class="cil-info me-2"></i> Help &amp; Support</a></li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item small text-danger btn btn-link text-start w-100">
                                        <i class="cil-account-logout me-2"></i> Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Dynamic Content Area -->
        <main class="body flex-grow-1 px-3 px-md-4">
            <div class="container-fluid px-0">
                @RenderBody()
            </div>
        </main>

        <!-- Admin Footer -->
        <footer class="footer mt-auto py-3 bg-white border-top text-muted small px-4 d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <span class="fw-semibold text-dark">Dairy Management System</span> &copy; 2026. All rights reserved.
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-success-subtle text-success border border-success-subtle">
                    <i class="cil-check-alt me-1"></i> Operational
                </span>
                <span>Version 1.0 (Admin Edition)</span>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/coreui/js/coreui.bundle.min.js"></script>
    <script src="~/js/dms-main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
