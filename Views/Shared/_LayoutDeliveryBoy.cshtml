<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - Dairy Management System Delivery Partner</title>

    <!-- Inter Font -->
    <link rel="stylesheet" href="~/lib/inter/css/inter.css" />

    <!-- CoreUI CSS (Bootstrap 5 compatible) -->
    <link rel="stylesheet" href="~/lib/coreui/css/coreui.min.css" />

    <!-- CoreUI Icons Free -->
    <link rel="stylesheet" href="~/lib/coreui-icons/css/free.min.css" />

    <!-- DMS Core & Delivery Boy Theme Stylesheets -->
    <link rel="stylesheet" href="~/css/dms-core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dms-deliveryboy.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Collapsible Delivery Boy Sidebar -->
    <div class="sidebar sidebar-fixed border-end sidebar-deliveryboy" id="sidebar">
        <div class="sidebar-header border-bottom">
            <a class="sidebar-brand text-decoration-none" href="~/Home/Privacy">
                <i class="cil-bike fs-4 text-primary" style="color: #60a5fa !important;"></i>
                <span>DairyMS</span>
                <span class="brand-badge ms-auto">Delivery</span>
            </a>
            <button class="btn-close d-lg-none" type="button" aria-label="Close" data-dms-toggle="sidebar"></button>
        </div>

        <!-- Strict 8-Item Sidebar Navigation Order -->
        <ul class="sidebar-nav" data-coreui="navigation">
            <li class="nav-item">
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Dashboard" || ViewData["ActiveMenu"] == null ? "active" : "")" href="~/Home/Privacy">
                    <i class="nav-icon cil-speedometer"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "MyCustomers" ? "active" : "")" href="#my-customers">
                    <i class="nav-icon cil-people"></i> My Customers
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "DailyMilkEntry" ? "active" : "")" href="#daily-milk-entry">
                    <i class="nav-icon cil-drop"></i> Daily Milk Entry
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Notifications" ? "active" : "")" href="#notifications">
                    <i class="nav-icon cil-bell"></i> Notifications
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Settings" ? "active" : "")" href="#settings">
                    <i class="nav-icon cil-settings"></i> Settings
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Help" ? "active" : "")" href="#help-support">
                    <i class="nav-icon cil-info"></i> Help &amp; Support
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Profile" ? "active" : "")" href="#profile">
                    <i class="nav-icon cil-user"></i> Profile
                </a>
            </li>
            <li class="nav-item mt-3 pt-3 border-top border-secondary border-opacity-25">
                <form asp-controller="Auth" asp-action="Logout" method="post" id="dbSidebarLogoutForm" class="d-inline w-100">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-link text-danger-emphasis btn btn-link text-start w-100 border-0" style="background: transparent;">
                        <i class="nav-icon cil-account-logout text-danger"></i> Logout
                    </button>
                </form>
            </li>
        </ul>

        <div class="sidebar-footer border-top d-none d-md-flex justify-content-end p-2">
            <button class="sidebar-toggler" type="button" data-coreui-toggle="unfoldable" title="Toggle fold"></button>
        </div>
    </div>

    <!-- Main Content Wrapper -->
    <div class="wrapper d-flex flex-column min-vh-100 bg-light">
        <!-- Top Header Bar -->
        <header class="header header-sticky header-deliveryboy p-0 mb-4">
            <div class="container-fluid px-3 px-md-4 py-2 d-flex align-items-center justify-content-between">
                <!-- Mobile / Desktop Sidebar Toggler & Brand Title -->
                <div class="d-flex align-items-center gap-2 gap-md-3">
                    <button class="header-toggler btn btn-sm btn-outline-secondary border-0 p-1" type="button" data-dms-toggle="sidebar" aria-label="Toggle navigation">
                        <i class="cil-menu fs-4"></i>
                    </button>
                    <div class="d-flex align-items-center gap-2">
                        <h1 class="header-brand-title mb-0 fs-6 fs-md-5">Dairy Management System - Delivery Partner</h1>
                        <span class="badge-role-deliveryboy d-none d-sm-inline-block">Field Partner</span>
                    </div>
                </div>

                <!-- Header Actions: Role Switcher Shortcut, Notifications, Profile Dropdown -->
                <div class="d-flex align-items-center gap-2 gap-md-3">
                    <!-- Temporary frontend preview shortcut -->
                    <a class="btn btn-sm btn-outline-success d-none d-md-inline-flex align-items-center gap-1" href="~/Home/Index" title="Temporary frontend preview of Admin layout">
                        <i class="cil-drop"></i>
                        <span>Preview Admin Layout</span>
                    </a>

                    <!-- Notification Bell -->
                    <div class="dropdown">
                        <button class="btn btn-link text-secondary p-1 position-relative text-decoration-none" type="button" data-coreui-toggle="dropdown" aria-expanded="false" title="Notifications">
                            <i class="cil-bell fs-5"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" style="min-width: 270px;">
                            <li class="dropdown-header fw-bold text-uppercase fs-7 text-muted border-bottom pb-2">
                                Route Notifications (Preview)
                            </li>
                            <li class="p-3 text-center text-muted small">
                                <i class="cil-bell text-secondary fs-4 d-block mb-1"></i>
                                No active unread route alerts
                            </li>
                        </ul>
                    </div>

                    <!-- Current Delivery Boy Profile Dropdown -->
                    <div class="dropdown">
                        <a class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle" href="#" role="button" data-coreui-toggle="dropdown" aria-expanded="false">
                            <span class="header-user-avatar border shadow-sm text-primary" style="background-color: #dbeafe;">RK</span>
                            <span class="d-none d-lg-inline-block fw-semibold text-dark small">Ramesh Kumar</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                            <li class="dropdown-header small text-muted">Delivery Partner #DB-004</li>
                            <li><a class="dropdown-item small" href="#profile"><i class="cil-user me-2"></i> Profile</a></li>
                            <li><a class="dropdown-item small" href="#settings"><i class="cil-settings me-2"></i> Settings</a></li>
                            <li><a class="dropdown-item small" href="#help-support"><i class="cil-info me-2"></i> Help &amp; Support</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item small text-danger btn btn-link text-start w-100">
                                        <i class="cil-account-logout me-2"></i> Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Dynamic Content Area (Mobile-First Spacing) -->
        <main class="body flex-grow-1 px-2 px-md-4">
            <div class="container-fluid px-0">
                @RenderBody()
            </div>
        </main>

        <!-- Delivery Boy Footer -->
        <footer class="footer mt-auto py-3 bg-white border-top text-muted small px-3 px-md-4 d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <span class="fw-semibold text-dark">DairyMS Delivery Portal</span> &copy; 2026.
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                    <i class="cil-wifi-signal-4 me-1"></i> Online &bull; Route 4
                </span>
                <span>Version 1.0</span>
            </div>
        </footer>
    </div>

    <!-- CoreUI Bundle JS (Includes Popper & Bootstrap 5) -->
    <script src="~/lib/coreui/js/coreui.bundle.min.js"></script>
    <script src="~/js/dms-main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
