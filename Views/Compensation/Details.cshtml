@model Dairy_Management_System.Models.Compensation.MonthlyCompensationDetailsDto
@{
    ViewData["Title"] = $"Statement #{Model.CompensationId}: {Model.DeliveryBoyName}";
    ViewData["ActiveMenu"] = "DeliveryBoy";

    var monthNames = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames;
    string monthName = Model.Month >= 1 && Model.Month <= 12 ? monthNames[Model.Month - 1] : $"Month {Model.Month}";
}

<div class="container-fluid px-4 py-3">
    <!-- Breadcrumb & Header -->
    <div class="row align-items-center mb-3">
        <div class="col-md-7">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-controller="DeliveryBoy" asp-action="Index" class="text-decoration-none">Delivery Boys</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Compensation" asp-action="Index" asp-route-month="@Model.Month" asp-route-year="@Model.Year" class="text-decoration-none">Compensation</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Statement #@Model.CompensationId</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h3 class="mb-0 fw-bold text-dark">
                    Statement #@Model.CompensationId — @Model.DeliveryBoyName
                </h3>
                @switch (Model.Status)
                {
                    case "Draft":
                        <span class="badge bg-warning-subtle text-warning border border-warning px-3 py-2">
                            <i class="bi bi-pencil me-1"></i> Draft Statement
                        </span>
                        break;
                    case "Finalized":
                        <span class="badge bg-info-subtle text-info border border-info px-3 py-2">
                            <i class="bi bi-lock-fill me-1"></i> Finalized & Locked
                        </span>
                        break;
                    case "Paid":
                        <span class="badge bg-success-subtle text-success border border-success px-3 py-2">
                            <i class="bi bi-check2-all me-1"></i> Paid & Settled
                        </span>
                        break;
                    default:
                        <span class="badge bg-secondary px-3 py-2">@Model.Status</span>
                        break;
                }
            </div>
            <p class="text-muted small mb-0 mt-1">
                Billing Period: <strong>@monthName @Model.Year</strong> • Model: <strong>@Model.CompensationType</strong>
            </p>
        </div>

        <!-- Action Buttons -->
        <div class="col-md-5 text-md-end mt-3 mt-md-0 d-flex flex-wrap gap-2 justify-content-md-end">
            <button type="button" class="btn btn-outline-secondary" onclick="window.print();" title="Print Formal Statement">
                <i class="bi bi-printer me-1"></i> Print
            </button>
            <a asp-controller="Compensation" asp-action="Index" asp-route-month="@Model.Month" asp-route-year="@Model.Year" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Payroll
            </a>

            @if (Model.Status == "Draft")
            {
                <form asp-action="CalculateDraft" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="deliveryBoyId" value="@Model.DeliveryBoyId" />
                    <input type="hidden" name="month" value="@Model.Month" />
                    <input type="hidden" name="year" value="@Model.Year" />
                    <button type="submit" class="btn btn-outline-warning" title="Recalculate volume and commission based on latest deliveries">
                        <i class="bi bi-arrow-repeat me-1"></i> Recalculate
                    </button>
                </form>

                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#applyAdjustmentModal">
                    <i class="bi bi-plus-circle me-1"></i> Add Adjustment
                </button>

                <button type="button" class="btn btn-primary fw-semibold" data-bs-toggle="modal" data-bs-target="#finalizeStatementModal">
                    <i class="bi bi-lock-fill me-1"></i> Finalize Statement
                </button>
            }
            else if (Model.Status == "Finalized")
            {
                <button type="button" class="btn btn-success fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#recordPayoutModal">
                    <i class="bi bi-cash-stack me-1"></i> Record Payout Disbursement
                </button>
            }
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Financial KPI Tiles (4 Cards) -->
    <div class="row g-3 mb-4">
        <!-- 1. Gross Earnings -->
        <div class="col-lg-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Gross Earnings</span>
                            <h4 class="mb-0 fw-bold text-dark mt-1">₹@Model.GrossEarnings.ToString("N2")</h4>
                        </div>
                        <div class="bg-primary-subtle text-primary rounded-3 p-2">
                            <i class="bi bi-cash fs-4"></i>
                        </div>
                    </div>
                    <div class="small text-muted mt-2">
                        @if (Model.CompensationType == "Commission")
                        {
                            <span>@Model.EligibleCompletedLitres.ToString("N2") L × ₹@Model.ApplicableCommissionRate.ToString("N2")/L</span>
                        }
                        else
                        {
                            <span>Fixed Contract Base</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Volume / Salary Base -->
        <div class="col-lg-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">
                                @(Model.CompensationType == "Commission" ? "Eligible Litres" : "Monthly Base")
                            </span>
                            <h4 class="mb-0 fw-bold text-dark mt-1">
                                @(Model.CompensationType == "Commission" ? $"{Model.EligibleCompletedLitres:N2} L" : $"₹{Model.FixedSalaryAmount:N2}")
                            </h4>
                        </div>
                        <div class="bg-info-subtle text-info rounded-3 p-2">
                            <i class="bi @(Model.CompensationType == "Commission" ? "bi-droplet-half" : "bi-briefcase") fs-4"></i>
                        </div>
                    </div>
                    <div class="small text-muted mt-2">
                        @if (Model.CompensationType == "Commission")
                        {
                            <span>Rate: ₹@Model.ApplicableCommissionRate.ToString("N2") / Litre</span>
                        }
                        else
                        {
                            <span>Fixed Salary Agreement</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Ledger Adjustments -->
        <div class="col-lg-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Adjustments Total</span>
                            <h4 class="mb-0 fw-bold @(Model.Adjustments >= 0 ? "text-success" : "text-danger") mt-1">
                                @(Model.Adjustments >= 0 ? "+" : "")₹@Model.Adjustments.ToString("N2")
                            </h4>
                        </div>
                        <div class="@(Model.Adjustments >= 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") rounded-3 p-2">
                            <i class="bi bi-journal-check fs-4"></i>
                        </div>
                    </div>
                    <div class="small text-muted mt-2">
                        <span>@Model.AdjustmentList.Count Ledger Adjustment(s)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Net Payable Amount -->
        <div class="col-lg-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-success text-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-white-50 small fw-semibold text-uppercase">Net Payable</span>
                            <h3 class="mb-0 fw-bold text-white mt-1">₹@Model.NetPayableAmount.ToString("N2")</h3>
                        </div>
                        <div class="bg-white bg-opacity-25 text-white rounded-3 p-2">
                            <i class="bi bi-wallet2 fs-3"></i>
                        </div>
                    </div>
                    <div class="small text-white-50 mt-2">
                        Status: <strong>@Model.Status</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Row -->
    <div class="row g-4">
        <!-- Left Column: Tables & Breakdowns (8 Cols) -->
        <div class="col-lg-8">
            <!-- Section 1: Ledger Adjustments -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h6 class="card-title mb-0 fw-bold text-dark">
                        <i class="bi bi-journal-text text-success me-2"></i>Compensation Adjustments Ledger
                    </h6>
                    @if (Model.Status == "Draft")
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#applyAdjustmentModal">
                            <i class="bi bi-plus-circle me-1"></i> Add Adjustment
                        </button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (!Model.AdjustmentList.Any())
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-clipboard-check text-muted fs-2"></i>
                            <p class="text-muted small mb-0 mt-2">No adjustments recorded on this statement. Net payable equals gross earnings.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-muted small text-uppercase">
                                    <tr>
                                        <th class="ps-3">ID / Type</th>
                                        <th>Reason / Justification</th>
                                        <th class="text-end">Amount (₹)</th>
                                        <th>Recorded By</th>
                                        <th class="pe-3">Recorded At</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var adj in Model.AdjustmentList)
                                    {
                                        <tr>
                                            <td class="ps-3">
                                                <span class="badge @(adj.AdjustmentAmount >= 0 ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger")">
                                                    @adj.AdjustmentType
                                                </span>
                                                <div class="small text-muted">#@adj.AdjustmentId</div>
                                            </td>
                                            <td>
                                                <span class="text-dark">@adj.Reason</span>
                                            </td>
                                            <td class="text-end fw-bold @(adj.AdjustmentAmount >= 0 ? "text-success" : "text-danger")">
                                                @(adj.AdjustmentAmount >= 0 ? "+" : "")₹@adj.AdjustmentAmount.ToString("N2")
                                            </td>
                                            <td class="small text-muted">
                                                @(adj.CreatedByName ?? "Administrator")
                                            </td>
                                            <td class="pe-3 small text-muted">
                                                @adj.CreatedAt.ToString("dd-MMM-yyyy HH:mm")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Section 2: Delivery Breakdown (Commission) or Fixed Salary Overview -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="card-title mb-0 fw-bold text-dark">
                        <i class="bi bi-truck text-primary me-2"></i>
                        @(Model.CompensationType == "Commission" ? "Itemized Daily Delivery Commission Breakdown" : "Fixed Salary Employment Overview")
                    </h6>
                </div>
                <div class="card-body p-0">
                    @if (Model.CompensationType == "Fixed Salary")
                    {
                        <div class="p-4">
                            <div class="alert alert-light border d-flex align-items-center mb-0">
                                <i class="bi bi-info-circle-fill text-primary fs-3 me-3"></i>
                                <div>
                                    <h6 class="fw-bold mb-1">Fixed Monthly Salary Contract</h6>
                                    <p class="text-muted small mb-0">
                                        @Model.DeliveryBoyName is employed under a <strong>Fixed Monthly Salary</strong> contract of <strong>₹@Model.FixedSalaryAmount.ToString("N2")</strong> per calendar month.
                                        Gross compensation is independent of daily delivery runsheet volumes.
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (!Model.DailyDeliveries.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-droplet-half text-muted fs-1"></i>
                                <h6 class="fw-bold text-dark mt-2">No Completed Deliveries Recorded</h6>
                                <p class="text-muted small mb-0">No delivered milk volume was found for this delivery agent in @monthName @Model.Year.</p>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 bg-light border-bottom small text-muted d-flex justify-content-between align-items-center">
                                <span>
                                    <i class="bi bi-shield-check text-success me-1"></i>
                                    Only deliveries with <strong>Delivered</strong> status are eligible for commission earnings.
                                </span>
                                <span class="fw-semibold text-dark">
                                    Total Completed Volume: @Model.DailyDeliveries.Sum(d => d.EligibleLitreQuantity).ToString("N2") Litres
                                </span>
                            </div>

                            <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light text-muted small text-uppercase sticky-top">
                                        <tr>
                                            <th class="ps-3">Date / Shift</th>
                                            <th>Customer</th>
                                            <th class="text-end">Volume (L)</th>
                                            <th class="text-end">Eligible (L)</th>
                                            <th class="text-end">Rate Snapshot</th>
                                            <th class="text-end pe-3">Earned Commission</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in Model.DailyDeliveries)
                                        {
                                            <tr>
                                                <td class="ps-3">
                                                    <span class="fw-semibold text-dark">@d.EntryDate.ToString("dd-MMM-yyyy")</span>
                                                    <span class="badge bg-light text-muted border ms-1">@d.Shift</span>
                                                </td>
                                                <td>
                                                    <div class="fw-semibold text-dark">@d.CustomerName</div>
                                                    <div class="small text-muted">@d.CustomerCode</div>
                                                </td>
                                                <td class="text-end text-muted">
                                                    @d.TotalLiquidVolumeLitres.ToString("N2") L
                                                </td>
                                                <td class="text-end fw-semibold text-dark">
                                                    @d.EligibleLitreQuantity.ToString("N2") L
                                                </td>
                                                <td class="text-end text-muted small">
                                                    ₹@d.CommissionRateSnapshot.ToString("N2")/L
                                                </td>
                                                <td class="text-end pe-3 fw-bold text-success">
                                                    ₹@d.EarnedCommission.ToString("N2")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-light fw-bold">
                                        <tr>
                                            <td colspan="3" class="ps-3">Total Completed Deliveries</td>
                                            <td class="text-end text-dark">@Model.DailyDeliveries.Sum(d => d.EligibleLitreQuantity).ToString("N2") L</td>
                                            <td></td>
                                            <td class="text-end pe-3 text-success">₹@Model.DailyDeliveries.Sum(d => d.EarnedCommission).ToString("N2")</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Staff Profile & Lifecycle Metadata (4 Cols) -->
        <div class="col-lg-4">
            <!-- Staff Overview Card -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="card-title mb-0 fw-bold text-dark">
                        <i class="bi bi-person-badge text-primary me-2"></i>Staff Details
                    </h6>
                </div>
                <div class="card-body p-3">
                    <ul class="list-unstyled mb-0 small">
                        <li class="py-2 border-bottom d-flex justify-content-between">
                            <span class="text-muted">Full Legal Name:</span>
                            <span class="fw-semibold text-dark">
                                <a asp-controller="DeliveryBoy" asp-action="Details" asp-route-id="@Model.DeliveryBoyId" class="text-decoration-none">
                                    @Model.DeliveryBoyName
                                </a>
                            </span>
                        </li>
                        <li class="py-2 border-bottom d-flex justify-content-between">
                            <span class="text-muted">Contact Phone:</span>
                            <span class="fw-semibold text-dark">@Model.DeliveryBoyPhone</span>
                        </li>
                        <li class="py-2 border-bottom d-flex justify-content-between">
                            <span class="text-muted">Vehicle Registration:</span>
                            <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.VehicleNumber) ? "Not Specified" : Model.VehicleNumber)</span>
                        </li>
                        <li class="py-2 border-bottom d-flex justify-content-between">
                            <span class="text-muted">Primary Route:</span>
                            <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.RouteName) ? "Unassigned" : Model.RouteName)</span>
                        </li>
                        <li class="py-2 d-flex justify-content-between">
                            <span class="text-muted">Compensation Model:</span>
                            <span class="badge @(Model.CompensationType == "Commission" ? "bg-success" : "bg-primary") px-2 py-1">
                                @Model.CompensationType
                            </span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Statement Lifecycle & Audit Metadata -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="card-title mb-0 fw-bold text-dark">
                        <i class="bi bi-clock-history text-secondary me-2"></i>Lifecycle & Audit Trail
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="position-relative ps-4 border-start border-2 border-success ms-2 my-2">
                        <!-- Draft Event -->
                        <div class="mb-3 position-relative">
                            <i class="bi bi-dot position-absolute text-success fs-2" style="left: -32px; top: -14px;"></i>
                            <div class="fw-semibold text-dark small">Draft Generated</div>
                            <div class="text-muted small">@Model.CreatedAt.ToString("dd-MMM-yyyy HH:mm")</div>
                            <div class="text-muted small">By: @(Model.CreatedByName ?? "System")</div>
                        </div>

                        <!-- Finalized Event -->
                        <div class="mb-3 position-relative">
                            <i class="bi bi-dot position-absolute @(Model.FinalizedAt.HasValue ? "text-info" : "text-muted") fs-2" style="left: -32px; top: -14px;"></i>
                            <div class="fw-semibold @(Model.FinalizedAt.HasValue ? "text-dark" : "text-muted") small">
                                @(Model.FinalizedAt.HasValue ? "Finalized & Statement Locked" : "Pending Finalization")
                            </div>
                            @if (Model.FinalizedAt.HasValue)
                            {
                                <div class="text-muted small">@Model.FinalizedAt.Value.ToString("dd-MMM-yyyy HH:mm")</div>
                                <div class="text-muted small">By: @(Model.FinalizedByName ?? "Administrator")</div>
                            }
                        </div>

                        <!-- Paid Event -->
                        <div class="position-relative">
                            <i class="bi bi-dot position-absolute @(Model.PaidAt.HasValue ? "text-success" : "text-muted") fs-2" style="left: -32px; top: -14px;"></i>
                            <div class="fw-semibold @(Model.PaidAt.HasValue ? "text-dark" : "text-muted") small">
                                @(Model.PaidAt.HasValue ? "Payout Disbursed" : "Pending Payout")
                            </div>
                            @if (Model.PaidAt.HasValue)
                            {
                                <div class="text-muted small">@Model.PaidAt.Value.ToString("dd-MMM-yyyy HH:mm")</div>
                                <div class="text-muted small">By: @(Model.PaidByName ?? "Administrator")</div>
                                <div class="text-success small fw-semibold mt-1">Ref: @Model.PaymentReference</div>
                                @if (!string.IsNullOrEmpty(Model.Notes))
                                {
                                    <div class="text-muted small fst-italic mt-1">Notes: @Model.Notes</div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Statement Security Notice -->
            <div class="alert alert-light border small text-muted">
                <i class="bi bi-shield-lock-fill text-primary me-1"></i>
                <strong>Financial Integrity Safeguard:</strong> Direct table edits are denied at the database engine level. All calculations and ledger entries are protected by ACID transactions with table lock isolation.
            </div>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODALS                                                   -->
<!-- ======================================================== -->

@if (Model.Status == "Draft")
{
    <!-- Modal 1: Apply Adjustment -->
    <div class="modal fade" id="applyAdjustmentModal" tabindex="-1" aria-labelledby="applyAdjustmentModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Compensation" asp-action="ApplyAdjustment" method="post" id="applyAdjustmentForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CompensationId" value="@Model.CompensationId" />
                    <input type="hidden" name="DeliveryBoyId" value="@Model.DeliveryBoyId" />
                    <input type="hidden" name="DeliveryBoyName" value="@Model.DeliveryBoyName" />
                    <input type="hidden" name="Month" value="@Model.Month" />
                    <input type="hidden" name="Year" value="@Model.Year" />
                    <input type="hidden" name="GrossEarnings" value="@Model.GrossEarnings" />
                    <input type="hidden" name="CurrentAdjustments" value="@Model.Adjustments" />
                    <input type="hidden" name="CurrentNetPayable" value="@Model.NetPayableAmount" />

                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold" id="applyAdjustmentModalLabel">
                            <i class="bi bi-plus-circle me-2"></i>Apply Compensation Adjustment
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="alert alert-info border-info small mb-3">
                            <i class="bi bi-info-circle-fill me-1"></i>
                            Adjustments append an immutable audit row to the ledger.
                            <strong>Net payable amount cannot become negative.</strong>
                        </div>

                        <!-- Current Balance Overview -->
                        <div class="p-3 bg-light rounded-3 border mb-3">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Gross Earnings:</span>
                                <strong>₹@Model.GrossEarnings.ToString("N2")</strong>
                            </div>
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Current Adjustments:</span>
                                <strong>@(Model.Adjustments >= 0 ? "+" : "")₹@Model.Adjustments.ToString("N2")</strong>
                            </div>
                            <div class="d-flex justify-content-between fw-bold text-dark border-top pt-1 mt-1">
                                <span>Current Net Payable:</span>
                                <span class="text-success">₹@Model.NetPayableAmount.ToString("N2")</span>
                            </div>
                        </div>

                        <!-- Adjustment Type -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Adjustment Type <span class="text-danger">*</span></label>
                            <select name="AdjustmentType" id="adjustmentTypeSelect" class="form-select" required onchange="handleAdjustmentTypeChange()">
                                <option value="Bonus">Bonus (+ Addition)</option>
                                <option value="AdvanceDeduction">Salary Advance Recovery (- Deduction)</option>
                                <option value="PenaltyDeduction">Penalty / Shortage (- Deduction)</option>
                                <option value="TransitionAdjustment">Model Transition Adjustment (+ / -)</option>
                                <option value="Other">Other Adjustment (+ / -)</option>
                            </select>
                        </div>

                        <!-- Adjustment Amount -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Adjustment Amount (₹) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light" id="amountSignLabel">+ ₹</span>
                                <input type="number" step="0.01" name="AdjustmentAmount" id="adjustmentAmountInput" class="form-control" placeholder="0.00" required />
                            </div>
                            <div class="form-text small text-muted" id="amountHelpText">
                                Enter positive amount for bonus additions.
                            </div>
                        </div>

                        <!-- Reason -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Audit Justification Reason <span class="text-danger">*</span></label>
                            <textarea name="Reason" class="form-control" rows="2" placeholder="Explain the rationale for this ledger adjustment (min 5 characters)..." minlength="5" maxlength="250" required></textarea>
                            <div class="form-text small text-muted">Mandatory justification recorded in the permanent audit ledger.</div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary fw-semibold">
                            <i class="bi bi-check-circle me-1"></i> Apply to Ledger
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal 2: Finalize Statement -->
    <div class="modal fade" id="finalizeStatementModal" tabindex="-1" aria-labelledby="finalizeStatementModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Compensation" asp-action="Finalize" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="compensationId" value="@Model.CompensationId" />

                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold" id="finalizeStatementModalLabel">
                            <i class="bi bi-lock-fill me-2"></i>Finalize & Lock Compensation Statement
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="alert alert-warning border-warning d-flex align-items-start mb-3">
                            <i class="bi bi-shield-lock-fill fs-3 text-warning me-3 flex-shrink-0"></i>
                            <div class="small">
                                <strong class="d-block mb-1 text-dark">Irreversible Statement Locking:</strong>
                                Finalizing locks this compensation record permanently. Once finalized:
                                <ul class="mb-0 ps-3 mt-1">
                                    <li>Delivery volumes and commission calculations CANNOT be recalculated.</li>
                                    <li>No further adjustments can be added to the ledger.</li>
                                    <li>The statement becomes approved and ready for payout disbursement.</li>
                                </ul>
                            </div>
                        </div>

                        <div class="p-3 bg-light rounded-3 border">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Staff:</span>
                                <strong class="text-dark">@Model.DeliveryBoyName</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Billing Period:</span>
                                <strong>@monthName @Model.Year</strong>
                            </div>
                            <div class="d-flex justify-content-between border-top pt-2 mt-2 fs-5">
                                <span class="fw-bold text-dark">Approved Net Payable:</span>
                                <strong class="text-success">₹@Model.NetPayableAmount.ToString("N2")</strong>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary fw-semibold">
                            <i class="bi bi-lock-fill me-1"></i> Confirm Finalize & Lock
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model.Status == "Finalized")
{
    <!-- Modal 3: Record Payout -->
    <div class="modal fade" id="recordPayoutModal" tabindex="-1" aria-labelledby="recordPayoutModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Compensation" asp-action="RecordPayout" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CompensationId" value="@Model.CompensationId" />
                    <input type="hidden" name="DeliveryBoyId" value="@Model.DeliveryBoyId" />
                    <input type="hidden" name="DeliveryBoyName" value="@Model.DeliveryBoyName" />
                    <input type="hidden" name="Month" value="@Model.Month" />
                    <input type="hidden" name="Year" value="@Model.Year" />
                    <input type="hidden" name="NetPayableAmount" value="@Model.NetPayableAmount" />

                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title fw-bold" id="recordPayoutModalLabel">
                            <i class="bi bi-cash-stack me-2"></i>Record Compensation Payout Disbursement
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="p-3 bg-light rounded-3 border mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Payee:</span>
                                <strong class="text-dark">@Model.DeliveryBoyName</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Period:</span>
                                <strong>@monthName @Model.Year</strong>
                            </div>
                            <div class="d-flex justify-content-between border-top pt-2 mt-2 fs-5">
                                <span class="fw-bold text-dark">Disbursed Amount:</span>
                                <strong class="text-success">₹@Model.NetPayableAmount.ToString("N2")</strong>
                            </div>
                        </div>

                        <!-- Payment Date -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Payment Settlement Date <span class="text-danger">*</span></label>
                            <input type="datetime-local" name="PaidAt" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>

                        <!-- Payment Reference -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Payment / Transfer Reference <span class="text-danger">*</span></label>
                            <input type="text" name="PaymentReference" class="form-control" placeholder="e.g. UTR-987654321, Cheque #004521, Cash Voucher #12" maxlength="50" required />
                            <div class="form-text small text-muted">Bank transfer reference, UTR number, cheque number, or cash receipt ID.</div>
                        </div>

                        <!-- Notes -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Administrative Remarks / Notes</label>
                            <textarea name="Notes" class="form-control" rows="2" placeholder="Optional payout notes..." maxlength="250"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success fw-semibold">
                            <i class="bi bi-check2-all me-1"></i> Confirm Payout Disbursement
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function handleAdjustmentTypeChange() {
            var select = document.getElementById('adjustmentTypeSelect');
            var signLabel = document.getElementById('amountSignLabel');
            var helpText = document.getElementById('amountHelpText');
            var amountInput = document.getElementById('adjustmentAmountInput');

            if (!select || !signLabel || !amountInput) return;

            var val = select.value;
            if (val === 'AdvanceDeduction' || val === 'PenaltyDeduction') {
                signLabel.innerText = '- ₹';
                signLabel.className = 'input-group-text bg-danger text-white';
                helpText.innerText = 'Deductions will reduce the Net Payable amount. Enter as a positive number; it will be deducted automatically.';
            } else if (val === 'Bonus') {
                signLabel.innerText = '+ ₹';
                signLabel.className = 'input-group-text bg-success text-white';
                helpText.innerText = 'Bonus additions will increase the Net Payable amount.';
            } else {
                signLabel.innerText = '± ₹';
                signLabel.className = 'input-group-text bg-light text-dark';
                helpText.innerText = 'Enter positive amount for addition, or negative for deduction.';
            }
        }

        // Before submit, ensure deduction types have negative sign if entered as positive
        var form = document.getElementById('applyAdjustmentForm');
        if (form) {
            form.addEventListener('submit', function (e) {
                var select = document.getElementById('adjustmentTypeSelect');
                var amountInput = document.getElementById('adjustmentAmountInput');
                if (select && amountInput) {
                    var val = select.value;
                    var num = parseFloat(amountInput.value);
                    if (!isNaN(num)) {
                        if ((val === 'AdvanceDeduction' || val === 'PenaltyDeduction') && num > 0) {
                            amountInput.value = (-num).toFixed(2);
                        }
                    }
                }
            });
        }
    </script>
}
