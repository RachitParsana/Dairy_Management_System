@model Dairy_Management_System.Models.Compensation.CompensationIndexViewModel
@{
    ViewData["Title"] = "Monthly Compensation & Payroll";
    ViewData["ActiveMenu"] = "DeliveryBoy";

    var monthNames = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames;
    string selectedMonthName = Model.Criteria.Month >= 1 && Model.Criteria.Month <= 12
        ? monthNames[Model.Criteria.Month - 1]
        : DateTime.Today.ToString("MMMM");
}

<div class="container-fluid px-4 py-3">
    <!-- Breadcrumb & Header -->
    <div class="row align-items-center mb-3">
        <div class="col-md-7">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-controller="DeliveryBoy" asp-action="Index" class="text-decoration-none">Delivery Boys</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Compensation & Payroll</li>
                </ol>
            </nav>
            <h3 class="mb-0 fw-bold text-dark">
                <i class="bi bi-wallet2 text-success me-2"></i>Monthly Compensation & Payroll
            </h3>
            <p class="text-muted small mb-0">Manage draft calculations, review delivery volumes, record ledger adjustments, and track payout settlements.</p>
        </div>
        <div class="col-md-5 text-md-end mt-2 mt-md-0 d-flex flex-wrap gap-2 justify-content-md-end">
            <a asp-controller="DeliveryBoy" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-people-fill me-1"></i> Staff Directory
            </a>
            <button type="button" class="btn btn-success fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#bulkCalculateModal">
                <i class="bi bi-calculator-fill me-1"></i> Bulk Calculate Drafts
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Summary Cards (5 Cards) -->
    <div class="row g-3 mb-4">
        <!-- 1. Total Statements -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Statements</span>
                            <h4 class="mb-0 fw-bold text-dark mt-1">@Model.TotalEmployees</h4>
                        </div>
                        <div class="bg-primary-subtle text-primary rounded-3 p-2">
                            <i class="bi bi-file-earmark-text fs-4"></i>
                        </div>
                    </div>
                    <div class="small text-muted mt-2">
                        Period: <strong>@selectedMonthName @Model.Criteria.Year</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Draft Status -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Drafts</span>
                            <h4 class="mb-0 fw-bold text-warning mt-1">@Model.DraftCount</h4>
                        </div>
                        <div class="bg-warning-subtle text-warning rounded-3 p-2">
                            <i class="bi bi-pencil-square fs-4"></i>
                        </div>
                    </div>
                    <div class="small text-muted mt-2">
                        <span>Editable / Pending Finalize</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Finalized Status -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Finalized</span>
                            <h4 class="mb-0 fw-bold text-info mt-1">@Model.FinalizedCount</h4>
                        </div>
                        <div class="bg-info-subtle text-info rounded-3 p-2">
                            <i class="bi bi-lock-fill fs-4"></i>
                        </div>
                    </div>
                    <div class="small text-muted mt-2">
                        <span>Locked / Pending Payout</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Paid Status -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small fw-semibold text-uppercase">Paid</span>
                            <h4 class="mb-0 fw-bold text-success mt-1">@Model.PaidCount</h4>
                        </div>
                        <div class="bg-success-subtle text-success rounded-3 p-2">
                            <i class="bi bi-check2-all fs-4"></i>
                        </div>
                    </div>
                    <div class="small text-muted mt-2">
                        <span>Disbursed & Settled</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. Net Payable Aggregate -->
        <div class="col-xl-4 col-md-8 col-sm-12">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-success text-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-white-50 small fw-semibold text-uppercase">Total Net Payable</span>
                            <h3 class="mb-0 fw-bold text-white mt-1">₹@Model.TotalNetPayable.ToString("N2")</h3>
                        </div>
                        <div class="bg-white bg-opacity-25 text-white rounded-3 p-2">
                            <i class="bi bi-cash-stack fs-3"></i>
                        </div>
                    </div>
                    <div class="small text-white-50 mt-2 d-flex justify-content-between">
                        <span>Gross: ₹@Model.TotalGrossPayable.ToString("N2")</span>
                        <span>Adjustments: @(Model.TotalAdjustments >= 0 ? "+" : "")₹@Model.TotalAdjustments.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Month Selector Toolbar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form asp-controller="Compensation" asp-action="Index" method="get" class="row g-2 align-items-center">
                <!-- Month Dropdown -->
                <div class="col-lg-2 col-md-3 col-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Billing Month</label>
                    <select name="month" class="form-select form-select-sm">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(m == Model.Criteria.Month ? "selected" : null)">
                                @(new DateTime(2000, m, 1).ToString("MMMM"))
                            </option>
                        }
                    </select>
                </div>

                <!-- Year Dropdown -->
                <div class="col-lg-1 col-md-2 col-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Year</label>
                    <select name="year" class="form-select form-select-sm">
                        @for (int y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 1; y++)
                        {
                            <option value="@y" selected="@(y == Model.Criteria.Year ? "selected" : null)">
                                @y
                            </option>
                        }
                    </select>
                </div>

                <!-- Status Filter -->
                <div class="col-lg-2 col-md-3 col-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Status</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="All" selected="@(Model.Criteria.Status == "All" ? "selected" : null)">All Statuses</option>
                        <option value="Draft" selected="@(Model.Criteria.Status == "Draft" ? "selected" : null)">Draft</option>
                        <option value="Finalized" selected="@(Model.Criteria.Status == "Finalized" ? "selected" : null)">Finalized</option>
                        <option value="Paid" selected="@(Model.Criteria.Status == "Paid" ? "selected" : null)">Paid</option>
                    </select>
                </div>

                <!-- Compensation Type Filter -->
                <div class="col-lg-2 col-md-4 col-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Model Type</label>
                    <select name="compensationType" class="form-select form-select-sm">
                        <option value="All" selected="@(Model.Criteria.CompensationType == "All" ? "selected" : null)">All Models</option>
                        <option value="Commission" selected="@(Model.Criteria.CompensationType == "Commission" ? "selected" : null)">Commission</option>
                        <option value="Fixed Salary" selected="@(Model.Criteria.CompensationType == "Fixed Salary" ? "selected" : null)">Fixed Salary</option>
                    </select>
                </div>

                <!-- Delivery Boy Filter -->
                <div class="col-lg-3 col-md-6 col-12">
                    <label class="form-label small fw-semibold text-muted mb-1">Delivery Agent</label>
                    <select name="deliveryBoyId" class="form-select form-select-sm">
                        <option value="">All Delivery Agents</option>
                        @if (Model.AvailableDeliveryBoys != null)
                        {
                            foreach (var b in Model.AvailableDeliveryBoys)
                            {
                                <option value="@b.DeliveryBoyId" selected="@(Model.Criteria.DeliveryBoyId == b.DeliveryBoyId ? "selected" : null)">
                                    @b.FullName (@b.Phone)
                                </option>
                            }
                        }
                    </select>
                </div>

                <!-- Actions -->
                <div class="col-lg-2 col-md-6 col-12 d-flex gap-2 align-self-end mt-2 mt-lg-0">
                    <button type="submit" class="btn btn-sm btn-primary w-100 fw-semibold">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-controller="Compensation" asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Payroll Grid Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h6 class="card-title mb-0 fw-bold text-dark">
                <i class="bi bi-table text-success me-2"></i>Payroll Statements — @selectedMonthName @Model.Criteria.Year
            </h6>
            <span class="badge bg-light text-dark border">
                @Model.Compensations.Count of @Model.TotalCount Statements
            </span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Compensations.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-receipt text-muted" style="font-size: 3.5rem;"></i>
                    <h5 class="fw-bold text-dark mt-3">No Compensation Records Found</h5>
                    <p class="text-muted small mb-3">No payroll statements exist for @selectedMonthName @Model.Criteria.Year matching the selected filters.</p>
                    <button type="button" class="btn btn-success btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#bulkCalculateModal">
                        <i class="bi bi-calculator-fill me-1"></i> Run Bulk Draft Calculation for @selectedMonthName @Model.Criteria.Year
                    </button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-3">ID / Staff</th>
                                <th>Model</th>
                                <th>Volume / Base</th>
                                <th class="text-end">Gross (₹)</th>
                                <th class="text-end">Adjustments (₹)</th>
                                <th class="text-end">Net Payable (₹)</th>
                                <th class="text-center">Status</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Compensations)
                            {
                                <tr>
                                    <!-- ID & Staff -->
                                    <td class="ps-3">
                                        <div class="fw-bold text-dark">
                                            <a asp-action="Details" asp-route-id="@item.CompensationId" class="text-decoration-none text-dark">
                                                @item.DeliveryBoyName
                                            </a>
                                        </div>
                                        <div class="small text-muted">
                                            <span>#@item.CompensationId</span> • 
                                            <span><i class="bi bi-telephone text-muted"></i> @item.DeliveryBoyPhone</span>
                                            @if (!string.IsNullOrEmpty(item.RouteName))
                                            {
                                                <span> • <i class="bi bi-geo-alt text-muted"></i> @item.RouteName</span>
                                            }
                                        </div>
                                    </td>

                                    <!-- Compensation Model -->
                                    <td>
                                        @if (item.CompensationType == "Commission")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success">
                                                <i class="bi bi-graph-up-arrow me-1"></i> Commission
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary">
                                                <i class="bi bi-wallet2 me-1"></i> Fixed Salary
                                            </span>
                                        }
                                    </td>

                                    <!-- Volume / Base Details -->
                                    <td>
                                        @if (item.CompensationType == "Commission")
                                        {
                                            <div class="fw-semibold text-dark">@item.EligibleCompletedLitres.ToString("N2") L</div>
                                            <div class="small text-muted">Rate: ₹@item.ApplicableCommissionRate.ToString("N2")/L</div>
                                        }
                                        else
                                        {
                                            <div class="fw-semibold text-dark">Fixed Base</div>
                                            <div class="small text-muted">₹@item.FixedSalaryAmount.ToString("N2")/mo</div>
                                        }
                                    </td>

                                    <!-- Gross Earnings -->
                                    <td class="text-end fw-semibold text-dark">
                                        ₹@item.GrossEarnings.ToString("N2")
                                    </td>

                                    <!-- Adjustments -->
                                    <td class="text-end">
                                        @if (item.Adjustments > 0)
                                        {
                                            <span class="text-success fw-semibold">+₹@item.Adjustments.ToString("N2")</span>
                                        }
                                        else if (item.Adjustments < 0)
                                        {
                                            <span class="text-danger fw-semibold">₹@item.Adjustments.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">₹0.00</span>
                                        }
                                    </td>

                                    <!-- Net Payable -->
                                    <td class="text-end">
                                        <strong class="fs-6 text-dark">₹@item.NetPayableAmount.ToString("N2")</strong>
                                    </td>

                                    <!-- Status Badge -->
                                    <td class="text-center">
                                        @switch (item.Status)
                                        {
                                            case "Draft":
                                                <span class="badge bg-warning-subtle text-warning border border-warning px-2 py-1">
                                                    <i class="bi bi-pencil me-1"></i> Draft
                                                </span>
                                                break;
                                            case "Finalized":
                                                <span class="badge bg-info-subtle text-info border border-info px-2 py-1">
                                                    <i class="bi bi-lock me-1"></i> Finalized
                                                </span>
                                                break;
                                            case "Paid":
                                                <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                                    <i class="bi bi-check2-all me-1"></i> Paid
                                                </span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@item.Status</span>
                                                break;
                                        }
                                    </td>

                                    <!-- Action Buttons -->
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@item.CompensationId" class="btn btn-outline-secondary" title="View Statement Details">
                                                <i class="bi bi-eye"></i> Details
                                            </a>
                                            @if (item.Status == "Draft")
                                            {
                                                <form asp-action="CalculateDraft" method="post" class="d-inline" onsubmit="return confirm('Recalculate draft compensation statement for @item.DeliveryBoyName? Current delivery volume and active rate will be updated.');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="deliveryBoyId" value="@item.DeliveryBoyId" />
                                                    <input type="hidden" name="month" value="@item.Month" />
                                                    <input type="hidden" name="year" value="@item.Year" />
                                                    <button type="submit" class="btn btn-outline-warning border-start-0" title="Recalculate Delivery Volume & Earnings">
                                                        <i class="bi bi-arrow-repeat"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
                        <span class="small text-muted">
                            Page @Model.CurrentPage of @Model.TotalPages (Showing @Model.Compensations.Count items)
                        </span>
                        <nav aria-label="Compensation Pagination">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-page="@(Model.CurrentPage - 1)"
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-month="@Model.Criteria.Month"
                                       asp-route-year="@Model.Criteria.Year"
                                       asp-route-status="@Model.Criteria.Status"
                                       asp-route-compensationType="@Model.Criteria.CompensationType"
                                       asp-route-deliveryBoyId="@Model.Criteria.DeliveryBoyId">
                                        Previous
                                    </a>
                                </li>
                                @for (int p = 1; p <= Model.TotalPages; p++)
                                {
                                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="Index"
                                           asp-route-page="@p"
                                           asp-route-pageSize="@Model.PageSize"
                                           asp-route-month="@Model.Criteria.Month"
                                           asp-route-year="@Model.Criteria.Year"
                                           asp-route-status="@Model.Criteria.Status"
                                           asp-route-compensationType="@Model.Criteria.CompensationType"
                                           asp-route-deliveryBoyId="@Model.Criteria.DeliveryBoyId">
                                            @p
                                        </a>
                                    </li>
                                }
                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-page="@(Model.CurrentPage + 1)"
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-month="@Model.Criteria.Month"
                                       asp-route-year="@Model.Criteria.Year"
                                       asp-route-status="@Model.Criteria.Status"
                                       asp-route-compensationType="@Model.Criteria.CompensationType"
                                       asp-route-deliveryBoyId="@Model.Criteria.DeliveryBoyId">
                                        Next
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Modal: Bulk Calculate Drafts -->
<div class="modal fade" id="bulkCalculateModal" tabindex="-1" aria-labelledby="bulkCalculateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Compensation" asp-action="BulkCalculate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold" id="bulkCalculateModalLabel">
                        <i class="bi bi-calculator-fill me-2"></i>Bulk Calculate Draft Compensation
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-info border-info small mb-3">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        This operation computes completed delivery litres, snapshots rate tiers, and creates or updates <strong>Draft</strong> compensation statements for all active delivery boys for the selected month.
                        <div class="mt-1 fw-bold text-dark">Statements already Finalized or Paid will NEVER be overwritten.</div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label fw-semibold">Target Billing Month <span class="text-danger">*</span></label>
                            <select name="month" class="form-select" required>
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m" selected="@(m == Model.Criteria.Month ? "selected" : null)">
                                        @(new DateTime(2000, m, 1).ToString("MMMM"))
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-semibold">Billing Year <span class="text-danger">*</span></label>
                            <select name="year" class="form-select" required>
                                @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 1; y++)
                                {
                                    <option value="@y" selected="@(y == Model.Criteria.Year ? "selected" : null)">
                                        @y
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success fw-semibold">
                        <i class="bi bi-play-circle me-1"></i> Execute Bulk Calculation
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
