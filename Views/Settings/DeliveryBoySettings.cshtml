@model Dairy_Management_System.Models.Settings.DeliveryBoyPreferencesViewModel
@{
    Layout = "_LayoutDeliveryBoy";
    ViewData["Title"] = "Delivery Partner Preferences";
    ViewData["ActiveMenu"] = "Settings";
}

<div class="container-fluid px-3 py-3">
    <!-- Header & Navigation -->
    <div class="row mb-3 align-items-center">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted fs-7">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-primary">Portal</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Preferences</li>
                </ol>
            </nav>
            <h2 class="h4 fw-bold text-dark mb-1">
                <i class="cil-options text-primary me-2"></i>Field Partner Preferences
            </h2>
            <p class="text-muted small mb-0">
                Personalize your runsheet interface, sound alerts, and route display behavior.
            </p>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-3" role="alert">
            <div class="d-flex align-items-center">
                <i class="cil-check-circle fs-5 me-2"></i>
                <div class="small fw-semibold">@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Persistence Scope Notice -->
    <div class="card border-0 bg-light shadow-sm mb-3 border-start border-3 border-info">
        <div class="card-body p-3">
            <div class="d-flex align-items-center">
                <i class="cil-devices text-info fs-4 me-2"></i>
                <div class="small text-secondary">
                    <strong>Local Device Storage:</strong> These mobile preferences (language script, default shift, alert sound, and sunlight contrast) are saved locally in your current browser cookies. They apply to this device and browser session only; they are not stored in the central server database.
                </div>
            </div>
        </div>
    </div>

    <form asp-controller="Settings" asp-action="SavePreferences" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <!-- Language & Shift Card -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-3 mb-3">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="cil-language text-primary me-2"></i>Language & Route Display
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="mb-3">
                            <label asp-for="PreferredLanguage" class="form-label fw-semibold text-secondary small">Customer Name Language</label>
                            <select asp-for="PreferredLanguage" class="form-select">
                                <option value="en">English (Default)</option>
                                <option value="gu">Gujarati (ગુજરાતી)</option>
                            </select>
                            <div class="form-text small">Shows customer names in preferred script when available on your route runsheet.</div>
                        </div>

                        <div class="mb-2">
                            <label asp-for="DefaultShiftView" class="form-label fw-semibold text-secondary small">Default Runsheet Shift</label>
                            <select asp-for="DefaultShiftView" class="form-select">
                                <option value="Morning">Morning Distribution (સવાર)</option>
                                <option value="Evening">Evening Distribution (સાંજ)</option>
                            </select>
                            <div class="form-text small">Automatically opens this shift when loading your daily delivery entry portal.</div>
                        </div>
                    </div>
                </div>

                <!-- Accessibility & Sunlight Card -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="cil-sun text-primary me-2"></i>Field Readability
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="form-check form-switch mb-3">
                            <input asp-for="HighContrastRunsheet" class="form-check-input" type="checkbox" id="contrastSwitch">
                            <label class="form-check-label fw-semibold text-dark small" for="contrastSwitch">
                                High Contrast Card Mode
                            </label>
                            <div class="text-muted small">Increases text boldness and borders for outdoor sunlight readability.</div>
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input asp-for="AutoAdvanceNextCustomer" class="form-check-input" type="checkbox" id="advanceSwitch">
                            <label class="form-check-label fw-semibold text-dark small" for="advanceSwitch">
                                Auto-Focus Next Customer
                            </label>
                            <div class="text-muted small">Scrolls to the next customer in sequence after saving a delivery drop.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Notifications & Audio Card -->
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-3 mb-3">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="cil-bell text-primary me-2"></i>Audio & Route Alerts
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="form-check form-switch mb-3">
                            <input asp-for="EnableSoundAlerts" class="form-check-input" type="checkbox" id="soundSwitch">
                            <label class="form-check-label fw-semibold text-dark small" for="soundSwitch">
                                Enable Sound Alerts for Notifications
                            </label>
                            <div class="text-muted small">Plays an audio tone when new route alerts or bill publications arrive.</div>
                        </div>

                        <div class="p-3 bg-light rounded-3 border">
                            <div class="d-flex align-items-center mb-1">
                                <i class="cil-info text-primary me-2"></i>
                                <span class="fw-bold small text-dark">Route Alerts Policy</span>
                            </div>
                            <p class="small text-muted mb-0">
                                Midnight bill publication popups will appear on your portal once per billing cycle. 
                                Acknowledging notifications confirms you have viewed them and clears pending alerts.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="card border-0 shadow-sm rounded-3 bg-light-subtle">
                    <div class="card-body p-3">
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm">
                            <i class="cil-check me-1"></i> Save My Preferences
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
