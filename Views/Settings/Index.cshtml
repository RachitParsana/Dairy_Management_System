@model Dairy_Management_System.Models.Settings.SystemSettingsViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "System Settings & Enterprise Configuration";
}

<div class="container-fluid px-4 py-3">
    <!-- Breadcrumb & Header -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-7">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted fs-7">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Enterprise Settings</li>
                </ol>
            </nav>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="cil-settings text-success me-2"></i>Enterprise Settings & Configuration
            </h2>
            <p class="text-muted small mb-0">
                Manage dairy operational parameters, enterprise contacts, and delivery shift cutoffs.
            </p>
        </div>
        <div class="col-md-5 text-md-end mt-3 mt-md-0">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                <i class="cil-check-circle me-1"></i> Live Audit Enabled
            </span>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="cil-check-circle fs-4 me-2"></i>
                <div>
                    <strong>Configuration Updated:</strong> @TempData["SuccessMessage"]
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="cil-warning fs-4 me-2"></i>
                <div>
                    <strong>Operation Failed:</strong> @TempData["ErrorMessage"]
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Invariant Notice Banner -->
    <div class="card border-0 bg-light-subtle shadow-sm mb-4 border-start border-4 border-success">
        <div class="card-body p-3">
            <div class="d-flex align-items-start">
                <div class="p-2 rounded-3 bg-success text-white me-3">
                    <i class="cil-shield-alt fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-dark mb-1">Core Financial Architecture Invariants</h6>
                    <p class="text-muted small mb-0">
                        Enterprise configuration modifications are logged to <code class="text-dark">dbo.AuditLogs</code>. 
                        Changing system settings never modifies historical published billing records or customer ledger balances. 
                        Per approved financial rules, <strong>no automatic invoice due dates</strong> are supported; unpaid bills remain active until explicit manual receipt.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <form asp-controller="Settings" asp-action="Update" method="post" class="needs-validation">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="row g-4">
            <!-- Left Column: Enterprise Identity & Operations -->
            <div class="col-lg-6">
                <!-- Enterprise Identity Card -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="cil-institution text-success me-2"></i>Dairy Enterprise Identity
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="DairyName" class="form-label fw-semibold text-secondary small">Dairy Enterprise Name</label>
                            <input asp-for="DairyName" class="form-control" placeholder="e.g. Saurashtra Dairy Co-operative" />
                            <span asp-validation-for="DairyName" class="text-danger small"></span>
                            <div class="form-text small">Appears on system navigation bar, monthly invoices, and customer receipts.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OperatingAddress" class="form-label fw-semibold text-secondary small">Operating Head Office Address</label>
                            <textarea asp-for="OperatingAddress" rows="3" class="form-control" placeholder="e.g. Plot No. 45, GIDC Industrial Estate, Rajkot, Gujarat 360003"></textarea>
                            <span asp-validation-for="OperatingAddress" class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label asp-for="ContactPhone" class="form-label fw-semibold text-secondary small">Support Helpline Phone</label>
                                <input asp-for="ContactPhone" class="form-control" placeholder="e.g. +91 281 2456789" />
                                <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="ContactEmail" class="form-label fw-semibold text-secondary small">Official Support Email</label>
                                <input asp-for="ContactEmail" type="email" class="form-control" placeholder="e.g. support@dairyenterprise.in" />
                                <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Shift Operational Parameters -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="cil-clock text-success me-2"></i>Shift Schedule & Distribution Cutoffs
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label asp-for="MorningShiftCutoff" class="form-label fw-semibold text-secondary small">Morning Distribution Cutoff</label>
                                <input asp-for="MorningShiftCutoff" class="form-control" placeholder="e.g. 10:00 AM" />
                                <span asp-validation-for="MorningShiftCutoff" class="text-danger small"></span>
                                <div class="form-text small">Standard cutoff time for morning runsheet entry.</div>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="EveningShiftCutoff" class="form-label fw-semibold text-secondary small">Evening Distribution Cutoff</label>
                                <input asp-for="EveningShiftCutoff" class="form-control" placeholder="e.g. 08:30 PM" />
                                <span asp-validation-for="EveningShiftCutoff" class="text-danger small"></span>
                                <div class="form-text small">Standard cutoff time for evening runsheet entry.</div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <label asp-for="DefaultCurrency" class="form-label fw-semibold text-secondary small">Default Currency Symbol / Code</label>
                            <input asp-for="DefaultCurrency" class="form-control" placeholder="e.g. INR (₹)" style="max-width: 200px;" />
                            <span asp-validation-for="DefaultCurrency" class="text-danger small"></span>
                            <div class="form-text small">Displays on financial views, invoices, and payment receipts.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Broadcast Banner & System Status -->
            <div class="col-lg-6">
                <!-- System Announcement Banner -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="cil-bullhorn text-success me-2"></i>Global Operational Announcement
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="SystemAnnouncement" class="form-label fw-semibold text-secondary small">System Banner Message</label>
                            <textarea asp-for="SystemAnnouncement" rows="4" class="form-control" placeholder="Enter optional broadcast announcement to display on staff consoles (leave blank to disable)..."></textarea>
                            <span asp-validation-for="SystemAnnouncement" class="text-danger small"></span>
                            <div class="form-text small">Visible to all authenticated staff members upon logging in.</div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.SystemAnnouncement))
                        {
                            <div class="mt-3 p-3 bg-warning-subtle border border-warning-subtle rounded-3">
                                <span class="badge bg-warning text-dark mb-1">Active Preview</span>
                                <p class="small text-dark mb-0 fw-medium">@Model.SystemAnnouncement</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Administrative Actions Card -->
                <div class="card border-0 shadow-sm rounded-3 bg-light-subtle">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-dark mb-3">Commit Configuration Changes</h6>
                        <p class="text-muted small mb-4">
                            All updates are written atomically to the application settings repository with your administrative user credentials logged for audit compliance.
                        </p>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success px-4 py-2 fw-semibold text-white shadow-sm">
                                <i class="cil-save me-1"></i> Save Enterprise Settings
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2">
                                <i class="cil-reload me-1"></i> Discard
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
