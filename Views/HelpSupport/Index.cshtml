@{
    bool isAdmin = ViewBag.IsAdmin == true;
    Layout = isAdmin ? "_LayoutAdmin" : "_LayoutDeliveryBoy";
    ViewData["Title"] = "Help & Support Manual";
}

<div class="container-fluid @(isAdmin ? "px-4 py-3" : "px-3 py-3")">
    <!-- Header -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted fs-7">
                    <li class="breadcrumb-item">
                        <a href="@(isAdmin ? Url.Action("Index", "Home") : Url.Action("Privacy", "Home"))" class="text-decoration-none @(isAdmin ? "text-success" : "text-primary")">
                            Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Help & Support</li>
                </ol>
            </nav>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="cil-life-ring @(isAdmin ? "text-success" : "text-primary") me-2"></i>
                @(isAdmin ? "Enterprise Administration & Operational Manual" : "Field Partner Runsheet & Route Manual")
            </h2>
            <p class="text-muted small mb-0">
                @(isAdmin 
                    ? "Complete architectural guide, financial invariants reference, and billing procedures." 
                    : "Step-by-step guidance for daily morning/evening milk runsheets and route operations.")
            </p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <span class="badge @(isAdmin ? "bg-success-subtle text-success border border-success-subtle" : "bg-primary-subtle text-primary border border-primary-subtle") px-3 py-2 rounded-pill">
                <i class="cil-book me-1"></i> Documentation v1.2.0
            </span>
        </div>
    </div>

    @if (isAdmin)
    {
        <!-- ADMIN HELP CONTENT -->
        <div class="row g-4">
            <!-- Left Column: Core Workflows -->
            <div class="col-lg-8">
                <!-- Financial Invariants Accordion -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="cil-shield-alt text-success me-2"></i>Approved Financial & Ledger Architecture
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="accordion" id="adminFaqAccordion">
                            <div class="accordion-item border-0 mb-3 bg-light rounded-3">
                                <h2 class="accordion-header" id="headingOne">
                                    <button class="accordion-button collapsed rounded-3 fw-semibold text-dark bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                                        1. Manual Payment Allocation (No Automatic FIFO)
                                    </button>
                                </h2>
                                <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#adminFaqAccordion">
                                    <div class="accordion-body small text-secondary">
                                        <p class="mb-2">
                                            The dairy system enforces strict <strong>manual invoice selection</strong> for all payment receipts:
                                        </p>
                                        <ul class="mb-2">
                                            <li>Payments are never automatically distributed across chronological invoices via FIFO.</li>
                                            <li>Any receipt exceeding the targeted invoice balance remains unallocated advance credit in the customer ledger.</li>
                                            <li>Advance credit can be manually and explicitly applied to a specific outstanding invoice from the Billing management interface.</li>
                                            <li>All events are recorded into <code class="text-dark">dbo.PaymentAllocationEvents</code> with canonical event types: <code class="text-dark">InitialAllocation</code>, <code class="text-dark">ReversalAdjustment</code>, <code class="text-dark">VoidReversal</code>, and <code class="text-dark">AdvanceCreditAllocation</code>.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item border-0 mb-3 bg-light rounded-3">
                                <h2 class="accordion-header" id="headingTwo">
                                    <button class="accordion-button collapsed rounded-3 fw-semibold text-dark bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                        2. Month-Based Customer Balance Ageing
                                    </button>
                                </h2>
                                <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#adminFaqAccordion">
                                    <div class="accordion-body small text-secondary">
                                        <p class="mb-2">
                                            Receivables ageing buckets are strictly calculated based on elapsed calendar months between the billing period <code class="text-dark">(BillYear, BillMonth)</code> and the evaluation date:
                                        </p>
                                        <div class="table-responsive">
                                            <table class="table table-sm table-bordered bg-white small mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Bucket</th>
                                                        <th>Formula</th>
                                                        <th>Description</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td><span class="badge bg-success">Current Month</span></td>
                                                        <td><code>MonthsDiff == 0</code></td>
                                                        <td>Invoices published for the ongoing billing month.</td>
                                                    </tr>
                                                    <tr>
                                                        <td><span class="badge bg-info text-dark">1 Month</span></td>
                                                        <td><code>MonthsDiff == 1</code></td>
                                                        <td>Outstanding balance from previous calendar month.</td>
                                                    </tr>
                                                    <tr>
                                                        <td><span class="badge bg-primary">2 Months</span></td>
                                                        <td><code>MonthsDiff == 2</code></td>
                                                        <td>Outstanding balance from 2 months prior.</td>
                                                    </tr>
                                                    <tr>
                                                        <td><span class="badge bg-warning text-dark">3 Months</span></td>
                                                        <td><code>MonthsDiff == 3</code></td>
                                                        <td>Outstanding balance from 3 months prior.</td>
                                                    </tr>
                                                    <tr>
                                                        <td><span class="badge bg-secondary">4–5 Months</span></td>
                                                        <td><code>MonthsDiff IN (4, 5)</code></td>
                                                        <td>Intermediate aging balance.</td>
                                                    </tr>
                                                    <tr>
                                                        <td><span class="badge bg-danger">6+ Months</span></td>
                                                        <td><code>MonthsDiff >= 6</code></td>
                                                        <td>Critical overdue arrears bucket.</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item border-0 mb-3 bg-light rounded-3">
                                <h2 class="accordion-header" id="headingThree">
                                    <button class="accordion-button collapsed rounded-3 fw-semibold text-dark bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                        3. Bill Publication & Notification Guarantees
                                    </button>
                                </h2>
                                <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#adminFaqAccordion">
                                    <div class="accordion-body small text-secondary">
                                        <p class="mb-2">
                                            When monthly draft invoices are finalized and published:
                                        </p>
                                        <ul class="mb-0">
                                            <li>A <code class="text-dark">BillPublished</code> notification is created targeting each assigned delivery partner and route.</li>
                                            <li>Duplicate notifications are prevented by a database unique filtered index on <code class="text-dark">(ReferenceBillId, TargetDeliveryBoyId)</code>.</li>
                                            <li>A hosted background reconciliation worker ensures every published bill reliably receives its alert even across network or process restarts.</li>
                                            <li>Field partners experience a one-time popup alert upon login, tracked in <code class="text-dark">dbo.NotificationPopupSeen</code>.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item border-0 bg-light rounded-3">
                                <h2 class="accordion-header" id="headingFour">
                                    <button class="accordion-button collapsed rounded-3 fw-semibold text-dark bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                                        4. RFC 4180 Secure CSV Data Exports
                                    </button>
                                </h2>
                                <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#adminFaqAccordion">
                                    <div class="accordion-body small text-secondary">
                                        <p class="mb-2">
                                            All export streams from the Export Hub (<code class="text-dark">~/Export</code>) strictly implement:
                                        </p>
                                        <ul class="mb-0">
                                            <li><strong>UTF-8 Byte Order Mark (BOM):</strong> Ensures Gujarati Unicode customer names and Gujarati script display correctly in Microsoft Excel.</li>
                                            <li><strong>Spreadsheet Formula Injection Defense:</strong> Any cell beginning with <code>=</code>, <code>+</code>, <code>-</code>, or <code>@@</code> is prepended with a single quote to prevent executable macro exploits.</li>
                                            <li><strong>RFC 4180 Escaping:</strong> Commas, line breaks, and quotation marks are properly enclosed and escaped.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Administrative Operations Checklist -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="cil-task text-success me-2"></i>Daily & Monthly Operational Schedule
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="p-3 border rounded-3 h-100">
                                    <div class="d-flex align-items-center mb-2">
                                        <span class="badge bg-success me-2">Daily</span>
                                        <h6 class="fw-bold mb-0 text-dark">Morning & Evening Dispatch</h6>
                                    </div>
                                    <p class="small text-muted mb-0">
                                        Monitor delivery boy runsheets via Daily Milk. Confirm all route drops are completed before the shift cutoff time. Review any unscheduled deliveries.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 border rounded-3 h-100">
                                    <div class="d-flex align-items-center mb-2">
                                        <span class="badge bg-primary me-2">Monthly</span>
                                        <h6 class="fw-bold mb-0 text-dark">Billing & Payout Cycle</h6>
                                    </div>
                                    <p class="small text-muted mb-0">
                                        At month end, generate draft monthly bills, verify total volumes and rate tiers, publish finalized bills, and execute delivery partner compensation drafts.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Quick Links & Technical Support -->
            <div class="col-lg-4">
                <!-- Quick Navigation Links -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="cil-link text-success me-2"></i>Administrative Hubs
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="list-group list-group-flush small">
                            <a asp-controller="Billing" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-2 py-2">
                                <span><i class="cil-cash text-success me-2"></i>Billing & Invoices</span>
                                <i class="cil-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Reports" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-2 py-2">
                                <span><i class="cil-chart-pie text-success me-2"></i>Reports & Analytics</span>
                                <i class="cil-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Export" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-2 py-2">
                                <span><i class="cil-cloud-download text-success me-2"></i>Data Export Center</span>
                                <i class="cil-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Notification" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-2 py-2">
                                <span><i class="cil-bullhorn text-success me-2"></i>Broadcast Center</span>
                                <i class="cil-chevron-right text-muted"></i>
                            </a>
                            <a asp-controller="Settings" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-2 py-2">
                                <span><i class="cil-settings text-success me-2"></i>Enterprise Settings</span>
                                <i class="cil-chevron-right text-muted"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Emergency Support Desk -->
                <div class="card border-0 shadow-sm rounded-3 bg-light">
                    <div class="card-body p-4 text-center">
                        <div class="p-3 rounded-circle bg-success text-white d-inline-flex mb-3 shadow-sm">
                            <i class="cil-headset fs-3"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Technical Architecture Desk</h6>
                        <p class="small text-muted mb-3">
                            Direct escalation for ledger inconsistencies, database issues, or operational disruptions.
                        </p>
                        <div class="p-2 bg-white rounded-3 border mb-2 small fw-semibold text-dark">
                            <i class="cil-envelope-closed me-1 text-success"></i> tech-support@dairyenterprise.in
                        </div>
                        <div class="p-2 bg-white rounded-3 border small fw-semibold text-dark">
                            <i class="cil-phone me-1 text-success"></i> +91 (0281) 245-6799
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- DELIVERY BOY HELP CONTENT -->
        <div class="row g-3">
            <!-- Left Column: Field Runsheet Instructions -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-3 mb-3">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="cil-truck text-primary me-2"></i>Field Partner Delivery Guide
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="accordion" id="dbHelpAccordion">
                            <div class="accordion-item border-0 mb-3 bg-light rounded-3">
                                <h2 class="accordion-header" id="headingDbOne">
                                    <button class="accordion-button rounded-3 fw-semibold text-dark bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDbOne" aria-expanded="true" aria-controls="collapseDbOne">
                                        1. Completing Daily Runsheet (સવાર / સાંજ ડિલિવરી)
                                    </button>
                                </h2>
                                <div id="collapseDbOne" class="accordion-collapse collapse show" aria-labelledby="headingDbOne" data-bs-parent="#dbHelpAccordion">
                                    <div class="accordion-body small text-secondary">
                                        <ol class="mb-0 ps-3">
                                            <li class="mb-2">Go to <strong>Daily Runsheet</strong> from the menu or dashboard.</li>
                                            <li class="mb-2">Confirm the date and select your current shift: <strong>Morning</strong> or <strong>Evening</strong>.</li>
                                            <li class="mb-2">Follow the ordered customer list according to your assigned sequence numbers.</li>
                                            <li class="mb-2">Enter the exact litres delivered for each customer. Default subscribed quantities are pre-filled for convenience.</li>
                                            <li class="mb-2">Click <strong>Save Draft</strong> if you want to record progress while on the move.</li>
                                            <li>Once all deliveries are done, click <strong>Finalize Shift</strong> to submit the completed shift.</li>
                                        </ol>
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item border-0 mb-3 bg-light rounded-3">
                                <h2 class="accordion-header" id="headingDbTwo">
                                    <button class="accordion-button collapsed rounded-3 fw-semibold text-dark bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDbTwo" aria-expanded="false" aria-controls="collapseDbTwo">
                                        2. Customer Vacations & Stop Deliveries
                                    </button>
                                </h2>
                                <div id="collapseDbTwo" class="accordion-collapse collapse" aria-labelledby="headingDbTwo" data-bs-parent="#dbHelpAccordion">
                                    <div class="accordion-body small text-secondary">
                                        <p class="mb-2">
                                            If a customer is marked <span class="badge bg-warning text-dark">On Vacation</span>:
                                        </p>
                                        <ul class="mb-0">
                                            <li>Do not deliver milk to this address today unless explicitly requested by the customer.</li>
                                            <li>The system automatically records 0 litres for vacation days.</li>
                                            <li>Check your <strong>Route Customer Roster</strong> anytime to see active vacation dates.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item border-0 mb-3 bg-light rounded-3">
                                <h2 class="accordion-header" id="headingDbThree">
                                    <button class="accordion-button collapsed rounded-3 fw-semibold text-dark bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDbThree" aria-expanded="false" aria-controls="collapseDbThree">
                                        3. Monthly Bill Alerts & Popup Notices
                                    </button>
                                </h2>
                                <div id="collapseDbThree" class="accordion-collapse collapse" aria-labelledby="headingDbThree" data-bs-parent="#dbHelpAccordion">
                                    <div class="accordion-body small text-secondary">
                                        <p class="mb-2">
                                            When monthly customer bills are finalized by administration:
                                        </p>
                                        <ul class="mb-0">
                                            <li>A notification popup appears on your portal screen once.</li>
                                            <li>Click <strong>Understood / Dismiss</strong> to close the modal.</li>
                                            <li>Review detailed bill alerts in <strong>Route Alerts</strong> (<code class="text-dark">~/Notification/DeliveryBoyNotifications</code>).</li>
                                            <li>Click <strong>Acknowledge</strong> on notifications to confirm receipt.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Dispatch Contacts & Quick Action -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-3 mb-3 bg-primary text-white">
                    <div class="card-body p-4 text-center">
                        <i class="cil-headset fs-1 mb-2"></i>
                        <h5 class="fw-bold mb-1">Dispatch Supervisor Helpline</h5>
                        <p class="small opacity-90 mb-3">
                            For missing crates, route roadblocks, or customer address issues.
                        </p>
                        <a href="tel:+919876543210" class="btn btn-light text-primary fw-bold w-100 py-2 shadow-sm">
                            <i class="cil-phone me-1"></i> Call Supervisor: +91 98765 43210
                        </a>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="cil-task text-primary me-2"></i>Direct Field Shortcuts
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-grid gap-2">
                            <a asp-controller="DailyMilk" asp-action="Index" class="btn btn-outline-primary btn-sm py-2">
                                <i class="cil-notes me-1"></i> Open Today's Runsheet
                            </a>
                            <a asp-controller="DailyMilk" asp-action="MyCustomers" class="btn btn-outline-primary btn-sm py-2">
                                <i class="cil-people me-1"></i> My Route Customer Roster
                            </a>
                            <a asp-controller="Notification" asp-action="DeliveryBoyNotifications" class="btn btn-outline-primary btn-sm py-2">
                                <i class="cil-bell me-1"></i> View Route Alerts
                            </a>
                            <a asp-controller="Settings" asp-action="Profile" class="btn btn-outline-primary btn-sm py-2">
                                <i class="cil-user me-1"></i> My Profile & Compensation
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
