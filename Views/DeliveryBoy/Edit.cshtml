@model Dairy_Management_System.Models.DeliveryBoy.EditDeliveryBoyViewModel
@{
    ViewData["Title"] = $"Edit Profile: {Model.FullName}";
    ViewData["ActiveMenu"] = "DeliveryBoy";
}

<div class="container-fluid px-4 py-3">
    <!-- Breadcrumb & Header -->
    <div class="row align-items-center mb-3">
        <div class="col-md-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-controller="DeliveryBoy" asp-action="Index" class="text-decoration-none">Delivery Boys</a></li>
                    <li class="breadcrumb-item"><a asp-controller="DeliveryBoy" asp-action="Details" asp-route-id="@Model.DeliveryBoyId" class="text-decoration-none">@Model.FullName</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Edit Profile</li>
                </ol>
            </nav>
            <h3 class="mb-0 fw-bold text-dark">
                <i class="bi bi-pencil-square text-success me-2"></i>Edit Delivery Boy Profile
            </h3>
            <p class="text-muted small mb-0">Update contact details, vehicle assignment, route allocation, and salary configuration for @Model.FullName.</p>
        </div>
        <div class="col-md-4 text-md-end mt-2 mt-md-0">
            <a asp-controller="DeliveryBoy" asp-action="Details" asp-route-id="@Model.DeliveryBoyId" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Profile
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <h6 class="alert-heading fw-bold mb-1"><i class="bi bi-x-circle-fill me-2"></i>Please correct the following errors:</h6>
            <div asp-validation-summary="All" class="text-danger small mb-0"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Edit Form -->
    <form asp-controller="DeliveryBoy" asp-action="Edit" method="post" id="editDeliveryBoyForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="DeliveryBoyId" />
        <input type="hidden" asp-for="CompensationType" />

        <div class="row g-4">
            <!-- Left Column: Personal & Route Information -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="card-title mb-0 fw-bold text-dark">
                            <i class="bi bi-person-badge text-primary me-2"></i>Staff & Route Information
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="FullName" class="form-label fw-semibold">Full Legal Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                                    <input asp-for="FullName" class="form-control border-start-0" placeholder="e.g. Ramesh Patel" maxlength="100" required />
                                </div>
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold">Phone Number <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone text-muted"></i></span>
                                    <input asp-for="Phone" class="form-control border-start-0" placeholder="10-digit mobile number" maxlength="15" required />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="VehicleNumber" class="form-label fw-semibold">Vehicle Registration No.</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-truck text-muted"></i></span>
                                    <input asp-for="VehicleNumber" class="form-control border-start-0 text-uppercase" placeholder="e.g. GJ-03-AA-1234" maxlength="30" />
                                </div>
                                <span asp-validation-for="VehicleNumber" class="text-danger small"></span>
                                <div class="form-text small text-muted">Motorcycle, moped, or delivery van number.</div>
                            </div>

                            <div class="col-12">
                                <label asp-for="PrimaryRouteId" class="form-label fw-semibold">Assigned Primary Delivery Route <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-geo-alt text-muted"></i></span>
                                    <select asp-for="PrimaryRouteId" class="form-select border-start-0" required>
                                        <option value="">-- Select Active Delivery Route --</option>
                                        @if (Model.AvailableRoutes != null)
                                        {
                                            foreach (var route in Model.AvailableRoutes)
                                            {
                                                <option value="@route.RouteId" selected="@(route.RouteId == Model.PrimaryRouteId ? "selected" : null)">
                                                    @route.RouteCode - @route.RouteName
                                                </option>
                                            }
                                        }
                                    </select>
                                </div>
                                <span asp-validation-for="PrimaryRouteId" class="text-danger small"></span>
                                <div class="form-text small text-muted">Defines the primary geographical dispatch territory for morning runsheets.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Compensation & Policy Settings -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="card-title mb-0 fw-bold text-dark">
                            <i class="bi bi-cash-stack text-success me-2"></i>Compensation Profile
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">Compensation Model</label>
                            <div>
                                @if (Model.CompensationType == "Commission")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success px-3 py-2 fs-6">
                                        <i class="bi bi-graph-up-arrow me-1"></i> Per-Litre Commission Model
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2 fs-6">
                                        <i class="bi bi-wallet2 me-1"></i> Fixed Monthly Salary Model
                                    </span>
                                }
                            </div>
                            <div class="form-text small text-muted mt-2">
                                The compensation model is locked to maintain historical payroll integrity. Transitions between Fixed Salary and Commission take effect on the 1st of next month via the Solution Architect transition policy.
                            </div>
                        </div>

                        <hr class="my-3 text-muted" />

                        @if (Model.CompensationType == "Fixed Salary")
                        {
                            <div class="mb-3">
                                <label asp-for="MonthlyBaseSalary" class="form-label fw-semibold">Monthly Base Salary (₹) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">₹</span>
                                    <input asp-for="MonthlyBaseSalary" class="form-control" type="number" step="0.01" min="0" max="1000000" required />
                                </div>
                                <span asp-validation-for="MonthlyBaseSalary" class="text-danger small"></span>
                                <div class="form-text small text-muted">
                                    Updates the contract monthly base salary. Future draft payrolls will automatically calculate using this value.
                                </div>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="MonthlyBaseSalary" value="0.00" />
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-muted">Current Active Commission Rate</label>
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="text-muted small">Active Rate Per Litre:</span>
                                            <div class="fs-4 fw-bold text-success">₹@Model.CurrentCommissionRate.ToString("N2") <small class="text-muted fs-6">/ Litre</small></div>
                                        </div>
                                        <span class="badge bg-success px-2 py-1">Active</span>
                                    </div>
                                </div>
                                <div class="form-text small text-muted mt-2">
                                    <i class="bi bi-info-circle me-1"></i>Commission rates are version-controlled via immutable tiers with effective dates. Rate adjustments are logged in the Commission History table on the details view.
                                </div>
                            </div>
                        }

                        <div class="alert alert-light border small text-muted mb-0 mt-4">
                            <i class="bi bi-shield-check text-primary me-1"></i>
                            <strong>Audit Trail:</strong> Any profile changes will be logged with your administrator user identity and current timestamp.
                        </div>
                    </div>
                </div>

                <!-- Action Card -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                        <a asp-controller="DeliveryBoy" asp-action="Details" asp-route-id="@Model.DeliveryBoyId" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-success px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Save Changes
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
