@model Dairy_Management_System.Models.DeliveryBoy.CreateDeliveryBoyViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Register Delivery Boy";
    ViewData["ActiveMenu"] = "DeliveryBoy";
}

<div class="admin-deliveryboy-create-container pb-5" style="max-width: 860px; margin: 0 auto;">
    <!-- Breadcrumb & Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Delivery Boys</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Register New Agent</li>
                </ol>
            </nav>
            <h4 class="fw-bold text-dark mb-0">Register Field Delivery Boy</h4>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
            <i class="cil-arrow-left"></i> Back to Directory
        </a>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-danger-subtle shadow-sm alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="cil-warning fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="Create" method="post" id="createDeliveryBoyForm" class="needs-validation">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 shadow-sm" role="alert"></div>

        <!-- Section 1: Staff Account & Personal Details -->
        <div class="card border-0 bg-white shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center gap-2">
                <div class="rounded p-1 bg-success-subtle text-success">
                    <i class="cil-user fs-5"></i>
                </div>
                <h6 class="mb-0 fw-bold text-dark">Personal &amp; Login Credentials</h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-semibold small text-muted">Full Legal Name <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Ramesh Kumar Patel" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Username" class="form-label fw-semibold small text-muted">Username (for portal login) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">@@</span>
                            <input asp-for="Username" class="form-control" placeholder="e.g. ramesh_patel" required autocomplete="username" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold small text-muted">Mobile Phone Number <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="cil-phone"></i></span>
                            <input asp-for="Phone" class="form-control" placeholder="10-digit mobile number" required type="tel" />
                        </div>
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold small text-muted">Initial Password <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="cil-lock-locked"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="Minimum 6 characters" required autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                        <div class="form-text small">Cryptographically hashed upon creation; never stored or displayed in plaintext.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 2: Fleet Route & Logistics -->
        <div class="card border-0 bg-white shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center gap-2">
                <div class="rounded p-1 bg-primary-subtle text-primary">
                    <i class="cil-location-pin fs-5"></i>
                </div>
                <h6 class="mb-0 fw-bold text-dark">Primary Route &amp; Logistics</h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="PrimaryRouteId" class="form-label fw-semibold small text-muted mb-0">Primary Route Allocation <span class="text-danger">*</span></label>
                            <button type="button" class="btn btn-link btn-sm p-0 text-success fw-semibold text-decoration-none"
                                    onclick="openQuickAddRouteModal('PrimaryRouteId', 'name-first')">
                                <i class="cil-plus"></i> Add New Route
                            </button>
                        </div>
                        <select asp-for="PrimaryRouteId" class="form-select" required>
                            <option value="">-- Select Master Route --</option>
                            @if (Model.AvailableRoutes != null)
                            {
                                @foreach (var r in Model.AvailableRoutes)
                                {
                                    <option value="@r.RouteId">@r.RouteName (@r.RouteCode)</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="PrimaryRouteId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="VehicleNumber" class="form-label fw-semibold small text-muted">Vehicle Registration Number (Optional)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="cil-truck"></i></span>
                            <input asp-for="VehicleNumber" class="form-control" placeholder="e.g. GJ-03-AB-1234" />
                        </div>
                        <span asp-validation-for="VehicleNumber" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 3: Compensation Structure (Commission vs Fixed Salary) -->
        <div class="card border-0 bg-white shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center gap-2">
                <div class="rounded p-1 bg-warning-subtle text-warning">
                    <i class="cil-cash fs-5"></i>
                </div>
                <h6 class="mb-0 fw-bold text-dark">Compensation &amp; Payroll Model</h6>
            </div>
            <div class="card-body p-4">
                <div class="mb-4">
                    <label class="form-label fw-semibold small text-muted d-block">Select Compensation Type <span class="text-danger">*</span></label>
                    <div class="d-flex gap-4">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="CompensationType" id="compTypeCommission" value="Commission" @(Model.CompensationType == "Commission" ? "checked" : "") onchange="toggleCompModel()" />
                            <label class="form-check-label fw-medium text-dark" for="compTypeCommission">
                                Commission-Based (₹ per Eligible Litre)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="CompensationType" id="compTypeFixedSalary" value="Fixed Salary" @(Model.CompensationType == "Fixed Salary" ? "checked" : "") onchange="toggleCompModel()" />
                            <label class="form-check-label fw-medium text-dark" for="compTypeFixedSalary">
                                Fixed Monthly Salary (Recurring ₹/Month)
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Dynamic Sub-Panel: Commission Settings -->
                <div id="commissionPanel" class="p-3 rounded border bg-light-subtle mb-3" style="display: @(Model.CompensationType == "Commission" ? "block" : "none");">
                    <div class="d-flex align-items-center gap-2 mb-2 text-primary fw-semibold small">
                        <i class="cil-info"></i> Commission Tier Configuration
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="InitialCommissionRate" class="form-label fw-semibold small text-muted">Initial Commission Rate per Litre (₹) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white">₹</span>
                                <input asp-for="InitialCommissionRate" class="form-control" type="number" step="0.25" min="0.01" max="100.00" placeholder="e.g. 2.50" id="initialCommissionInput" />
                            </div>
                            <span asp-validation-for="InitialCommissionRate" class="text-danger small"></span>
                            <div class="form-text small">Snapshotted into daily completed deliveries; historical deliveries will not drift on future changes.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EffectiveFrom" class="form-label fw-semibold small text-muted">Effective Start Date <span class="text-danger">*</span></label>
                            <input asp-for="EffectiveFrom" class="form-control" type="date" id="effectiveFromInput" />
                            <span asp-validation-for="EffectiveFrom" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Dynamic Sub-Panel: Fixed Salary Settings -->
                <div id="fixedSalaryPanel" class="p-3 rounded border bg-light-subtle mb-3" style="display: @(Model.CompensationType == "Fixed Salary" ? "block" : "none");">
                    <div class="d-flex align-items-center gap-2 mb-2 text-purple fw-semibold small" style="color: #7c3aed;">
                        <i class="cil-info"></i> Fixed Salary Configuration
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="MonthlyBaseSalary" class="form-label fw-semibold small text-muted">Monthly Base Salary (₹) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white">₹</span>
                                <input asp-for="MonthlyBaseSalary" class="form-control" type="number" step="100.00" min="0.00" max="1000000.00" placeholder="e.g. 15000.00" id="baseSalaryInput" />
                            </div>
                            <span asp-validation-for="MonthlyBaseSalary" class="text-danger small"></span>
                            <div class="form-text small">Fixed monthly base salary; does not accrue per-litre delivery commission.</div>
                        </div>
                    </div>
                </div>

                <div class="mb-0">
                    <label asp-for="Notes" class="form-label fw-semibold small text-muted">Administrative Onboarding Notes (Optional)</label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="e.g. Recruited for West Zone morning run..."></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- Submit & Actions Ribbon -->
        <div class="d-flex align-items-center justify-content-between p-3 bg-white rounded shadow-sm">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-success text-white px-4 d-inline-flex align-items-center gap-2 shadow-sm">
                <i class="cil-check"></i> Register Delivery Boy
            </button>
        </div>
    </form>
</div>

<partial name="_QuickAddRouteModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleCompModel() {
            const isCommission = document.getElementById('compTypeCommission').checked;
            const commPanel = document.getElementById('commissionPanel');
            const salaryPanel = document.getElementById('fixedSalaryPanel');
            const commRateInput = document.getElementById('initialCommissionInput');
            const effFromInput = document.getElementById('effectiveFromInput');
            const salaryInput = document.getElementById('baseSalaryInput');

            if (isCommission) {
                commPanel.style.display = 'block';
                salaryPanel.style.display = 'none';

                commRateInput.disabled = false;
                effFromInput.disabled = false;
                salaryInput.disabled = true;
                salaryInput.value = '0.00';
            } else {
                commPanel.style.display = 'none';
                salaryPanel.style.display = 'block';

                commRateInput.disabled = true;
                effFromInput.disabled = true;
                commRateInput.value = '0.00';
                salaryInput.disabled = false;
            }
        }

        // Initialize state on load
        document.addEventListener('DOMContentLoaded', function () {
            toggleCompModel();
        });
    </script>
}
