@model Dairy_Management_System.Models.DeliveryBoy.DeliveryBoyDetailsDto
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = $"Delivery Boy: {Model.FullName}";
    ViewData["ActiveMenu"] = "DeliveryBoy";
}

<div class="admin-deliveryboy-details-container pb-5">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Delivery Boys</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Agent Profile #@Model.DeliveryBoyId</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2">
                <h4 class="fw-bold text-dark mb-0">@Model.FullName</h4>
                @if (Model.IsActive)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                        <i class="cil-check me-1"></i> Active
                    </span>
                }
                else
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                        <i class="cil-x me-1"></i> Inactive
                    </span>
                }
                @if (Model.CompensationType == "Commission")
                {
                    <span class="badge bg-info-subtle text-info border border-info-subtle">
                        <i class="cil-chart-pie me-1"></i> Commission Tier (₹@Model.CurrentCommissionRate.ToString("N2")/L)
                    </span>
                }
                else
                {
                    <span class="badge border" style="background-color: #faf5ff; color: #7c3aed; border-color: #e9d5ff !important;">
                        <i class="cil-briefcase me-1"></i> Fixed Salary (₹@Model.MonthlyBaseSalary.ToString("N2")/mo)
                    </span>
                }
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="cil-arrow-left me-1"></i> Back to Directory
            </a>
            <a asp-action="Edit" asp-route-id="@Model.DeliveryBoyId" class="btn btn-outline-secondary btn-sm">
                <i class="cil-pencil me-1"></i> Edit Profile
            </a>
            @if (Model.IsActive)
            {
                <button type="button" class="btn btn-outline-warning btn-sm text-dark" data-coreui-toggle="modal" data-coreui-target="#resetPasswordModal" data-bs-toggle="modal" data-bs-target="#resetPasswordModal">
                    <i class="cil-lock-locked me-1"></i> Reset Password
                </button>
                <button type="button" class="btn btn-outline-danger btn-sm" data-coreui-toggle="modal" data-coreui-target="#deactivateModal" data-bs-toggle="modal" data-bs-target="#deactivateModal">
                    <i class="cil-user-x me-1"></i> Deactivate Agent
                </button>
            }
            else
            {
                <button type="button" class="btn btn-outline-success btn-sm" data-coreui-toggle="modal" data-coreui-target="#reactivateModal" data-bs-toggle="modal" data-bs-target="#reactivateModal">
                    <i class="cil-action-undo me-1"></i> Reactivate Agent
                </button>
            }
            <a asp-controller="Compensation" asp-action="Index" asp-route-deliveryBoyId="@Model.DeliveryBoyId" class="btn btn-success btn-sm text-white">
                <i class="cil-cash me-1"></i> Compensation Statements
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-success-subtle shadow-sm alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="cil-check-circle fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-danger-subtle shadow-sm alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="cil-warning fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Agent Profile Overview Card -->
    <div class="card border-0 bg-white shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="row g-4 align-items-center">
                <div class="col-auto">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold fs-2 shadow-sm" style="width: 72px; height: 72px; background-color: @(Model.IsActive ? "#059669" : "#94a3b8");">
                        @(string.IsNullOrWhiteSpace(Model.FullName) ? "DB" : (Model.FullName.Length >= 2 ? Model.FullName.Substring(0, 2).ToUpper() : Model.FullName.ToUpper()))
                    </div>
                </div>
                <div class="col">
                    <h5 class="fw-bold text-dark mb-1">@Model.FullName</h5>
                    <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
                        <span><i class="cil-user me-1"></i>@@@Model.Username</span>
                        <span><i class="cil-phone me-1"></i><span class="font-tabular">@Model.Phone</span></span>
                        @if (!string.IsNullOrWhiteSpace(Model.VehicleNumber))
                        {
                            <span><i class="cil-truck me-1"></i>@Model.VehicleNumber</span>
                        }
                        <span><i class="cil-location-pin me-1"></i>@(Model.RouteName ?? "Unassigned Route") (@(Model.RouteCode ?? "N/A"))</span>
                    </div>
                </div>
                <div class="col-md-auto border-start ps-md-4">
                    <div class="row g-3 text-center">
                        <div class="col-auto px-3">
                            <span class="text-muted small d-block">Active Customers</span>
                            <span class="fs-4 fw-bold text-dark font-tabular">@Model.AssignedCustomers.Count(c => c.AssignmentIsActive)</span>
                        </div>
                        <div class="col-auto px-3 border-start">
                            <span class="text-muted small d-block">Rate / Salary</span>
                            <span class="fs-4 fw-bold text-success font-tabular">
                                @if (Model.CompensationType == "Commission")
                                {
                                    <span>₹@Model.CurrentCommissionRate.ToString("N2") <small class="fs-7 fw-normal text-muted">/L</small></span>
                                }
                                else
                                {
                                    <span>₹@Model.MonthlyBaseSalary.ToString("N2") <small class="fs-7 fw-normal text-muted">/mo</small></span>
                                }
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-3 opacity-25" />

            <div class="row g-2 text-muted small">
                <div class="col-sm-6 col-md-3">
                    <strong>Account Created:</strong> @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                </div>
                <div class="col-sm-6 col-md-3">
                    <strong>Created By:</strong> @(Model.CreatedByName ?? "System Admin")
                </div>
                <div class="col-sm-6 col-md-3">
                    <strong>Last Updated:</strong> @(Model.UpdatedAt?.ToString("dd MMM yyyy") ?? "Never")
                </div>
                <div class="col-sm-6 col-md-3">
                    <strong>Last Login:</strong> @(Model.LastLoginAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "Never logged in")
                </div>
            </div>
        </div>
    </div>

    <!-- Tabbed Navigation -->
    <div class="card border-0 bg-white shadow-sm">
        <div class="card-header bg-white border-bottom p-0">
            <ul class="nav nav-tabs card-header-tabs mx-3 mt-2" id="deliveryBoyTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-medium px-4 py-3" id="customers-tab" data-coreui-toggle="tab" data-coreui-target="#customers-pane" data-bs-toggle="tab" data-bs-target="#customers-pane" type="button" role="tab" aria-controls="customers-pane" aria-selected="true">
                        <i class="cil-people me-1"></i> Assigned Customers (@Model.AssignedCustomers.Count(c => c.AssignmentIsActive))
                    </button>
                </li>
                @if (Model.CompensationType == "Commission")
                {
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-medium px-4 py-3" id="rates-tab" data-coreui-toggle="tab" data-coreui-target="#rates-pane" data-bs-toggle="tab" data-bs-target="#rates-pane" type="button" role="tab" aria-controls="rates-pane" aria-selected="false">
                            <i class="cil-history me-1"></i> Commission Rate Tiers (@Model.CommissionRateHistory.Count)
                        </button>
                    </li>
                }
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-medium px-4 py-3" id="compensations-tab" data-coreui-toggle="tab" data-coreui-target="#compensations-pane" data-bs-toggle="tab" data-bs-target="#compensations-pane" type="button" role="tab" aria-controls="compensations-pane" aria-selected="false">
                        <i class="cil-cash me-1"></i> Monthly Statements (@Model.RecentCompensations.Count)
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-4">
            <div class="tab-content" id="deliveryBoyTabContent">
                <!-- Tab 1: Assigned Customers -->
                <div class="tab-pane fade show active" id="customers-pane" role="tabpanel" aria-labelledby="customers-tab">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-bold text-dark mb-0">Active Customer Roster</h6>
                        <span class="text-muted small">Deliveries on @(Model.RouteName ?? "Primary Route") assigned to this agent</span>
                    </div>

                    @if (Model.AssignedCustomers != null && Model.AssignedCustomers.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small text-muted text-uppercase">
                                    <tr>
                                        <th>Code</th>
                                        <th>Customer Name</th>
                                        <th>Mobile Phone</th>
                                        <th>Address / Area</th>
                                        <th>Route</th>
                                        <th>Assigned From</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cust in Model.AssignedCustomers)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-light text-dark border font-tabular">@cust.CustomerCode</span>
                                            </td>
                                            <td>
                                                <div class="fw-semibold text-dark">@cust.FullName</div>
                                                @if (!string.IsNullOrWhiteSpace(cust.FullNameGujarati))
                                                {
                                                    <div class="text-muted small">@cust.FullNameGujarati</div>
                                                }
                                            </td>
                                            <td class="font-tabular">@cust.Phone</td>
                                            <td class="small">
                                                @(cust.Address ?? "N/A")
                                                @if (!string.IsNullOrWhiteSpace(cust.Area))
                                                {
                                                    <span class="text-muted">(@cust.Area)</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border">@cust.RouteName</span>
                                            </td>
                                            <td class="font-tabular small">@cust.AssignedFrom.ToString("dd MMM yyyy")</td>
                                            <td>
                                                @if (cust.AssignmentIsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border">Ended</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a href="~/Customer/Details/@cust.CustomerId" class="btn btn-outline-secondary btn-sm" title="View Customer Profile">
                                                    <i class="cil-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="cil-people fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            <h6 class="fw-semibold">No Customers Assigned</h6>
                            <p class="small mb-0">This delivery boy currently has no active customer subscriptions allocated.</p>
                        </div>
                    }
                </div>

                @if (Model.CompensationType == "Commission")
                {
                    <!-- Tab 2: Commission Rate Tiers -->
                    <div class="tab-pane fade" id="rates-pane" role="tabpanel" aria-labelledby="rates-tab">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <h6 class="fw-bold text-dark mb-0">Commission Rate Tier History</h6>
                                <p class="text-muted small mb-0">Rate changes take effect prospectively; completed deliveries retain their historical snapshot rates.</p>
                            </div>
                            @if (Model.IsActive)
                            {
                                <button type="button" class="btn btn-sm btn-outline-success fw-semibold" data-coreui-toggle="modal" data-coreui-target="#addCommissionRateModal" data-bs-toggle="modal" data-bs-target="#addCommissionRateModal">
                                    <i class="bi bi-plus-circle me-1"></i> Add New Rate Tier
                                </button>
                            }
                        </div>

                        @if (Model.CommissionRateHistory != null && Model.CommissionRateHistory.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-muted text-uppercase">
                                        <tr>
                                            <th>Tier ID</th>
                                            <th>Commission Rate</th>
                                            <th>Effective From</th>
                                            <th>Effective To</th>
                                            <th>Status</th>
                                            <th>Notes / Policy</th>
                                            <th>Created By</th>
                                            <th>Created At</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var rate in Model.CommissionRateHistory.OrderByDescending(r => r.EffectiveFrom))
                                        {
                                            bool isCurrent = !rate.EffectiveTo.HasValue;
                                            <tr class="@(isCurrent ? "table-success-subtle" : "")">
                                                <td class="font-tabular">#@rate.RateId</td>
                                                <td class="fw-bold text-success font-tabular">
                                                    ₹@rate.CommissionRatePerLitre.ToString("N2") <small class="text-muted fw-normal">/ Litre</small>
                                                </td>
                                                <td class="font-tabular">@rate.EffectiveFrom.ToString("dd MMM yyyy")</td>
                                                <td class="font-tabular">
                                                    @(rate.EffectiveTo.HasValue ? rate.EffectiveTo.Value.ToString("dd MMM yyyy") : "Open-ended (Current)")
                                                </td>
                                                <td>
                                                    @if (isCurrent)
                                                    {
                                                        <span class="badge bg-success text-white">Active Tier</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary border">Archived</span>
                                                    }
                                                </td>
                                                <td class="small text-muted">@(rate.Notes ?? "Standard Tier")</td>
                                                <td class="small">@(rate.CreatedByName ?? "System Admin")</td>
                                                <td class="small font-tabular">@rate.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="cil-chart-pie fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <h6 class="fw-semibold">No Rate Tiers Recorded</h6>
                                <p class="small mb-0">No historical commission rate tiers exist for this delivery agent.</p>
                            </div>
                        }
                    </div>
                }

                <!-- Tab 3: Monthly Compensation Statements -->
                <div class="tab-pane fade" id="compensations-pane" role="tabpanel" aria-labelledby="compensations-tab">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h6 class="fw-bold text-dark mb-0">Monthly Payroll &amp; Compensation History</h6>
                            <p class="text-muted small mb-0">Historical earnings, ledger adjustments, statement locks, and payout disbursements.</p>
                        </div>
                        <form asp-controller="Compensation" asp-action="CalculateDraft" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="deliveryBoyId" value="@Model.DeliveryBoyId" />
                            <input type="hidden" name="month" value="@DateTime.Today.Month" />
                            <input type="hidden" name="year" value="@DateTime.Today.Year" />
                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                <i class="cil-calculator me-1"></i> Calculate Current Month Draft
                            </button>
                        </form>
                    </div>

                    @if (Model.RecentCompensations != null && Model.RecentCompensations.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small text-muted text-uppercase">
                                    <tr>
                                        <th>Month / Year</th>
                                        <th>Model</th>
                                        <th>Delivered Volume</th>
                                        <th>Base / Commission</th>
                                        <th>Adjustments</th>
                                        <th>Net Payable</th>
                                        <th>Status</th>
                                        <th>Payout Date</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var comp in Model.RecentCompensations.OrderByDescending(c => c.Year).ThenByDescending(c => c.Month))
                                    {
                                        <tr>
                                            <td class="fw-semibold font-tabular">
                                                @(new DateTime(comp.Year, comp.Month, 1).ToString("MMMM yyyy"))
                                            </td>
                                            <td>
                                                <span class="badge @(comp.CompensationType == "Commission" ? "bg-info-subtle text-info border border-info-subtle" : "bg-purple-subtle border")" style="@(comp.CompensationType == "Fixed Salary" ? "background-color: #faf5ff; color: #7c3aed; border-color: #e9d5ff !important;" : "")">
                                                    @comp.CompensationType
                                                </span>
                                            </td>
                                            <td class="font-tabular">
                                                @comp.EligibleCompletedLitres.ToString("N3") <small class="text-muted">L</small>
                                            </td>
                                            <td class="font-tabular">
                                                @if (comp.CompensationType == "Commission")
                                                {
                                                    <span>₹@comp.CalculatedCommission.ToString("N2")</span>
                                                }
                                                else
                                                {
                                                    <span>₹@comp.FixedSalaryAmount.ToString("N2")</span>
                                                }
                                            </td>
                                            <td class="font-tabular @(comp.Adjustments > 0 ? "text-success" : (comp.Adjustments < 0 ? "text-danger" : "text-muted"))">
                                                @(comp.Adjustments >= 0 ? "+" : "")₹@comp.Adjustments.ToString("N2")
                                            </td>
                                            <td class="fw-bold font-tabular text-dark fs-6">
                                                ₹@comp.NetPayableAmount.ToString("N2")
                                            </td>
                                            <td>
                                                @if (comp.Status == "Draft")
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Draft</span>
                                                }
                                                else if (comp.Status == "Finalized")
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Finalized</span>
                                                }
                                                else if (comp.Status == "Paid")
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Paid</span>
                                                }
                                            </td>
                                            <td class="small font-tabular">
                                                @(comp.PaidAt?.ToString("dd MMM yyyy") ?? "-")
                                            </td>
                                            <td class="text-end">
                                                <a asp-controller="Compensation" asp-action="Details" asp-route-id="@comp.CompensationId" class="btn btn-outline-secondary btn-sm" title="View Full Statement">
                                                    <i class="cil-description me-1"></i> Statement
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="cil-cash fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            <h6 class="fw-semibold">No Compensation Statements Generated</h6>
                            <p class="small mb-0">Click 'Calculate Current Month Draft' above or use the Bulk Calculation workspace.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Admin Reset Delivery Boy Password -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-controller="DeliveryBoy" asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="deliveryBoyId" value="@Model.DeliveryBoyId" />
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fs-6 fw-bold" id="resetPasswordModalLabel">
                        <i class="cil-lock-locked me-2"></i> Reset Delivery Partner Password
                    </h5>
                    <button type="button" class="btn-close" data-coreui-dismiss="modal" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="small text-muted mb-3">
                        Set a new login password for <strong>@Model.FullName</strong> (Mobile: <code>@Model.Phone</code>).
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">New Password <span class="text-danger">*</span></label>
                        <input type="password" name="newPassword" class="form-control" minlength="8" required placeholder="Minimum 8 characters" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-semibold small text-muted">Confirm New Password <span class="text-danger">*</span></label>
                        <input type="password" name="confirmPassword" class="form-control" minlength="8" required placeholder="Re-enter new password" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-coreui-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning btn-sm fw-semibold text-dark px-4">
                        <i class="cil-check me-1"></i> Reset Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Deactivate Delivery Boy -->
<div class="modal fade" id="deactivateModal" tabindex="-1" aria-labelledby="deactivateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="Deactivate" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="DeliveryBoyId" value="@Model.DeliveryBoyId" />
                <input type="hidden" name="FullName" value="@Model.FullName" />

                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fs-6 fw-bold" id="deactivateModalLabel">
                        <i class="cil-warning me-2"></i> Confirm Agent Deactivation
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-coreui-dismiss="modal" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-warning border-warning-subtle small mb-3">
                        <strong>Important Lifecycle Consequences:</strong>
                        <ul class="mb-0 ps-3 mt-1">
                            <li>Staff portal login access will be immediately blocked.</li>
                            <li>The agent cannot submit new delivery runsheet entries.</li>
                            <li>Historical delivery entries and rate snapshots remain immutable.</li>
                            <li>Existing unpaid compensation statements remain payable.</li>
                        </ul>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Active Customers on Route (@(Model.AssignedCustomers?.Count(c => c.AssignmentIsActive) ?? 0) Customers)</label>
                        <select name="ReassignToDeliveryBoyId" class="form-select form-select-sm">
                            <option value="">-- Leave Customers Unassigned (Reassign Later) --</option>
                            @if (ViewBag.ActiveDeliveryBoys != null)
                            {
                                foreach (var b in (IEnumerable<Dairy_Management_System.Models.Customer.DeliveryBoyLookupItem>)ViewBag.ActiveDeliveryBoys)
                                {
                                    <option value="@b.DeliveryBoyId">Reassign to: @b.FullName (@b.Phone)</option>
                                }
                            }
                        </select>
                        <div class="form-text small">Select another active agent to transfer customers atomically, or leave unassigned.</div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label fw-semibold small text-muted">Deactivation Reason / Justification <span class="text-danger">*</span></label>
                        <textarea name="Reason" class="form-control" rows="3" placeholder="State reason (minimum 5 characters)..." required minlength="5" maxlength="250"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-coreui-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm text-white">
                        <i class="cil-user-x me-1"></i> Confirm Deactivation
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Reactivate Delivery Boy -->
<div class="modal fade" id="reactivateModal" tabindex="-1" aria-labelledby="reactivateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="Reactivate" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="DeliveryBoyId" value="@Model.DeliveryBoyId" />
                <input type="hidden" name="FullName" value="@Model.FullName" />
                <input type="hidden" name="CompensationType" value="@Model.CompensationType" />

                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fs-6 fw-bold" id="reactivateModalLabel">
                        <i class="cil-check-circle me-2"></i> Confirm Agent Reactivation
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-coreui-dismiss="modal" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="small text-muted mb-3">
                        Reactivating <strong>@Model.FullName</strong> will restore their login access and allow them to be assigned to routes. Historical customer assignments are <em>not</em> automatically restored.
                    </p>

                    @if (Model.CompensationType == "Commission")
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">Approved Commission Rate (₹ per Litre) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">₹</span>
                                <input type="number" step="0.25" min="0.01" max="100.00" name="NewCommissionRate" value="@Model.CurrentCommissionRate.ToString("F2")" class="form-control" required />
                            </div>
                            <div class="form-text small">Reactivation strictly requires an active commission rate tier effective from today.</div>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 bg-light rounded small text-muted">
                            <i class="cil-info me-1 text-primary"></i> Fixed monthly base salary of <strong>₹@Model.MonthlyBaseSalary.ToString("N2")</strong> will be restored upon reactivation.
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-coreui-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm text-white">
                        <i class="cil-check me-1"></i> Confirm Reactivation
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.CompensationType == "Commission" && Model.IsActive)
{
    <!-- Modal: Add New Commission Rate Tier -->
    <div class="modal fade" id="addCommissionRateModal" tabindex="-1" aria-labelledby="addCommissionRateModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="DeliveryBoy" asp-action="AddCommissionRate" method="post" id="addCommissionRateForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="deliveryBoyId" value="@Model.DeliveryBoyId" />

                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title fw-bold" id="addCommissionRateModalLabel">
                            <i class="bi bi-graph-up-arrow me-2"></i>Configure New Commission Rate Tier
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-coreui-dismiss="modal" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="alert alert-info border-info small mb-3">
                            <i class="bi bi-info-circle-fill me-1"></i>
                            <strong>Effective-Dated Policy:</strong> Establishing a new rate tier automatically closes the current open-ended tier as of the day prior to the effective date. Past delivery snapshots and completed runsheets remain completely immutable.
                        </div>

                        <div class="p-3 bg-light rounded-3 border mb-3">
                            <div class="d-flex justify-content-between text-muted small mb-1">
                                <span>Delivery Agent:</span>
                                <strong class="text-dark">@Model.FullName</strong>
                            </div>
                            <div class="d-flex justify-content-between text-muted small">
                                <span>Current Active Rate:</span>
                                <strong class="text-success">₹@Model.CurrentCommissionRate.ToString("N2") / Litre</strong>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">New Commission Rate (₹ per Litre) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">₹</span>
                                <input type="number" step="0.01" min="0.01" max="100.00" name="commissionRate" class="form-control" placeholder="e.g. 2.75" required />
                                <span class="input-group-text bg-light">/ Litre</span>
                            </div>
                            <div class="form-text small text-muted">Must be greater than ₹0.00 per litre.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Effective-From Date <span class="text-danger">*</span></label>
                            @{
                                var nextMonthFirst = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1);
                            }
                            <input type="date" name="effectiveFrom" class="form-control" value="@nextMonthFirst.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            <div class="form-text small text-muted">
                                Per approved architecture, normal rate adjustments default to the 1st of the calendar month (@nextMonthFirst.ToString("dd-MMM-yyyy")).
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Administrative Justification / Policy Notes</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="e.g. Annual rate revision, fuel allowance adjustment, seniority tier upgrade..." maxlength="250"></textarea>
                            <div class="form-text small text-muted">Mandatory audit notes recorded with your administrator identity.</div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" data-coreui-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success fw-semibold">
                            <i class="bi bi-check-circle me-1"></i> Confirm &amp; Apply Rate Tier
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
