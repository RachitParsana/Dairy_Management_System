@model Dairy_Management_System.Models.DeliveryBoy.ReactivateDeliveryBoyViewModel
@{
    ViewData["Title"] = $"Reactivate Staff: {Model.FullName}";
    ViewData["ActiveMenu"] = "DeliveryBoy";
}

<div class="container-fluid px-4 py-3">
    <!-- Breadcrumb & Header -->
    <div class="row align-items-center mb-3">
        <div class="col-md-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-controller="DeliveryBoy" asp-action="Index" class="text-decoration-none">Delivery Boys</a></li>
                    <li class="breadcrumb-item"><a asp-controller="DeliveryBoy" asp-action="Details" asp-route-id="@Model.DeliveryBoyId" class="text-decoration-none">@Model.FullName</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Reactivate</li>
                </ol>
            </nav>
            <h3 class="mb-0 fw-bold text-success">
                <i class="bi bi-person-check-fill me-2"></i>Reactivate Delivery Boy Account
            </h3>
            <p class="text-muted small mb-0">Restore login access and dispatch eligibility for @Model.FullName.</p>
        </div>
        <div class="col-md-4 text-md-end mt-2 mt-md-0">
            <a asp-controller="DeliveryBoy" asp-action="Details" asp-route-id="@Model.DeliveryBoyId" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Profile
            </a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <h6 class="alert-heading fw-bold mb-1"><i class="bi bi-x-circle-fill me-2"></i>Please correct the following:</h6>
            <div asp-validation-summary="All" class="text-danger small mb-0"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-success text-white py-3">
                    <h6 class="card-title mb-0 fw-bold">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Account Reactivation Confirmation
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info border-info d-flex align-items-start mb-4">
                        <i class="bi bi-info-circle-fill fs-4 text-info me-3 flex-shrink-0"></i>
                        <div class="small">
                            <strong class="d-block mb-1 text-dark">Reactivation Effects:</strong>
                            <ul class="mb-0 ps-3">
                                <li>Staff mobile app and web portal login credentials will be restored.</li>
                                <li>The delivery agent becomes immediately eligible for route and customer assignments.</li>
                                <li>Runsheet generation and delivery logging can resume immediately.</li>
                            </ul>
                        </div>
                    </div>

                    <form asp-controller="DeliveryBoy" asp-action="Reactivate" method="post" id="reactivateDeliveryBoyForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="DeliveryBoyId" />
                        <input type="hidden" asp-for="FullName" />
                        <input type="hidden" asp-for="CompensationType" />

                        <div class="p-3 bg-light rounded-3 border mb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-muted small">Staff Member:</div>
                                    <strong class="fs-5 text-dark">@Model.FullName</strong>
                                </div>
                                <span class="badge @(Model.CompensationType == "Commission" ? "bg-success" : "bg-primary") px-3 py-2">
                                    @Model.CompensationType
                                </span>
                            </div>
                        </div>

                        @if (Model.CompensationType == "Commission")
                        {
                            <div class="mb-4">
                                <label asp-for="NewCommissionRate" class="form-label fw-semibold">
                                    Approved Commission Rate (₹ per Litre) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">₹</span>
                                    <input asp-for="NewCommissionRate" class="form-control" type="number" step="0.01" min="0.01" max="100.00" placeholder="e.g. 2.50" required />
                                    <span class="input-group-text bg-light">/ Litre</span>
                                </div>
                                <span asp-validation-for="NewCommissionRate" class="text-danger small"></span>
                                <div class="form-text small text-muted">
                                    Per solution architecture, reactivating a commission employee creates an active commission tier effective today.
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-light border small text-muted mb-4">
                                <i class="bi bi-cash-stack text-success me-1"></i>
                                Fixed Salary employees resume at their existing contractual monthly base salary. You can adjust the base salary from the Edit Profile screen at any time.
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-controller="DeliveryBoy" asp-action="Details" asp-route-id="@Model.DeliveryBoyId" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-success px-4 fw-semibold shadow-sm">
                                <i class="bi bi-check-circle-fill me-1"></i> Confirm Reactivation
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
