                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Reason for Deactivation <span class="text-danger">*</span></label>
                        <textarea name="Reason" class="form-control" rows="3" placeholder="Reason..." required></textarea>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="ConfirmDeliveryLogged" value="true" id="chkDetailsConfirmDelivery" />
                        <label class="form-check-label small text-muted" for="chkDetailsConfirmDelivery">
                            I confirm deactivation will terminate active delivery subscriptions.
                        </label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm px-4">Deactivate</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: REACTIVATE CUSTOMER                                                -->
<!-- ========================================================================= -->
<div class="modal fade" id="reactivateModal" tabindex="-1" aria-labelledby="reactivateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="Reactivate" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CustomerId" value="@Model.Customer.CustomerId" />
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold" id="reactivateModalLabel">Reactivate Customer</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Reactivation Date <span class="text-danger">*</span></label>
                        <input type="date" name="ReactivationDate" class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Delivery Route <span class="text-danger">*</span></label>
                        <select name="NewRouteId" class="form-select" required>
                            @foreach (var r in routes)
                            {
                                <option value="@r.RouteId" selected="@(Model.Customer.RouteId == r.RouteId)">@r.RouteCode - @r.RouteName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Delivery Sequence <span class="text-danger">*</span></label>
                        <input type="number" name="NewSequence" class="form-control" value="@Model.Customer.DeliverySequence" min="1" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Delivery Agent <span class="text-danger">*</span></label>
                        <select name="NewDeliveryBoyId" class="form-select" required>
                            @foreach (var db in deliveryBoys)
                            {
                                <option value="@db.DeliveryBoyId" selected="@(Model.Customer.CurrentDeliveryBoyId == db.DeliveryBoyId)">@db.FullName (@db.Phone)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm px-4 text-white">Reactivate</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: REQUEST VACATION                                                   -->
<!-- ========================================================================= -->
<div class="modal fade" id="requestVacationModal" tabindex="-1" aria-labelledby="reqVacModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="RequestVacation" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CustomerId" value="@Model.Customer.CustomerId" />
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold text-dark" id="reqVacModalLabel">
                        <i class="cil-beach-access text-warning me-2"></i> Record Customer Vacation
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Start Date <span class="text-danger">*</span></label>
                            <input type="date" name="StartDate" class="form-control"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">End Date <span class="text-danger">*</span></label>
                            <input type="date" name="EndDate" class="form-control"
                                   value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Applicable Shifts <span class="text-danger">*</span></label>
                        <select name="Shift" class="form-select" required>
                            <option value="Both">Both Morning &amp; Evening Shifts</option>
                            <option value="Morning">Morning Shift Only</option>
                            <option value="Evening">Evening Shift Only</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Reason for Absence</label>
                        <textarea name="Reason" class="form-control" rows="2" placeholder="e.g. Out of town, family trip..."></textarea>
                    </div>
                    <div class="alert alert-info small py-2 mb-0">
                        <i class="cil-info me-1"></i> Admin vacation entries are automatically approved. Deliveries for the selected shifts will be locked.
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-admin-primary btn-sm px-4">
                        <i class="cil-check me-1"></i> Approve &amp; Lock Deliveries
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: REJECT VACATION                                                    -->
<!-- ========================================================================= -->
<div class="modal fade" id="rejectVacationModal" tabindex="-1" aria-labelledby="rejVacModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="RejectVacation" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="customerId" value="@Model.Customer.CustomerId" />
                <input type="hidden" name="vacationId" id="rejectVacationId" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="rejVacModalLabel">Reject Vacation Request</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Reason for Rejection <span class="text-danger">*</span></label>
                        <textarea name="rejectionReason" class="form-control" rows="3" placeholder="Provide reason for rejecting request..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm px-4">Reject Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: RESUME EARLY VACATION                                              -->
<!-- ========================================================================= -->
<div class="modal fade" id="resumeEarlyModal" tabindex="-1" aria-labelledby="resumeEarlyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="ResumeEarlyVacation" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="customerId" value="@Model.Customer.CustomerId" />
                <input type="hidden" name="vacationId" id="resumeVacationId" />
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold text-dark" id="resumeEarlyModalLabel">
                        <i class="cil-media-play text-primary me-2"></i> Early Vacation Resumption
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">
                        Deliveries will resume early starting on the selected date. Subsequent locked shifts will be restored to daily runsheets.
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Delivery Resumption Date <span class="text-danger">*</span></label>
                        <input type="date" name="resumedDate" id="resumeEarlyDate" class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-admin-primary btn-sm px-4">Confirm Resumption</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Modal Schedule update day synchronization
        const schedSelect = document.getElementById("schedSelect");
        if (schedSelect) {
            schedSelect.addEventListener("change", function () {
                syncModalScheduleDays(this.value);
            });
        }

        const modalCheckboxes = document.querySelectorAll(".modal-chk-day");
        modalCheckboxes.forEach(chk => {
            chk.addEventListener("change", function () {
                updateModalSerializedDays();
            });
        });

        // Reassign & Deactivate date change listeners for delivery check
        const reassignDate = document.getElementById("reassignEffectiveDate");
        if (reassignDate) {
            reassignDate.addEventListener("change", checkReassignDelivery);
        }

        const deactivateDate = document.getElementById("deactivateDate");
        if (deactivateDate) {
            deactivateDate.addEventListener("change", checkDeactivateDelivery);
        }
    });

    function openUpdateScheduleModal(subscriptionId, categoryName, currentSchedule, currentDays) {
        document.getElementById("schedSubscriptionId").value = subscriptionId;
        document.getElementById("schedCategoryName").innerText = categoryName;
        document.getElementById("schedSelect").value = currentSchedule;

        syncModalScheduleDays(currentSchedule, currentDays);

        const modal = new coreui.Modal(document.getElementById("updateScheduleModal"));
        modal.show();
    }

    function syncModalScheduleDays(schedule, explicitDays) {
        const checkboxes = document.querySelectorAll(".modal-chk-day");
        const days = explicitDays ? explicitDays.split(",").map(d => parseInt(d.trim(), 10)) : [];

        checkboxes.forEach(chk => {
            const val = parseInt(chk.value, 10);
            if (schedule === "Daily") {
                chk.checked = true;
                chk.disabled = true;
            } else if (schedule === "Weekdays") {
                chk.checked = val >= 1 && val <= 5;
                chk.disabled = true;
            } else if (schedule === "Weekends") {
                chk.checked = val === 6 || val === 7;
                chk.disabled = true;
            } else if (schedule === "CustomDays") {
                chk.disabled = false;
                if (days.length > 0) {
                    chk.checked = days.includes(val);
                }
            }
        });

        updateModalSerializedDays();
    }

    function updateModalSerializedDays() {
        const checked = document.querySelectorAll(".modal-chk-day:checked");
        const vals = Array.from(checked).map(c => c.value).sort((a,b) => a - b);
        document.getElementById("modalSchedSerializedDays").value = vals.join(",");
    }

    function openAddSubscriptionModal() {
        const modal = new coreui.Modal(document.getElementById("addSubscriptionModal"));
        modal.show();
    }

    function openEndSubscriptionModal(subId, catName) {
        document.getElementById("endSubId").value = subId;
        document.getElementById("endSubCategoryName").innerText = catName;
        const modal = new coreui.Modal(document.getElementById("endSubscriptionModal"));
        modal.show();
    }

    function openSetCustomPriceModal() {
        const modal = new coreui.Modal(document.getElementById("setCustomPriceModal"));
        modal.show();
    }

    function openEndCustomPriceModal(pricingId, catName) {
        document.getElementById("endPricingId").value = pricingId;
        document.getElementById("endPricingCategoryName").innerText = catName;
        const modal = new coreui.Modal(document.getElementById("endCustomPriceModal"));
        modal.show();
    }

    function openReassignModal() {
        const modal = new coreui.Modal(document.getElementById("reassignModal"));
        modal.show();
        checkReassignDelivery();
    }

    function checkReassignDelivery() {
        const custId = @Model.Customer.CustomerId;
        const dt = document.getElementById("reassignEffectiveDate")?.value;
        const warning = document.getElementById("reassignDeliveryWarning");
        if (!dt || !warning) return;

        fetch(`/Customer/CheckDeliveryOnDate?customerId=${custId}&date=${dt}`)
            .then(res => res.json())
            .then(data => {
                if (data.hasDelivery) warning.classList.remove("d-none");
                else warning.classList.add("d-none");
            })
            .catch(() => warning.classList.add("d-none"));
    }

    function openDeactivateModal() {
        const modal = new coreui.Modal(document.getElementById("deactivateModal"));
        modal.show();
        checkDeactivateDelivery();
    }

    function checkDeactivateDelivery() {
        const custId = @Model.Customer.CustomerId;
        const dt = document.getElementById("deactivateDate")?.value;
        const warning = document.getElementById("deactivateDeliveryWarning");
        if (!dt || !warning) return;

        fetch(`/Customer/CheckDeliveryOnDate?customerId=${custId}&date=${dt}`)
            .then(res => res.json())
            .then(data => {
                if (data.hasDelivery) warning.classList.remove("d-none");
                else warning.classList.add("d-none");
            })
            .catch(() => warning.classList.add("d-none"));
    }

    function openReactivateModal() {
        const modal = new coreui.Modal(document.getElementById("reactivateModal"));
        modal.show();
    }

    function openRequestVacationModal() {
        const modal = new coreui.Modal(document.getElementById("requestVacationModal"));
        modal.show();
    }

    function openRejectVacationModal(vacationId) {
        document.getElementById("rejectVacationId").value = vacationId;
        const modal = new coreui.Modal(document.getElementById("rejectVacationModal"));
        modal.show();
    }

    function openResumeEarlyModal(vacationId, start, end) {
        document.getElementById("resumeVacationId").value = vacationId;
        const resumeInput = document.getElementById("resumeEarlyDate");
        if (resumeInput) {
            resumeInput.min = start;
            resumeInput.max = end;
        }
        const modal = new coreui.Modal(document.getElementById("resumeEarlyModal"));
        modal.show();
    }
</script>
}
