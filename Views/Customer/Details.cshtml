@model Dairy_Management_System.Models.Customer.CustomerDetailsViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = $"Customer Profile — {Model.Customer.CustomerCode}";
    ViewData["ActiveMenu"] = "Customers";

    var routes = ViewBag.Routes as List<Dairy_Management_System.Models.Customer.RouteLookupItem> ?? new();
    var deliveryBoys = ViewBag.DeliveryBoys as List<Dairy_Management_System.Models.Customer.DeliveryBoyLookupItem> ?? new();
    var categories = ViewBag.MilkCategories as List<Dairy_Management_System.Models.Customer.MilkCategoryLookupItem> ?? new();
}

<!-- Top Navigation & Action Header -->
<div class="card border-0 bg-white shadow-sm mb-4">
    <div class="card-body py-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index" class="text-decoration-none text-muted small">
                    <i class="cil-chevron-left me-1"></i> Customer Directory
                </a>
                <span class="text-muted small">&bull;</span>
                <span class="badge bg-light text-secondary border font-tabular">@Model.Customer.CustomerCode</span>
                @if (Model.Customer.Status == "Active")
                {
                    <span class="badge-status badge-active">Active</span>
                }
                else
                {
                    <span class="badge-status badge-inactive">Inactive</span>
                }
                @if (Model.IsOnVacationToday)
                {
                    <span class="badge-vacation-indicator text-warning bg-warning-subtle border-warning-subtle">
                        <i class="cil-beach-access me-1"></i> Vacation Active Today
                    </span>
                }
            </div>
            <h4 class="fw-bold text-dark mb-0">
                @Model.Customer.FullName
                @if (!string.IsNullOrWhiteSpace(Model.Customer.FullNameGujarati))
                {
                    <span class="text-muted fw-normal fs-5 ms-1">(@Model.Customer.FullNameGujarati)</span>
                }
            </h4>
            <div class="text-muted small mt-1">
                <i class="cil-location-pin me-1"></i>@(Model.Customer.Area ?? "No area specified") &bull; Route: <strong>@Model.RouteName</strong> &bull; Sequence: <strong>#@Model.Customer.DeliverySequence</strong>
            </div>
        </div>

        <!-- Quick Action Bar -->
        <div class="d-flex flex-wrap align-items-center gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Customer.CustomerId" class="btn btn-outline-secondary btn-sm">
                <i class="cil-pencil me-1"></i> Edit Demographics
            </a>
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="openReassignModal()">
                <i class="cil-bike me-1"></i> Reassign Agent
            </button>
            <button type="button" class="btn btn-outline-warning btn-sm" onclick="openRequestVacationModal()">
                <i class="cil-beach-access me-1"></i> Record Vacation
            </button>
            @if (Model.Customer.Status == "Active")
            {
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="openDeactivateModal()">
                    <i class="cil-user-x me-1"></i> Deactivate
                </button>
            }
            else
            {
                <button type="button" class="btn btn-outline-success btn-sm" onclick="openReactivateModal()">
                    <i class="cil-reload me-1"></i> Reactivate
                </button>
            }
        </div>
    </div>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-success-subtle shadow-sm mb-4" role="alert">
        <div class="d-flex align-items-center gap-2">
            <i class="cil-check-circle fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-danger-subtle shadow-sm mb-4" role="alert">
        <div class="d-flex align-items-center gap-2">
            <i class="cil-warning fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Profile Overview Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card-stat p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="stat-label">Assigned Delivery Agent</span>
                <div class="stat-icon" style="background-color: #ecfdf5; color: #059669;">
                    <i class="cil-bike"></i>
                </div>
            </div>
            <div class="stat-value fs-5">
                @(Model.DeliveryBoyName ?? "Unassigned")
            </div>
            <div class="stat-subtitle text-muted small">
                @if (!string.IsNullOrWhiteSpace(Model.DeliveryBoyPhone))
                {
                    <a href="tel:@Model.DeliveryBoyPhone" class="text-decoration-none text-dark font-tabular">
                        <i class="cil-phone text-success me-1"></i>@Model.DeliveryBoyPhone
                    </a>
                }
                else
                {
                    <span>No agent assigned</span>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card-stat p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="stat-label">Daily Liquid Volume</span>
                <div class="stat-icon" style="background-color: #eff6ff; color: #2563eb;">
                    <i class="cil-drop"></i>
                </div>
            </div>
            <div class="stat-value font-tabular">
                @Model.TotalDailyVolumeLitres <span class="fs-6 fw-normal text-muted">L/day</span>
            </div>
            <div class="stat-subtitle text-muted small">
                M: @Model.TotalDailyMorningLitres L &bull; E: @Model.TotalDailyEveningLitres L
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card-stat p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="stat-label">Active Subscriptions</span>
                <div class="stat-icon" style="background-color: #f1f5f9; color: #475569;">
                    <i class="cil-calendar"></i>
                </div>
            </div>
            <div class="stat-value font-tabular">
                @Model.ActiveSubscriptions.Count(s => s.IsActive)
            </div>
            <div class="stat-subtitle text-muted small">
                @Model.CustomPrices.Count(p => p.IsActive) custom price agreement(s)
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card-stat p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="stat-label">Account Balance</span>
                <div class="stat-icon" style="background-color: #fefce8; color: #ca8a04;">
                    <i class="cil-credit-card"></i>
                </div>
            </div>
            <div class="stat-value font-tabular">
                ₹@Model.OutstandingAccountBalance.ToString("N2")
            </div>
            <div class="stat-subtitle text-muted small">Current ledger balance</div>
        </div>
    </div>
</div>

<!-- Tabbed Navigation Interface -->
<div class="card card-dms shadow-sm">
    <div class="card-header bg-white border-bottom-0 pb-0 pt-3">
        <ul class="nav nav-tabs card-header-tabs" id="customerTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-semibold" id="tab-overview-btn" data-coreui-toggle="tab" data-coreui-target="#tab-overview" type="button" role="tab" aria-selected="true">
                    <i class="cil-user me-1 text-primary"></i> Demographic &amp; Routing
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="tab-subscriptions-btn" data-coreui-toggle="tab" data-coreui-target="#tab-subscriptions" type="button" role="tab" aria-selected="false">
                    <i class="cil-drop me-1 text-success"></i> Subscriptions &amp; Pricing
                    <span class="badge bg-success-subtle text-success ms-1 font-tabular">@Model.ActiveSubscriptions.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="tab-history-btn" data-coreui-toggle="tab" data-coreui-target="#tab-history" type="button" role="tab" aria-selected="false">
                    <i class="cil-bike me-1 text-info"></i> Agent Assignment History
                    <span class="badge bg-secondary-subtle text-secondary ms-1 font-tabular">@Model.AssignmentHistory.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="tab-vacation-btn" data-coreui-toggle="tab" data-coreui-target="#tab-vacation" type="button" role="tab" aria-selected="false">
                    <i class="cil-beach-access me-1 text-warning"></i> Vacation Management
                    <span class="badge bg-warning-subtle text-warning ms-1 font-tabular">@Model.RecentVacations.Count</span>
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body p-4">
        <div class="tab-content" id="customerTabContent">

            <!-- ========================================================================= -->
            <!-- TAB 1: DEMOGRAPHIC & ROUTING OVERVIEW                                     -->
            <!-- ========================================================================= -->
            <div class="tab-pane fade show active" id="tab-overview" role="tabpanel">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="card border-0 bg-light p-3 h-100 rounded-3">
                            <h6 class="fw-bold text-dark mb-3">
                                <i class="cil-contact me-1 text-primary"></i> Customer Contact Information
                            </h6>
                            <table class="table table-sm table-borderless mb-0">
                                <tr>
                                    <td class="text-muted py-1" style="width: 140px;">Customer Code:</td>
                                    <td class="fw-bold font-tabular py-1 text-primary">@Model.Customer.CustomerCode</td>
                                </tr>
                                <tr>
                                    <td class="text-muted py-1">Full Name:</td>
                                    <td class="fw-semibold py-1">@Model.Customer.FullName</td>
                                </tr>
                                <tr>
                                    <td class="text-muted py-1">Gujarati Name:</td>
                                    <td class="py-1">@(Model.Customer.FullNameGujarati ?? "—")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted py-1">Primary Phone:</td>
                                    <td class="py-1">
                                        <a href="tel:@Model.Customer.Phone" class="text-dark font-tabular text-decoration-none">
                                            <i class="cil-phone text-success me-1"></i>@Model.Customer.Phone
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted py-1">Alternate Phone:</td>
                                    <td class="py-1 font-tabular">@(Model.Customer.AlternatePhone ?? "—")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted py-1">Delivery Address:</td>
                                    <td class="py-1">@Model.Customer.Address</td>
                                </tr>
                                <tr>
                                    <td class="text-muted py-1">Area / Locality:</td>
                                    <td class="py-1">@(Model.Customer.Area ?? "—")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted py-1">Landmark:</td>
                                    <td class="py-1">@(Model.Customer.Landmark ?? "—")</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card border-0 bg-light p-3 h-100 rounded-3">
                            <h6 class="fw-bold text-dark mb-3">
                                <i class="cil-map me-1 text-success"></i> Delivery Logistics &amp; Account Audit
                            </h6>
                            <table class="table table-sm table-borderless mb-0">
                                <tr>
                                    <td class="text-muted py-1" style="width: 140px;">Route:</td>
                                    <td class="fw-semibold py-1">@Model.RouteName</td>
                                </tr>
                                <tr>
                                    <td class="text-muted py-1">Assigned Agent:</td>
                                    <td class="py-1">
                                        @if (!string.IsNullOrWhiteSpace(Model.DeliveryBoyName))
                                        {
                                            <span class="badge bg-white text-dark border">@Model.DeliveryBoyName</span>
                                        }
                                        else
                                        {
                                            <span class="text-warning">Unassigned</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted py-1">Delivery Sequence:</td>
                                    <td class="py-1 font-tabular">#@Model.Customer.DeliverySequence</td>
                                </tr>
                                <tr>
                                    <td class="text-muted py-1">Preferred Shift:</td>
                                    <td class="py-1"><span class="badge bg-light text-secondary border">@Model.Customer.PreferredShift</span></td>
                                </tr>
                                <tr>
                                    <td class="text-muted py-1">Service Start Date:</td>
                                    <td class="py-1 font-tabular">@Model.Customer.DeliveryStartDate.ToString("MMM dd, yyyy")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted py-1">Account Created:</td>
                                    <td class="py-1 font-tabular">@Model.Customer.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted py-1">Internal Notes:</td>
                                    <td class="py-1 text-secondary small">@(string.IsNullOrWhiteSpace(Model.Customer.Notes) ? "No notes recorded." : Model.Customer.Notes)</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- TAB 2: SUBSCRIPTIONS & CUSTOM PRICING                                     -->
            <!-- ========================================================================= -->
            <div class="tab-pane fade" id="tab-subscriptions" role="tabpanel">
                <!-- Section A: Active Subscriptions -->
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Product Subscriptions</h6>
                        <span class="text-muted small">Multi-category recurring orders with atomic schedule transitions.</span>
                    </div>
                    <button type="button" class="btn btn-admin-primary btn-sm" onclick="openAddSubscriptionModal()">
                        <i class="cil-plus me-1"></i> Add Product Subscription
                    </button>
                </div>

                <div class="table-responsive mb-4">
                    <table class="table table-hover table-dms align-middle border">
                        <thead class="bg-light">
                            <tr>
                                <th>Category</th>
                                <th>Shift</th>
                                <th class="text-end">Daily Litres</th>
                                <th>Schedule</th>
                                <th>Active Delivery Days</th>
                                <th>Effective Period</th>
                                <th class="text-center">Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ActiveSubscriptions.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        No active subscriptions configured. Click "Add Product Subscription" to configure milk deliveries.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var sub in Model.ActiveSubscriptions)
                                {
                                    <tr>
                                        <td class="fw-semibold text-dark">
                                            <i class="cil-drop text-success me-1"></i>@sub.CategoryName
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-secondary border">@sub.Shift</span>
                                        </td>
                                        <td class="text-end font-tabular fw-bold text-dark">
                                            @sub.DailyLiquidVolumeLitres.ToString("N2") L
                                        </td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                @sub.DeliverySchedule
                                            </span>
                                        </td>
                                        <td>
                                            @{
                                                var dayNums = (sub.DeliveryDays ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList();
                                                var dayLabels = new Dictionary<string, string> {
                                                    {"1", "Mon"}, {"2", "Tue"}, {"3", "Wed"}, {"4", "Thu"}, {"5", "Fri"}, {"6", "Sat"}, {"7", "Sun"}
                                                };
                                            }
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var kvp in dayLabels)
                                                {
                                                    if (dayNums.Contains(kvp.Key))
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-1 py-0 small">@kvp.Value</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-muted border px-1 py-0 small text-decoration-line-through">@kvp.Value</span>
                                                    }
                                                }
                                            </div>
                                        </td>
                                        <td class="small font-tabular">
                                            <div>From: @sub.EffectiveFrom.ToString("MMM dd, yyyy")</div>
                                            @if (sub.EffectiveTo.HasValue)
                                            {
                                                <div class="text-muted">To: @sub.EffectiveTo.Value.ToString("MMM dd, yyyy")</div>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (sub.IsActive)
                                            {
                                                <span class="badge-status badge-active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status badge-inactive">Ended</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (sub.IsActive)
                                            {
                                                <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2"
                                                        onclick="openUpdateScheduleModal(@sub.SubscriptionId, '@sub.CategoryName', '@sub.DeliverySchedule', '@sub.DeliveryDays')">
                                                    <i class="cil-sync me-1"></i> Update Schedule
                                                </button>
                                                <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2"
                                                        onclick="openEndSubscriptionModal(@sub.SubscriptionId, '@sub.CategoryName')">
                                                    <i class="cil-x me-1"></i> End
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">&mdash;</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Section B: Custom Pricing Agreements -->
                <div class="d-flex align-items-center justify-content-between mb-3 mt-4 pt-3 border-top">
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Custom Pricing Agreements</h6>
                        <span class="text-muted small">Agreed overrides to default category retail price for this customer.</span>
                    </div>
                    <button type="button" class="btn btn-outline-success btn-sm" onclick="openSetCustomPriceModal()">
                        <i class="cil-tag me-1"></i> Set Custom Price
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-dms align-middle border">
                        <thead class="bg-light">
                            <tr>
                                <th>Category</th>
                                <th class="text-end">Default Retail (₹/L)</th>
                                <th class="text-end">Agreed Price (₹/L)</th>
                                <th class="text-end">Difference</th>
                                <th>Effective Period</th>
                                <th class="text-center">Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.CustomPrices.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        No custom prices set. Standard retail prices apply for all categories.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var price in Model.CustomPrices)
                                {
                                    var diff = price.CustomPrice - price.StandardDefaultPrice;
                                    <tr>
                                        <td class="fw-semibold text-dark">@price.CategoryName</td>
                                        <td class="text-end font-tabular text-muted">₹@price.StandardDefaultPrice.ToString("N2")</td>
                                        <td class="text-end font-tabular fw-bold text-success">₹@price.CustomPrice.ToString("N2")</td>
                                        <td class="text-end font-tabular">
                                            @if (diff < 0)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    Discount: -₹@Math.Abs(diff).ToString("N2")
                                                </span>
                                            }
                                            else if (diff > 0)
                                            {
                                                <span class="badge bg-info-subtle text-info border border-info-subtle">
                                                    Premium: +₹@diff.ToString("N2")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Same as default</span>
                                            }
                                        </td>
                                        <td class="small font-tabular">
                                            <div>From: @price.EffectiveFrom.ToString("MMM dd, yyyy")</div>
                                            @if (price.EffectiveTo.HasValue)
                                            {
                                                <div class="text-muted">To: @price.EffectiveTo.Value.ToString("MMM dd, yyyy")</div>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (price.IsActive)
                                            {
                                                <span class="badge-status badge-active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status badge-inactive">Ended</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (price.IsActive)
                                            {
                                                <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2"
                                                        onclick="openEndCustomPriceModal(@price.PricingId, '@price.CategoryName')">
                                                    <i class="cil-x me-1"></i> End Agreement
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">&mdash;</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- TAB 3: AGENT ASSIGNMENT HISTORY                                           -->
            <!-- ========================================================================= -->
            <div class="tab-pane fade" id="tab-history" role="tabpanel">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Delivery Boy Assignment Audit History</h6>
                        <span class="text-muted small">Full historical traceability of route delivery agent assignments.</span>
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="openReassignModal()">
                        <i class="cil-bike me-1"></i> Reassign Delivery Boy
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-dms align-middle border">
                        <thead class="bg-light">
                            <tr>
                                <th>Assignment ID</th>
                                <th>Delivery Boy</th>
                                <th>Assigned From</th>
                                <th>Assigned To</th>
                                <th>Reason / Notes</th>
                                <th class="text-center">Status</th>
                                <th class="text-end">Recorded On</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AssignmentHistory.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        No assignment history recorded.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var h in Model.AssignmentHistory)
                                {
                                    <tr>
                                        <td class="font-tabular fw-medium">#@h.AssignmentId</td>
                                        <td class="fw-semibold text-dark">
                                            <i class="cil-bike text-primary me-1"></i>@h.DeliveryBoyName
                                        </td>
                                        <td class="font-tabular">@h.AssignedFrom.ToString("MMM dd, yyyy")</td>
                                        <td class="font-tabular">
                                            @(h.AssignedTo.HasValue ? h.AssignedTo.Value.ToString("MMM dd, yyyy") : "Current")
                                        </td>
                                        <td class="small text-muted">@(h.Notes ?? "—")</td>
                                        <td class="text-center">
                                            @if (h.IsActive)
                                            {
                                                <span class="badge-status badge-active">Current Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status badge-inactive">Archived</span>
                                            }
                                        </td>
                                        <td class="text-end small font-tabular text-muted">
                                            @h.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- TAB 4: VACATION MANAGEMENT & SHIFT LOCKOUTS                               -->
            <!-- ========================================================================= -->
            <div class="tab-pane fade" id="tab-vacation" role="tabpanel">
                <!-- Shift Lockout Notice -->
                <div class="alert alert-info border-info-subtle shadow-sm mb-4">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="cil-beach-access fs-5 text-primary"></i>
                        <h6 class="fw-bold mb-0">Shift Exclusion &amp; Lockout Invariants</h6>
                    </div>
                    <div class="small text-muted">
                        Approved vacations automatically lock morning and/or evening shifts for this customer.
                        During locked periods, daily delivery runsheets exclude customer stops to prevent accidental deliveries and false billing entries.
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Vacation Absence Logs</h6>
                        <span class="text-muted small">Pending and approved vacation requests with shift boundaries and early resumption.</span>
                    </div>
                    <button type="button" class="btn btn-admin-primary btn-sm" onclick="openRequestVacationModal()">
                        <i class="cil-plus me-1"></i> Record Vacation Request
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-dms align-middle border">
                        <thead class="bg-light">
                            <tr>
                                <th>ID</th>
                                <th>Date Range</th>
                                <th>Shift</th>
                                <th>Reason</th>
                                <th>Approval &amp; Audit</th>
                                <th class="text-center">Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentVacations.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        No vacations recorded for this customer.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var vac in Model.RecentVacations)
                                {
                                    <tr>
                                        <td class="font-tabular fw-bold text-secondary">#@vac.VacationId</td>
                                        <td class="font-tabular">
                                            <div class="fw-semibold text-dark">
                                                @vac.StartDate.ToString("MMM dd, yyyy") &rarr; @vac.EndDate.ToString("MMM dd, yyyy")
                                            </div>
                                            @if (vac.ResumedDate.HasValue)
                                            {
                                                <div class="text-success small">
                                                    <i class="cil-check me-1"></i>Resumed Early: @vac.ResumedDate.Value.ToString("MMM dd, yyyy")
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-secondary border">@vac.Shift</span>
                                        </td>
                                        <td class="small text-muted">@(vac.Reason ?? "—")</td>
                                        <td class="small font-tabular">
                                            @if (!string.IsNullOrWhiteSpace(vac.ApprovedByName))
                                            {
                                                <div>Approved By: <strong>@vac.ApprovedByName</strong></div>
                                                <div class="text-muted">@(vac.ApprovedAt.HasValue ? vac.ApprovedAt.Value.ToString("MMM dd, yyyy") : "")</div>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(vac.RejectionReason))
                                            {
                                                <div class="text-danger">Reason: @vac.RejectionReason</div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Awaiting action</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (vac.Status == "Approved")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Approved</span>
                                            }
                                            else if (vac.Status == "Pending")
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">Pending</span>
                                            }
                                            else if (vac.Status == "Rejected")
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Rejected</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">@vac.Status</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (vac.Status == "Pending")
                                            {
                                                <form asp-action="ApproveVacation" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="vacationId" value="@vac.VacationId" />
                                                    <input type="hidden" name="customerId" value="@Model.Customer.CustomerId" />
                                                    <button type="submit" class="btn btn-outline-success btn-sm py-0 px-2" title="Approve vacation and lock shifts">
                                                        <i class="cil-check"></i> Approve
                                                    </button>
                                                </form>
                                                <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2"
                                                        onclick="openRejectVacationModal(@vac.VacationId)">
                                                    <i class="cil-x"></i> Reject
                                                </button>
                                            }
                                            else if (vac.Status == "Approved" && !vac.ResumedDate.HasValue && vac.EndDate >= DateOnly.FromDateTime(DateTime.Today))
                                            {
                                                <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2"
                                                        onclick="openResumeEarlyModal(@vac.VacationId, '@vac.StartDate.ToString("yyyy-MM-dd")', '@vac.EndDate.ToString("yyyy-MM-dd")')">
                                                    <i class="cil-media-play me-1"></i> Resume Early
                                                </button>
                                                <form asp-action="CancelVacation" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="vacationId" value="@vac.VacationId" />
                                                    <input type="hidden" name="customerId" value="@Model.Customer.CustomerId" />
                                                    <button type="submit" class="btn btn-outline-secondary btn-sm py-0 px-2"
                                                            onclick="return confirm('Cancel this approved vacation? Delivery shifts will be immediately restored.');">
                                                        <i class="cil-x"></i> Cancel
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">&mdash;</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

