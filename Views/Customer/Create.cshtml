@model Dairy_Management_System.Models.Customer.CreateCustomerViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Add New Customer";
    ViewData["ActiveMenu"] = "Customers";
    var routes = ViewBag.Routes as List<Dairy_Management_System.Models.Customer.RouteLookupItem> ?? new();
    var deliveryBoys = ViewBag.DeliveryBoys as List<Dairy_Management_System.Models.Customer.DeliveryBoyLookupItem> ?? new();
    var categories = ViewBag.MilkCategories as List<Dairy_Management_System.Models.Customer.MilkCategoryLookupItem> ?? new();
}

<!-- Page Header & Breadcrumb -->
<div class="card border-0 bg-white shadow-sm mb-4">
    <div class="card-body py-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Index" class="text-decoration-none text-muted small">
                    <i class="cil-chevron-left me-1"></i> Customers Directory
                </a>
                <span class="text-muted small">&bull;</span>
                <span class="badge bg-success-subtle text-success border border-success-subtle">Onboarding</span>
            </div>
            <h4 class="fw-bold text-dark mb-0">Register New Customer</h4>
            <p class="text-muted small mb-0 mt-1">
                Enter demographic details, assign delivery logistics, and configure initial multi-category subscriptions.
            </p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                <i class="cil-x me-1"></i> Cancel
            </a>
        </div>
    </div>
</div>

<!-- Validation Error Alert -->
@if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger border-danger-subtle shadow-sm mb-4" role="alert">
        <div class="d-flex align-items-center gap-2 mb-2">
            <i class="cil-warning fs-5 text-danger"></i>
            <h6 class="fw-bold mb-0">Please resolve the following registration issues:</h6>
        </div>
        <div asp-validation-summary="All" class="text-danger small mb-0 ps-3"></div>
    </div>
}

<form asp-action="Create" method="post" id="createCustomerForm">
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <!-- LEFT COLUMN: Demographics & Logistics -->
        <div class="col-lg-7">
            <!-- SECTION 1: Personal & Demographic Information -->
            <div class="card card-dms shadow-sm mb-4">
                <div class="card-header bg-light">
                    <div class="d-flex align-items-center gap-2">
                        <i class="cil-user text-success"></i>
                        <span class="fw-semibold">1. Demographic Information</span>
                    </div>
                    <span class="badge bg-secondary-subtle text-secondary small">Required</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label small fw-semibold">
                                Full Name (English) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Ramesh Patel" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FullNameGujarati" class="form-label small fw-semibold">
                                Full Name (Gujarati) <span class="text-muted small">(Optional)</span>
                            </label>
                            <input asp-for="FullNameGujarati" class="form-control" placeholder="e.g. રમેશ પટેલ" />
                            <span asp-validation-for="FullNameGujarati" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label small fw-semibold">
                                Primary Phone Number <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">+91</span>
                                <input asp-for="Phone" class="form-control border-start-0 font-tabular"
                                       placeholder="9876543210" maxlength="15" required />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                            <div class="form-text small">10-digit mobile number for daily SMS &amp; delivery updates.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AlternatePhone" class="form-label small fw-semibold">
                                Alternate Phone Number <span class="text-muted small">(Optional)</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">+91</span>
                                <input asp-for="AlternatePhone" class="form-control border-start-0 font-tabular"
                                       placeholder="Secondary contact" maxlength="15" />
                            </div>
                            <span asp-validation-for="AlternatePhone" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 2: Delivery & Route Logistics -->
            <div class="card card-dms shadow-sm">
                <div class="card-header bg-light">
                    <div class="d-flex align-items-center gap-2">
                        <i class="cil-map text-primary"></i>
                        <span class="fw-semibold">2. Delivery Logistics &amp; Routing</span>
                    </div>
                    <span class="badge bg-primary-subtle text-primary small">Routing Matrix</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Address" class="form-label small fw-semibold">
                                House / Flat / Society Address <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Address" class="form-control" rows="2"
                                      placeholder="e.g. 102, Shivalik Residency, Opp. City Park" required></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Area" class="form-label small fw-semibold">
                                Area / Locality <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Area" class="form-control" placeholder="e.g. Anand Nagar" required />
                            <span asp-validation-for="Area" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Landmark" class="form-label small fw-semibold">
                                Nearest Landmark <span class="text-muted small">(Optional)</span>
                            </label>
                            <input asp-for="Landmark" class="form-control" placeholder="e.g. Near Water Tank" />
                            <span asp-validation-for="Landmark" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="RouteId" class="form-label small fw-semibold mb-0">
                                    Delivery Route <span class="text-danger">*</span>
                                </label>
                                <button type="button" class="btn btn-link btn-sm p-0 text-success fw-semibold text-decoration-none"
                                        onclick="openQuickAddRouteModal('RouteId', 'code-first')">
                                    <i class="cil-plus"></i> Add New Route
                                </button>
                            </div>
                            <select asp-for="RouteId" class="form-select" required>
                                <option value="">-- Select Route --</option>
                                @foreach (var r in routes)
                                {
                                    <option value="@r.RouteId">@r.RouteCode - @r.RouteName</option>
                                }
                            </select>
                            <span asp-validation-for="RouteId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CurrentDeliveryBoyId" class="form-label small fw-semibold">
                                Assigned Delivery Agent <span class="text-muted small">(Optional)</span>
                            </label>
                            <select asp-for="CurrentDeliveryBoyId" class="form-select">
                                <option value="">-- Assign Later --</option>
                                @foreach (var db in deliveryBoys)
                                {
                                    <option value="@db.DeliveryBoyId">@db.FullName (@db.Phone)</option>
                                }
                            </select>
                            <span asp-validation-for="CurrentDeliveryBoyId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DeliverySequence" class="form-label small fw-semibold">
                                Route Sequence #
                            </label>
                            <input asp-for="DeliverySequence" class="form-control font-tabular" type="number" min="0" value="1" />
                            <span asp-validation-for="DeliverySequence" class="text-danger small"></span>
                            <div class="form-text small">Stop sequence on runsheet.</div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PreferredShift" class="form-label small fw-semibold">
                                Preferred Shift <span class="text-danger">*</span>
                            </label>
                            <select asp-for="PreferredShift" class="form-select" required>
                                <option value="Both">Both (Morning &amp; Evening)</option>
                                <option value="Morning">Morning Shift Only</option>
                                <option value="Evening">Evening Shift Only</option>
                            </select>
                            <span asp-validation-for="PreferredShift" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DeliveryStartDate" class="form-label small fw-semibold">
                                Start Date <span class="text-danger">*</span>
                            </label>
                            <input asp-for="DeliveryStartDate" type="date" class="form-control font-tabular"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="DeliveryStartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label small fw-semibold">
                                Delivery Instructions &amp; Internal Notes
                            </label>
                            <textarea asp-for="Notes" class="form-control" rows="2"
                                      placeholder="e.g. Leave bottle on front door rack, ring bell twice..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Multi-Category Subscriptions Builder -->
        <div class="col-lg-5">
            <div class="card card-dms shadow-sm sticky-top" style="top: 80px; z-index: 5;">
                <div class="card-header bg-light d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="cil-drop text-success"></i>
                        <span class="fw-semibold">3. Initial Milk Subscriptions</span>
                    </div>
                    <button type="button" class="btn btn-outline-success btn-sm" id="btnAddSubscription">
                        <i class="cil-plus me-1"></i> Add Line
                    </button>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Configure initial milk categories, shift quantities, and delivery schedules. Multiple products (e.g. Cow &amp; Buffalo) can be assigned.
                    </p>

                    <!-- Subscriptions Container -->
                    <div id="subscriptionLinesContainer">
                        <!-- Default Line Item 0 -->
                        <div class="card border p-3 mb-3 subscription-line-card bg-light bg-opacity-25" data-index="0">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-secondary-subtle text-secondary subscription-line-badge">Product Line #1</span>
                                <button type="button" class="btn btn-link text-danger p-0 border-0 btn-remove-line" title="Remove line" style="display: none;">
                                    <i class="cil-trash"></i>
                                </button>
                            </div>
                            <div class="row g-2">
                                <div class="col-sm-7">
                                    <label class="form-label small fw-semibold">Product Category <span class="text-danger">*</span></label>
                                    <select name="Subscriptions[0].CategoryId" class="form-select form-select-sm" required>
                                        @foreach (var cat in categories)
                                        {
                                            <option value="@cat.CategoryId">@cat.CategoryName (@cat.CategoryCode) — ₹@cat.DefaultPrice/L</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-sm-5">
                                    <label class="form-label small fw-semibold">Shift <span class="text-danger">*</span></label>
                                    <select name="Subscriptions[0].Shift" class="form-select form-select-sm" required>
                                        <option value="Morning">Morning</option>
                                        <option value="Evening">Evening</option>
                                        <option value="Both">Both Shifts</option>
                                    </select>
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label small fw-semibold">Quantity (Litres) <span class="text-danger">*</span></label>
                                    <input type="number" name="Subscriptions[0].Quantity" class="form-control form-control-sm font-tabular"
                                           step="0.25" min="0.25" max="50" value="1.00" required />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label small fw-semibold">Schedule <span class="text-danger">*</span></label>
                                    <select name="Subscriptions[0].DeliverySchedule" class="form-select form-select-sm select-schedule" data-index="0" required>
                                        <option value="Daily">Daily (All 7 Days)</option>
                                        <option value="Weekdays">Weekdays (Mon-Fri)</option>
                                        <option value="Weekends">Weekends (Sat-Sun)</option>
                                        <option value="CustomDays">Custom Days</option>
                                    </select>
                                </div>

                                <!-- Weekday Checkboxes -->
                                <div class="col-12 mt-2">
                                    <label class="form-label small fw-semibold text-secondary mb-1">Active Days</label>
                                    <div class="d-flex flex-wrap gap-2 days-checkbox-group" data-index="0">
                                        <div class="form-check form-check-inline me-1">
                                            <input class="form-check-input chk-day" type="checkbox" value="1" id="d0_1" checked disabled>
                                            <label class="form-check-label small" for="d0_1">Mon</label>
                                        </div>
                                        <div class="form-check form-check-inline me-1">
                                            <input class="form-check-input chk-day" type="checkbox" value="2" id="d0_2" checked disabled>
                                            <label class="form-check-label small" for="d0_2">Tue</label>
                                        </div>
                                        <div class="form-check form-check-inline me-1">
                                            <input class="form-check-input chk-day" type="checkbox" value="3" id="d0_3" checked disabled>
                                            <label class="form-check-label small" for="d0_3">Wed</label>
                                        </div>
                                        <div class="form-check form-check-inline me-1">
                                            <input class="form-check-input chk-day" type="checkbox" value="4" id="d0_4" checked disabled>
                                            <label class="form-check-label small" for="d0_4">Thu</label>
                                        </div>
                                        <div class="form-check form-check-inline me-1">
                                            <input class="form-check-input chk-day" type="checkbox" value="5" id="d0_5" checked disabled>
                                            <label class="form-check-label small" for="d0_5">Fri</label>
                                        </div>
                                        <div class="form-check form-check-inline me-1">
                                            <input class="form-check-input chk-day" type="checkbox" value="6" id="d0_6" checked disabled>
                                            <label class="form-check-label small" for="d0_6">Sat</label>
                                        </div>
                                        <div class="form-check form-check-inline me-1">
                                            <input class="form-check-input chk-day" type="checkbox" value="7" id="d0_7" checked disabled>
                                            <label class="form-check-label small" for="d0_7">Sun</label>
                                        </div>
                                    </div>
                                    <!-- Hidden serialized days string -->
                                    <input type="hidden" name="Subscriptions[0].DeliveryDays" class="input-delivery-days" value="1,2,3,4,5,6,7" />
                                </div>

                                <div class="col-12 mt-2">
                                    <label class="form-label small text-muted">Special Agreed Price (₹/L) <span class="small">(Optional override)</span></label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-white">₹</span>
                                        <input type="number" name="Subscriptions[0].CustomPriceOverride" class="form-control font-tabular"
                                               step="0.50" min="0" placeholder="Default category price applies if blank" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Submission Buttons -->
                    <div class="d-grid gap-2 mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-admin-primary py-2 fw-semibold shadow-sm">
                            <i class="cil-check me-1"></i> Register Customer &amp; Subscriptions
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary py-2 text-center text-decoration-none">
                            Discard &amp; Return to Directory
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<partial name="_QuickAddRouteModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const categoriesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(categories.Select(c => new { c.CategoryId, c.CategoryCode, c.CategoryName, DefaultPricePerLiter = c.DefaultPrice })));
        let lineIndex = 1;

        document.addEventListener("DOMContentLoaded", function () {
            // Add subscription line
            const btnAdd = document.getElementById("btnAddSubscription");
            if (btnAdd) {
                btnAdd.addEventListener("click", function () {
                    addNewSubscriptionLine();
                });
            }

            // Delegate schedule change
            document.getElementById("subscriptionLinesContainer").addEventListener("change", function (e) {
                if (e.target && e.target.classList.contains("select-schedule")) {
                    updateScheduleDays(e.target);
                } else if (e.target && e.target.classList.contains("chk-day")) {
                    updateSerializedDays(e.target.closest(".subscription-line-card"));
                }
            });

            // Delegate remove line
            document.getElementById("subscriptionLinesContainer").addEventListener("click", function (e) {
                const btnRemove = e.target.closest(".btn-remove-line");
                if (btnRemove) {
                    const card = btnRemove.closest(".subscription-line-card");
                    const allCards = document.querySelectorAll(".subscription-line-card");
                    if (allCards.length > 1) {
                        card.remove();
                        renumberLines();
                    } else {
                        alert("At least one subscription line item is required for new customer onboarding.");
                    }
                }
            });
        });

        function addNewSubscriptionLine() {
            const container = document.getElementById("subscriptionLinesContainer");
            const idx = lineIndex++;

            let catOptions = "";
            categoriesData.forEach(c => {
                catOptions += `<option value="${c.CategoryId}">${escapeHtml(c.CategoryName)} (${escapeHtml(c.CategoryCode)}) — ₹${c.DefaultPricePerLiter}/L</option>`;
            });

            const lineHtml = `
                <div class="card border p-3 mb-3 subscription-line-card bg-light bg-opacity-25" data-index="${idx}">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge bg-secondary-subtle text-secondary subscription-line-badge">Product Line #${idx + 1}</span>
                        <button type="button" class="btn btn-link text-danger p-0 border-0 btn-remove-line" title="Remove line">
                            <i class="cil-trash"></i>
                        </button>
                    </div>
                    <div class="row g-2">
                        <div class="col-sm-7">
                            <label class="form-label small fw-semibold">Product Category <span class="text-danger">*</span></label>
                            <select name="Subscriptions[${idx}].CategoryId" class="form-select form-select-sm" required>
                                ${catOptions}
                            </select>
                        </div>
                        <div class="col-sm-5">
                            <label class="form-label small fw-semibold">Shift <span class="text-danger">*</span></label>
                            <select name="Subscriptions[${idx}].Shift" class="form-select form-select-sm" required>
                                <option value="Morning">Morning</option>
                                <option value="Evening">Evening</option>
                                <option value="Both">Both Shifts</option>
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label small fw-semibold">Quantity (Litres) <span class="text-danger">*</span></label>
                            <input type="number" name="Subscriptions[${idx}].Quantity" class="form-control form-control-sm font-tabular"
                                   step="0.25" min="0.25" max="50" value="1.00" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label small fw-semibold">Schedule <span class="text-danger">*</span></label>
                            <select name="Subscriptions[${idx}].DeliverySchedule" class="form-select form-select-sm select-schedule" data-index="${idx}" required>
                                <option value="Daily">Daily (All 7 Days)</option>
                                <option value="Weekdays">Weekdays (Mon-Fri)</option>
                                <option value="Weekends">Weekends (Sat-Sun)</option>
                                <option value="CustomDays">Custom Days</option>
                            </select>
                        </div>
                        <div class="col-12 mt-2">
                            <label class="form-label small fw-semibold text-secondary mb-1">Active Days</label>
                            <div class="d-flex flex-wrap gap-2 days-checkbox-group" data-index="${idx}">
                                <div class="form-check form-check-inline me-1">
                                    <input class="form-check-input chk-day" type="checkbox" value="1" id="d${idx}_1" checked disabled>
                                    <label class="form-check-label small" for="d${idx}_1">Mon</label>
                                </div>
                                <div class="form-check form-check-inline me-1">
                                    <input class="form-check-input chk-day" type="checkbox" value="2" id="d${idx}_2" checked disabled>
                                    <label class="form-check-label small" for="d${idx}_2">Tue</label>
                                </div>
                                <div class="form-check form-check-inline me-1">
                                    <input class="form-check-input chk-day" type="checkbox" value="3" id="d${idx}_3" checked disabled>
                                    <label class="form-check-label small" for="d${idx}_3">Wed</label>
                                </div>
                                <div class="form-check form-check-inline me-1">
                                    <input class="form-check-input chk-day" type="checkbox" value="4" id="d${idx}_4" checked disabled>
                                    <label class="form-check-label small" for="d${idx}_4">Thu</label>
                                </div>
                                <div class="form-check form-check-inline me-1">
                                    <input class="form-check-input chk-day" type="checkbox" value="5" id="d${idx}_5" checked disabled>
                                    <label class="form-check-label small" for="d${idx}_5">Fri</label>
                                </div>
                                <div class="form-check form-check-inline me-1">
                                    <input class="form-check-input chk-day" type="checkbox" value="6" id="d${idx}_6" checked disabled>
                                    <label class="form-check-label small" for="d${idx}_6">Sat</label>
                                </div>
                                <div class="form-check form-check-inline me-1">
                                    <input class="form-check-input chk-day" type="checkbox" value="7" id="d${idx}_7" checked disabled>
                                    <label class="form-check-label small" for="d${idx}_7">Sun</label>
                                </div>
                            </div>
                            <input type="hidden" name="Subscriptions[${idx}].DeliveryDays" class="input-delivery-days" value="1,2,3,4,5,6,7" />
                        </div>
                        <div class="col-12 mt-2">
                            <label class="form-label small text-muted">Special Agreed Price (₹/L) <span class="small">(Optional override)</span></label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white">₹</span>
                                <input type="number" name="Subscriptions[${idx}].CustomPriceOverride" class="form-control font-tabular"
                                       step="0.50" min="0" placeholder="Default category price applies if blank" />
                            </div>
                        </div>
                    </div>
                </div>
            `;

            container.insertAdjacentHTML("beforeend", lineHtml);
            renumberLines();
        }

        function renumberLines() {
            const cards = document.querySelectorAll(".subscription-line-card");
            cards.forEach((card, idx) => {
                const badge = card.querySelector(".subscription-line-badge");
                if (badge) badge.innerText = `Product Line #${idx + 1}`;

                const btnRemove = card.querySelector(".btn-remove-line");
                if (btnRemove) {
                    btnRemove.style.display = cards.length > 1 ? "inline-block" : "none";
                }
            });
        }

        function updateScheduleDays(selectEl) {
            const card = selectEl.closest(".subscription-line-card");
            const schedule = selectEl.value;
            const checkboxes = card.querySelectorAll(".chk-day");
            const hiddenInput = card.querySelector(".input-delivery-days");

            checkboxes.forEach(chk => {
                const val = parseInt(chk.value, 10);
                if (schedule === "Daily") {
                    chk.checked = true;
                    chk.disabled = true;
                } else if (schedule === "Weekdays") {
                    chk.checked = val >= 1 && val <= 5;
                    chk.disabled = true;
                } else if (schedule === "Weekends") {
                    chk.checked = val === 6 || val === 7;
                    chk.disabled = true;
                } else if (schedule === "CustomDays") {
                    chk.disabled = false;
                }
            });

            updateSerializedDays(card);
        }

        function updateSerializedDays(card) {
            const checkboxes = card.querySelectorAll(".chk-day:checked");
            const selectedDays = Array.from(checkboxes).map(c => c.value).sort((a,b) => a - b);
            const hiddenInput = card.querySelector(".input-delivery-days");
            if (hiddenInput) {
                hiddenInput.value = selectedDays.join(",");
            }
        }

        function escapeHtml(str) {
            if (!str) return "";
            return str.replace(/[&<>"']/g, function(m) {
                return {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#39;'
                }[m];
            });
        }
    </script>
}
