@model Dairy_Management_System.Models.Customer.CustomerIndexViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Customer Management";
    ViewData["ActiveMenu"] = "Customers";
}

<!-- Page Header & Action Bar -->
<div class="card border-0 bg-white shadow-sm mb-4">
    <div class="card-body py-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="cil-user me-1"></i> Master Directory
                </span>
                <span class="badge bg-light text-secondary border">Lifecycle Management</span>
            </div>
            <h4 class="fw-bold text-dark mb-0">Customer Directory &amp; Lifecycle Management</h4>
            <p class="text-muted small mb-0 mt-1">
                Manage customer onboarding, subscription schedules, delivery agent routes, and vacation lockouts.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Create" class="btn btn-admin-primary d-inline-flex align-items-center gap-2 shadow-sm">
                <i class="cil-user-plus"></i> Add New Customer
            </a>
        </div>
    </div>
</div>

<!-- Alerts / Notifications -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-success-subtle shadow-sm mb-4" role="alert">
        <div class="d-flex align-items-center gap-2">
            <i class="cil-check-circle fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-danger-subtle shadow-sm mb-4" role="alert">
        <div class="d-flex align-items-center gap-2">
            <i class="cil-warning fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Metric Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card-stat p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="stat-label">Total Customers</span>
                <div class="stat-icon" style="background-color: #f1f5f9; color: #475569;">
                    <i class="cil-people"></i>
                </div>
            </div>
            <div class="stat-value font-tabular">@Model.TotalCount</div>
            <div class="stat-subtitle text-muted small">Registered in system</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card-stat p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="stat-label">Active Customers</span>
                <div class="stat-icon" style="background-color: #ecfdf5; color: #059669;">
                    <i class="cil-check-circle"></i>
                </div>
            </div>
            <div class="stat-value font-tabular text-success">@Model.ActiveCount</div>
            <div class="stat-subtitle text-muted small">Eligible for daily runsheets</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card-stat p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="stat-label">Inactive Customers</span>
                <div class="stat-icon" style="background-color: #fef2f2; color: #dc2626;">
                    <i class="cil-user-x"></i>
                </div>
            </div>
            <div class="stat-value font-tabular text-danger">@Model.InactiveCount</div>
            <div class="stat-subtitle text-muted small">Deactivated or pending reactivation</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card-stat p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="stat-label">On Vacation Today</span>
                <div class="stat-icon" style="background-color: #fffbeb; color: #d97706;">
                    <i class="cil-beach-access"></i>
                </div>
            </div>
            <div class="stat-value font-tabular text-warning">@Model.VacationTodayCount</div>
            <div class="stat-subtitle text-muted small">Deliveries locked today</div>
        </div>
    </div>
</div>

<!-- Search & Filtering Card -->
<div class="card card-dms shadow-sm mb-4">
    <div class="card-header bg-light">
        <div class="d-flex align-items-center gap-2">
            <i class="cil-filter text-primary"></i>
            <span class="fw-semibold">Filter Directory</span>
        </div>
        <span class="badge bg-secondary-subtle text-secondary small">Live Search</span>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index" id="customerFilterForm">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-secondary">Search Customer</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="cil-magnifying-glass"></i></span>
                        <input type="text" name="searchTerm" id="filterSearchTerm" class="form-control border-start-0"
                               placeholder="Code, Name, Phone..." value="@Model.SearchTerm" />
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-secondary">Status</label>
                    <select name="status" id="filterStatus" class="form-select">
                        <option value="All" selected="@(string.IsNullOrEmpty(Model.SelectedStatus) || Model.SelectedStatus == "All")">All Statuses</option>
                        <option value="Active" selected="@(Model.SelectedStatus == "Active")">Active</option>
                        <option value="Inactive" selected="@(Model.SelectedStatus == "Inactive")">Inactive</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-secondary">Route</label>
                    <select name="routeId" id="filterRouteId" class="form-select">
                        <option value="">All Routes</option>
                        @foreach (var route in Model.RouteList)
                        {
                            <option value="@route.RouteId" selected="@(Model.SelectedRouteId == route.RouteId)">@route.RouteCode - @route.RouteName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-secondary">Delivery Agent</label>
                    <select name="deliveryBoyId" id="filterDeliveryBoyId" class="form-select">
                        <option value="">All Delivery Boys</option>
                        @foreach (var dboy in Model.DeliveryBoyList)
                        {
                            <option value="@dboy.DeliveryBoyId" selected="@(Model.SelectedDeliveryBoyId == dboy.DeliveryBoyId)">@dboy.FullName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-secondary">Area</label>
                    <select name="area" id="filterArea" class="form-select">
                        <option value="">All Areas</option>
                        @foreach (var area in Model.AreaList)
                        {
                            <option value="@area" selected="@(Model.SelectedArea == area)">@area</option>
                        }
                    </select>
                </div>
            </div>
            <div class="d-flex justify-content-end align-items-center gap-2 mt-3 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                    <i class="cil-reload me-1"></i> Reset Filters
                </a>
                <button type="submit" class="btn btn-admin-primary btn-sm px-4">
                    <i class="cil-check me-1"></i> Apply Filters
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Continuous Scrolling Table Card with Sticky Headers -->
<div class="card card-dms shadow-sm">
    <div class="card-header bg-white py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center gap-2">
            <i class="cil-list text-success"></i>
            <span class="fw-bold text-dark">Customer Records</span>
            <span class="badge bg-light text-secondary border font-tabular ms-1" id="displayedCountBadge">
                Showing @Model.Customers.Count of @Model.TotalCount
            </span>
        </div>
        <div class="text-muted small">
            <i class="cil-info me-1"></i> Continuous scroll enabled &bull; Sticky table header
        </div>
    </div>
    <div class="card-body p-0">
        <!-- Scrollable Table Container with Sticky Headers -->
        <div class="table-responsive" style="max-height: 650px; overflow-y: auto;" id="tableContainer">
            <table class="table table-hover table-dms align-middle mb-0" id="customerTable">
                <thead class="sticky-top bg-light shadow-sm" style="z-index: 10;">
                    <tr>
                        <th class="ps-3" style="width: 110px;">Customer Code</th>
                        <th>Customer Details</th>
                        <th>Contact</th>
                        <th>Route &amp; Delivery Agent</th>
                        <th>Preferred Shift</th>
                        <th class="text-center">Vacation</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-3" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody id="customerTableBody">
                    @if (Model.Customers.Count == 0)
                    {
                        <tr id="emptyRow">
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="cil-folder-open fs-2 d-block mb-2 text-secondary"></i>
                                <h6 class="fw-bold mb-1">No customers found</h6>
                                <p class="small text-muted mb-0">Try adjusting your search criteria or register a new customer.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in Model.Customers)
                        {
                            <tr id="row-customer-@c.CustomerId" data-customer-id="@c.CustomerId">
                                <td class="ps-3">
                                    <a asp-action="Details" asp-route-id="@c.CustomerId" class="fw-bold text-primary font-tabular text-decoration-none">
                                        @c.CustomerCode
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@c.FullName</div>
                                    @if (!string.IsNullOrWhiteSpace(c.FullNameGujarati))
                                    {
                                        <div class="text-muted small">@c.FullNameGujarati</div>
                                    }
                                    <div class="text-secondary small mt-1">
                                        <i class="cil-location-pin me-1"></i>@c.Area
                                    </div>
                                </td>
                                <td>
                                    <a href="tel:@c.Phone" class="text-decoration-none text-dark font-tabular fw-medium">
                                        <i class="cil-phone text-success me-1"></i>@c.Phone
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">
                                        <span class="badge bg-light text-dark border">Route</span> @c.RouteName
                                    </div>
                                    <div class="text-muted small mt-1">
                                        @if (!string.IsNullOrWhiteSpace(c.DeliveryBoyName))
                                        {
                                            <i class="cil-bike text-primary me-1"></i>@c.DeliveryBoyName
                                            <span class="text-muted ms-1">(Seq #@c.DeliverySequence)</span>
                                        }
                                        else
                                        {
                                            <span class="text-warning"><i class="cil-warning me-1"></i>Unassigned</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border">@c.PreferredShift</span>
                                </td>
                                <td class="text-center">
                                    @if (c.IsOnVacationToday)
                                    {
                                        <span class="badge-vacation-indicator text-warning bg-warning-subtle border-warning-subtle" title="Deliveries locked today due to approved vacation">
                                            <i class="cil-beach-access me-1"></i> On Vacation
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">&mdash;</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (c.Status == "Active")
                                    {
                                        <span class="badge-status badge-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-inactive">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-coreui-toggle="dropdown" aria-expanded="false">
                                            Manage
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                            <li>
                                                <a class="dropdown-item" asp-action="Details" asp-route-id="@c.CustomerId">
                                                    <i class="cil-magnifying-glass me-2 text-primary"></i> View Details
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-action="Edit" asp-route-id="@c.CustomerId">
                                                    <i class="cil-pencil me-2 text-secondary"></i> Edit Demographics
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider my-1"></li>
                                            <li>
                                                <button type="button" class="dropdown-item text-primary"
                                                        onclick="openReassignModal(@c.CustomerId, '@c.FullName', '@c.DeliveryBoyName', '@c.RouteName')">
                                                    <i class="cil-bike me-2"></i> Reassign Delivery Boy
                                                </button>
                                            </li>
                                            @if (c.Status == "Active")
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item text-danger"
                                                            onclick="openDeactivateModal(@c.CustomerId, '@c.FullName', '@c.CustomerCode')">
                                                        <i class="cil-user-x me-2"></i> Deactivate Customer
                                                    </button>
                                                </li>
                                            }
                                            else
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item text-success"
                                                            onclick="openReactivateModal(@c.CustomerId, '@c.FullName', '@c.CustomerCode', @c.RouteId, @c.DeliverySequence)">
                                                        <i class="cil-reload me-2"></i> Reactivate Customer
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <!-- Continuous Scroll Sentinel & Loading Indicator -->
            <div id="scrollSentinel" class="text-center py-3 border-top" style="@(Model.Customers.Count >= Model.TotalCount ? "display: none;" : "")">
                <div class="spinner-border spinner-border-sm text-success me-2" role="status" id="scrollSpinner">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <span class="text-muted small" id="scrollStatusText">Loading more customers...</span>
            </div>

            <!-- End of Customer List Notification -->
            <div id="endOfListNotice" class="text-center py-3 border-top text-muted small bg-light"
                 style="@(Model.Customers.Count < Model.TotalCount ? "display: none;" : "")">
                <i class="cil-check-alt me-1 text-success"></i> All @Model.TotalCount customers loaded.
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 1: REASSIGN DELIVERY BOY                                            -->
<!-- ========================================================================= -->
<div class="modal fade" id="reassignModal" tabindex="-1" aria-labelledby="reassignModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="ReassignDeliveryBoy" method="post" id="reassignForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CustomerId" id="reassignCustomerId" />
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold text-dark" id="reassignModalLabel">
                        <i class="cil-bike text-primary me-2"></i> Reassign Delivery Boy
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-light border small mb-3">
                        <div>Customer: <strong id="reassignCustomerName" class="text-dark"></strong></div>
                        <div>Current Agent: <span id="reassignCurrentAgent" class="badge bg-secondary-subtle text-secondary"></span></div>
                    </div>

                    <!-- Target Effective Date -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Effective Date <span class="text-danger">*</span></label>
                        <input type="date" name="EffectiveDate" id="reassignEffectiveDate" class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        <div class="form-text small">Cannot reassign for past dates.</div>
                    </div>

                    <!-- Delivery Check Notice (Live via AJAX) -->
                    <div id="reassignDeliveryWarning" class="alert alert-warning small py-2 d-none">
                        <i class="cil-warning me-1"></i>
                        <span id="reassignDeliveryWarningText">A delivery was already recorded on this date. Reassignment will apply to future deliveries.</span>
                    </div>

                    <!-- New Delivery Boy Selection -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">New Delivery Boy <span class="text-danger">*</span></label>
                        <select name="NewDeliveryBoyId" id="reassignNewDeliveryBoyId" class="form-select" required>
                            <option value="">-- Select Delivery Boy --</option>
                            @foreach (var dboy in Model.DeliveryBoyList)
                            {
                                <option value="@dboy.DeliveryBoyId">@dboy.FullName (@dboy.Phone)</option>
                            }
                        </select>
                    </div>

                    <!-- Shift -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Applicable Shift</label>
                        <select name="Shift" class="form-select">
                            <option value="Both">Both Shifts (Morning &amp; Evening)</option>
                            <option value="Morning">Morning Shift Only</option>
                            <option value="Evening">Evening Shift Only</option>
                        </select>
                    </div>

                    <!-- Reason -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Reassignment Reason <span class="text-danger">*</span></label>
                        <textarea name="Reason" class="form-control" rows="2" placeholder="e.g. Route optimization, agent change..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-admin-primary btn-sm px-4">
                        <i class="cil-check me-1"></i> Confirm Reassignment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 2: DEACTIVATE CUSTOMER                                              -->
<!-- ========================================================================= -->
<div class="modal fade" id="deactivateModal" tabindex="-1" aria-labelledby="deactivateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="Deactivate" method="post" id="deactivateForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CustomerId" id="deactivateCustomerId" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="deactivateModalLabel">
                        <i class="cil-user-x me-2"></i> Deactivate Customer
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-light border small mb-3">
                        <div>Customer: <strong id="deactivateCustomerName" class="text-dark"></strong> (<span id="deactivateCustomerCode"></span>)</div>
                    </div>

                    <!-- Deactivation Date -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Deactivation Effective Date <span class="text-danger">*</span></label>
                        <input type="date" name="DeactivationDate" id="deactivateDate" class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        <div class="form-text small">Active subscriptions will terminate as of this date.</div>
                    </div>

                    <!-- Live Delivery Check Notification -->
                    <div id="deactivateDeliveryWarning" class="alert alert-warning small py-2 d-none">
                        <i class="cil-warning me-1"></i>
                        <span id="deactivateDeliveryWarningText">Today's delivery has already been logged. Deactivation will take effect after today's ledger.</span>
                    </div>

                    <!-- Reason -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Reason for Deactivation <span class="text-danger">*</span></label>
                        <textarea name="Reason" class="form-control" rows="3" placeholder="e.g. Customer relocated, requested service pause, non-payment..." required></textarea>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="ConfirmDeliveryLogged" value="true" id="chkConfirmDelivery" />
                        <label class="form-check-label small text-muted" for="chkConfirmDelivery">
                            I understand that pending daily runsheet deliveries will cease immediately.
                        </label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm px-4">
                        <i class="cil-ban me-1"></i> Deactivate Now
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 3: REACTIVATE CUSTOMER                                              -->
<!-- ========================================================================= -->
<div class="modal fade" id="reactivateModal" tabindex="-1" aria-labelledby="reactivateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="Reactivate" method="post" id="reactivateForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CustomerId" id="reactivateCustomerId" />
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold" id="reactivateModalLabel">
                        <i class="cil-reload me-2"></i> Reactivate Customer
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-light border small mb-3">
                        <div>Customer: <strong id="reactivateCustomerName" class="text-dark"></strong> (<span id="reactivateCustomerCode"></span>)</div>
                        <div class="text-muted small mt-1">Reactivation restores the customer to Active status. New subscriptions can be added from Details.</div>
                    </div>

                    <!-- Reactivation Date -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Reactivation Date <span class="text-danger">*</span></label>
                        <input type="date" name="ReactivationDate" class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <!-- Target Route -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Delivery Route <span class="text-danger">*</span></label>
                        <select name="NewRouteId" id="reactivateRouteId" class="form-select" required>
                            @foreach (var route in Model.RouteList)
                            {
                                <option value="@route.RouteId">@route.RouteCode - @route.RouteName</option>
                            }
                        </select>
                    </div>

                    <!-- Delivery Sequence -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Delivery Sequence <span class="text-danger">*</span></label>
                        <input type="number" name="NewSequence" id="reactivateSequence" class="form-control" value="1" min="1" required />
                    </div>

                    <!-- Target Delivery Boy -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Delivery Agent <span class="text-danger">*</span></label>
                        <select name="NewDeliveryBoyId" class="form-select" required>
                            @foreach (var dboy in Model.DeliveryBoyList)
                            {
                                <option value="@dboy.DeliveryBoyId">@dboy.FullName (@dboy.Phone)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm px-4 text-white">
                        <i class="cil-check me-1"></i> Reactivate Customer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Continuous Scrolling State
    let currentPage = 1;
    const pageSize = 25;
    let totalCount = @Model.TotalCount;
    let loadedCount = @Model.Customers.Count;
    let isLoading = false;
    let hasMore = loadedCount < totalCount;

    // Filter Query Params
    const searchTerm = '@Html.Raw(Model.SearchTerm ?? "")';
    const statusVal = '@Html.Raw(Model.SelectedStatus ?? "All")';
    const routeIdVal = '@Model.SelectedRouteId';
    const deliveryBoyIdVal = '@Model.SelectedDeliveryBoyId';
    const areaVal = '@Html.Raw(Model.SelectedArea ?? "")';

    // IntersectionObserver for Continuous Scroll
    document.addEventListener("DOMContentLoaded", function () {
        const sentinel = document.getElementById("scrollSentinel");
        const container = document.getElementById("tableContainer");

        if ("IntersectionObserver" in window && sentinel) {
            const observer = new IntersectionObserver((entries) => {
                const first = entries[0];
                if (first.isIntersecting && hasMore && !isLoading) {
                    loadNextPage();
                }
            }, {
                root: container,
                threshold: 0.1
            });

            observer.observe(sentinel);
        }

        // Live Delivery Check on Reassign Date Change
        const reassignDateInput = document.getElementById("reassignEffectiveDate");
        if (reassignDateInput) {
            reassignDateInput.addEventListener("change", function () {
                checkDeliveryForReassign();
            });
        }

        // Live Delivery Check on Deactivate Date Change
        const deactivateDateInput = document.getElementById("deactivateDate");
        if (deactivateDateInput) {
            deactivateDateInput.addEventListener("change", function () {
                checkDeliveryForDeactivate();
            });
        }
    });

    function loadNextPage() {
        if (isLoading || !hasMore) return;
        isLoading = true;
        currentPage++;

        const spinner = document.getElementById("scrollSpinner");
        const statusText = document.getElementById("scrollStatusText");
        if (spinner) spinner.style.display = "inline-block";
        if (statusText) statusText.innerText = "Loading page " + currentPage + "...";

        const url = `/Customer/GetCustomerListJson?pageNumber=${currentPage}&pageSize=${pageSize}&searchTerm=${encodeURIComponent(searchTerm)}&status=${encodeURIComponent(statusVal)}&routeId=${routeIdVal}&deliveryBoyId=${deliveryBoyIdVal}&area=${encodeURIComponent(areaVal)}`;

        fetch(url)
            .then(res => res.json())
            .then(data => {
                if (data.customers && data.customers.length > 0) {
                    appendRows(data.customers);
                    loadedCount += data.customers.length;
                    totalCount = data.totalCount;

                    // Update UI Counter Badge
                    const badge = document.getElementById("displayedCountBadge");
                    if (badge) badge.innerText = `Showing ${loadedCount} of ${totalCount}`;
                }

                hasMore = data.hasMore;
                isLoading = false;

                if (!hasMore) {
                    const sentinel = document.getElementById("scrollSentinel");
                    if (sentinel) sentinel.style.display = "none";

                    const notice = document.getElementById("endOfListNotice");
                    if (notice) {
                        notice.style.display = "block";
                        notice.innerHTML = `<i class="cil-check-alt me-1 text-success"></i> All ${totalCount} customers loaded.`;
                    }
                } else {
                    if (statusText) statusText.innerText = "Scroll down for more...";
                }
            })
            .catch(err => {
                console.error("Continuous scroll error:", err);
                isLoading = false;
                if (statusText) statusText.innerText = "Failed to load more. Scroll again to retry.";
            });
    }

    function appendRows(customers) {
        const tbody = document.getElementById("customerTableBody");
        if (!tbody) return;

        customers.forEach(c => {
            const tr = document.createElement("tr");
            tr.id = `row-customer-${c.customerId}`;
            tr.setAttribute("data-customer-id", c.customerId);

            const vacationBadge = c.isOnVacationToday
                ? `<span class="badge-vacation-indicator text-warning bg-warning-subtle border-warning-subtle" title="Deliveries locked today">
                     <i class="cil-beach-access me-1"></i> On Vacation
                   </span>`
                : `<span class="text-muted small">&mdash;</span>`;

            const statusBadge = c.status === "Active"
                ? `<span class="badge-status badge-active">Active</span>`
                : `<span class="badge-status badge-inactive">Inactive</span>`;

            const deliveryBoyInfo = c.deliveryBoyName
                ? `<i class="cil-bike text-primary me-1"></i>${c.deliveryBoyName} <span class="text-muted ms-1">(Seq #${c.deliverySequence})</span>`
                : `<span class="text-warning"><i class="cil-warning me-1"></i>Unassigned</span>`;

            const gujaratiNameHtml = c.fullNameGujarati ? `<div class="text-muted small">${escapeHtml(c.fullNameGujarati)}</div>` : "";
            const altPhoneHtml = c.alternatePhone ? `<div class="text-muted small font-tabular">Alt: ${escapeHtml(c.alternatePhone)}</div>` : "";

            const actionStatusItem = c.status === "Active"
                ? `<li>
                     <button type="button" class="dropdown-item text-danger"
                             onclick="openDeactivateModal(${c.customerId}, '${escapeJs(c.fullName)}', '${escapeJs(c.customerCode)}')">
                         <i class="cil-user-x me-2"></i> Deactivate Customer
                     </button>
                   </li>`
                : `<li>
                     <button type="button" class="dropdown-item text-success"
                             onclick="openReactivateModal(${c.customerId}, '${escapeJs(c.fullName)}', '${escapeJs(c.customerCode)}', ${c.routeId}, ${c.deliverySequence})">
                         <i class="cil-reload me-2"></i> Reactivate Customer
                     </button>
                   </li>`;

            tr.innerHTML = `
                <td class="ps-3">
                    <a href="/Customer/Details/${c.customerId}" class="fw-bold text-primary font-tabular text-decoration-none">
                        ${escapeHtml(c.customerCode)}
                    </a>
                </td>
                <td>
                    <div class="fw-semibold text-dark">${escapeHtml(c.fullName)}</div>
                    ${gujaratiNameHtml}
                    <div class="text-secondary small mt-1">
                        <i class="cil-location-pin me-1"></i>${escapeHtml(c.area || "")}
                    </div>
                </td>
                <td>
                    <a href="tel:${escapeHtml(c.phone)}" class="text-decoration-none text-dark font-tabular fw-medium">
                        <i class="cil-phone text-success me-1"></i>${escapeHtml(c.phone)}
                    </a>
                    ${altPhoneHtml}
                </td>
                <td>
                    <div class="fw-medium text-dark">
                        <span class="badge bg-light text-dark border">${escapeHtml(c.routeCode || "")}</span> ${escapeHtml(c.routeName || "")}
                    </div>
                    <div class="text-muted small mt-1">
                        ${deliveryBoyInfo}
                    </div>
                </td>
                <td>
                    <span class="badge bg-light text-secondary border">${escapeHtml(c.preferredShift || "")}</span>
                </td>
                <td class="text-center">
                    ${vacationBadge}
                </td>
                <td class="text-center">
                    ${statusBadge}
                </td>
                <td class="text-end pe-3">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-coreui-toggle="dropdown" aria-expanded="false">
                            Manage
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                            <li>
                                <a class="dropdown-item" href="/Customer/Details/${c.customerId}">
                                    <i class="cil-magnifying-glass me-2 text-primary"></i> View Details
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/Customer/Edit/${c.customerId}">
                                    <i class="cil-pencil me-2 text-secondary"></i> Edit Demographics
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <button type="button" class="dropdown-item text-primary"
                                        onclick="openReassignModal(${c.customerId}, '${escapeJs(c.fullName)}', '${escapeJs(c.deliveryBoyName || "")}', '${escapeJs(c.routeName || "")}')">
                                    <i class="cil-bike me-2"></i> Reassign Delivery Boy
                                </button>
                            </li>
                            ${actionStatusItem}
                        </ul>
                    </div>
                </td>
            `;

            tbody.appendChild(tr);
        });
    }

    // Modal Helpers
    function openReassignModal(customerId, customerName, currentAgent, routeName) {
        document.getElementById("reassignCustomerId").value = customerId;
        document.getElementById("reassignCustomerName").innerText = customerName;
        document.getElementById("reassignCurrentAgent").innerText = currentAgent || "Unassigned";

        const modalEl = document.getElementById("reassignModal");
        const modal = new coreui.Modal(modalEl);
        modal.show();

        checkDeliveryForReassign();
    }

    function checkDeliveryForReassign() {
        const customerId = document.getElementById("reassignCustomerId").value;
        const date = document.getElementById("reassignEffectiveDate").value;
        const warning = document.getElementById("reassignDeliveryWarning");

        if (!customerId || !date) return;

        fetch(`/Customer/CheckDeliveryOnDate?customerId=${customerId}&date=${date}`)
            .then(res => res.json())
            .then(data => {
                if (data.hasDelivery) {
                    warning.classList.remove("d-none");
                } else {
                    warning.classList.add("d-none");
                }
            })
            .catch(() => warning.classList.add("d-none"));
    }

    function openDeactivateModal(customerId, customerName, customerCode) {
        document.getElementById("deactivateCustomerId").value = customerId;
        document.getElementById("deactivateCustomerName").innerText = customerName;
        document.getElementById("deactivateCustomerCode").innerText = customerCode;

        const modalEl = document.getElementById("deactivateModal");
        const modal = new coreui.Modal(modalEl);
        modal.show();

        checkDeliveryForDeactivate();
    }

    function checkDeliveryForDeactivate() {
        const customerId = document.getElementById("deactivateCustomerId").value;
        const date = document.getElementById("deactivateDate").value;
        const warning = document.getElementById("deactivateDeliveryWarning");

        if (!customerId || !date) return;

        fetch(`/Customer/CheckDeliveryOnDate?customerId=${customerId}&date=${date}`)
            .then(res => res.json())
            .then(data => {
                if (data.hasDelivery) {
                    warning.classList.remove("d-none");
                } else {
                    warning.classList.add("d-none");
                }
            })
            .catch(() => warning.classList.add("d-none"));
    }

    function openReactivateModal(customerId, customerName, customerCode, routeId, sequence) {
        document.getElementById("reactivateCustomerId").value = customerId;
        document.getElementById("reactivateCustomerName").innerText = customerName;
        document.getElementById("reactivateCustomerCode").innerText = customerCode;
        if (routeId) document.getElementById("reactivateRouteId").value = routeId;
        if (sequence) document.getElementById("reactivateSequence").value = sequence;

        const modalEl = document.getElementById("reactivateModal");
        const modal = new coreui.Modal(modalEl);
        modal.show();
    }

    function escapeHtml(str) {
        if (!str) return "";
        return str.replace(/[&<>"']/g, function(m) {
            return {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            }[m];
        });
    }

    function escapeJs(str) {
        if (!str) return "";
        return str.replace(/'/g, "\\'").replace(/"/g, '\\"');
    }
</script>
}
