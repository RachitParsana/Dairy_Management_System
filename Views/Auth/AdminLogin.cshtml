@model Dairy_Management_System.Models.Auth.AdminLoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Admin Login - Dairy Management System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Inter Font -->
    <link rel="stylesheet" href="~/lib/inter/css/inter.css" />
    <!-- CoreUI CSS (Bootstrap 5 compatible) -->
    <link rel="stylesheet" href="~/lib/coreui/css/coreui.min.css" />
    <!-- CoreUI Icons Free -->
    <link rel="stylesheet" href="~/lib/coreui-icons/css/free.min.css" />
    <!-- DMS Core & Admin Theme -->
    <link rel="stylesheet" href="~/css/dms-core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dms-admin.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex align-items-center min-vh-100 py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5 col-xl-4">
                <!-- Branding Card Header -->
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle shadow-sm mb-3" style="background-color: #064e3b; width: 64px; height: 64px;">
                        <i class="cil-drop fs-2 text-white" style="color: #34d399 !important;"></i>
                    </div>
                    <h2 class="fw-bold text-dark mb-1">DairyMS Admin</h2>
                    <p class="text-muted small mb-0">System Administration &amp; Operations Portal</p>
                    <span class="badge bg-success-subtle text-success border border-success-subtle mt-1 small">
                        ડેરી મેનેજમેન્ટ સિસ્ટમ &bull; એડમિન લૉગિન
                    </span>
                </div>

                <!-- Login Card -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                            <div>
                                <span class="fw-semibold text-dark d-block">Staff Sign In</span>
                                <small class="text-muted">કર્મચારી લૉગિન</small>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Role: Admin</span>
                        </div>

                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("DeliveryBoy"))
                        {
                            <!-- Role Switch Confirmation Prompt -->
                            <div class="alert alert-warning border-0 shadow-sm p-3 mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="cil-warning fs-4 text-warning me-2"></i>
                                    <span class="fw-bold text-dark">Active Delivery Partner Session</span>
                                </div>
                                <p class="small text-muted mb-0">
                                    You are currently signed in as <strong>@(User.Identity.Name ?? "Delivery Partner")</strong>.
                                    To sign in to the <strong>Administrator Console</strong>, you must explicitly switch roles and terminate your field partner session.
                                </p>
                            </div>

                            <form asp-controller="Auth" asp-action="SwitchRole" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="targetRole" value="Admin" />
                                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                                <div class="d-grid gap-2 mt-4">
                                    <button type="submit" class="btn btn-admin-primary py-2 fw-semibold">
                                        <i class="cil-sync me-1"></i> Confirm &amp; Switch to Admin Login
                                    </button>
                                    <a href="~/Home/Privacy" class="btn btn-outline-secondary py-2 text-decoration-none">
                                        <i class="cil-arrow-left me-1"></i> Return to Delivery Portal
                                    </a>
                                </div>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Auth" asp-action="AdminLogin" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" id="adminLoginForm" novalidate>
                                @Html.AntiForgeryToken()

                                <!-- Server Validation Summary / Authentication Error Alert -->
                                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                                {
                                    <div class="alert alert-danger p-3 small mb-3 border-0 shadow-sm d-flex align-items-start gap-2" role="alert">
                                        <i class="cil-warning fs-5 text-danger flex-shrink-0 mt-1"></i>
                                        <div>
                                            <strong class="d-block mb-1">Authentication Failed / લૉગિન નિષ્ફળ:</strong>
                                            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                                            {
                                                <span>@error.ErrorMessage</span>
                                            }
                                        </div>
                                    </div>
                                }
                                else if (!ViewData.ModelState.IsValid)
                                {
                                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3 border-0 shadow-sm" role="alert"></div>
                                }

                                <!-- Username Field -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                                        <label asp-for="Username" class="form-dms-label mb-0">Username</label>
                                        <small class="text-muted">વપરાશકર્તા નામ</small>
                                    </div>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="cil-user"></i></span>
                                        <input asp-for="Username" class="form-control form-control-dms border-start-0" placeholder="e.g. admin" autocomplete="username" autofocus />
                                    </div>
                                    <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <!-- Mobile Number Field -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                                        <label asp-for="Phone" class="form-dms-label mb-0">Mobile Number</label>
                                        <small class="text-muted">મોબાઇલ નંબર</small>
                                    </div>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="cil-phone"></i></span>
                                        <input asp-for="Phone" class="form-control form-control-dms border-start-0" placeholder="e.g. 9876543210" autocomplete="tel" maxlength="15" />
                                    </div>
                                    <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <!-- Password Field with Visibility Toggle -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                                        <label asp-for="Password" class="form-dms-label mb-0">Password</label>
                                        <small class="text-muted">પાસવર્ડ</small>
                                    </div>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="cil-lock-locked"></i></span>
                                        <input asp-for="Password" id="adminPasswordInput" class="form-control form-control-dms border-start-0 border-end-0" placeholder="••••••••" autocomplete="current-password" />
                                        <button type="button" class="btn btn-outline-secondary border-start-0 bg-white text-muted btn-password-toggle px-3" data-target="adminPasswordInput" title="Toggle password visibility" aria-label="Toggle password visibility">
                                            <span class="icon-show">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                            </span>
                                            <span class="icon-hide d-none">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                                            </span>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <!-- Remember Me Checkbox -->
                                <div class="mb-3 form-check">
                                    <input asp-for="RememberMe" class="form-check-input" />
                                    <label asp-for="RememberMe" class="form-check-label small text-muted">
                                        Remember this workstation for 7 days <span class="d-none d-sm-inline">(આ ઉપકરણ યાદ રાખો)</span>
                                    </label>
                                </div>

                                <!-- Submit Button with Loading/Submission State -->
                                <div class="d-grid mt-4">
                                    <button type="submit" id="adminSubmitBtn" class="btn btn-admin-primary py-2 fw-semibold">
                                        <span class="btn-text">
                                            <i class="cil-account-logout me-1"></i> Sign In to Admin Console &bull; સાઇન ઇન
                                        </span>
                                        <span class="btn-spinner d-none">
                                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                            Verifying Credentials...
                                        </span>
                                    </button>
                                </div>
                            </form>
                        }
                    </div>

                    <!-- Card Footer: Switch to Delivery Boy Login -->
                    <div class="card-footer bg-light border-top text-center py-3">
                        <span class="text-muted small">Field Delivery Partner? / ડિલિવરી બોય છો?</span>
                        <a asp-controller="Auth" asp-action="DeliveryBoyLogin" class="small fw-semibold text-primary ms-1 text-decoration-none">
                            Delivery Boy Login &rarr;
                        </a>
                    </div>
                </div>

                <!-- Security Notice -->
                <div class="text-center mt-3 text-muted small">
                    <i class="cil-shield-alt me-1 text-success"></i>
                    Protected by ASP.NET Core Cookie Authentication &amp; PBKDF2 Hashing
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/coreui/js/coreui.bundle.min.js"></script>
    <script src="~/js/dms-main.js" asp-append-version="true"></script>
</body>
</html>
