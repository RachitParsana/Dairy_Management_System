@model Dairy_Management_System.Controllers.BulkBillingPageViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Bulk Monthly Billing & Publishing";
    ViewData["ActiveMenu"] = "Billing";

    var eligibleCount = Model.EligibleCustomers.Count(c => c.IsEligible);
    var alreadyBilledCount = Model.EligibleCustomers.Count(c => c.HasExistingBill);
}

<div class="admin-bulk-billing-container pb-5">
    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-success-subtle shadow-sm alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="cil-check-circle fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-danger-subtle shadow-sm alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="cil-warning fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header & Action Ribbon -->
    <div class="card border-0 bg-white shadow-sm mb-4">
        <div class="card-body py-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle p-2 text-white bg-primary d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px;">
                    <i class="cil-layers fs-4"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h5 class="mb-0 fw-bold text-dark">Bulk Monthly Billing &amp; Publishing</h5>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Batch Generation Engine</span>
                    </div>
                    <div class="text-muted small mt-1">
                        Evaluate delivery accounts, execute batch billing for active routes, and safely publish finalized monthly drafts.
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#confirmBulkGenModal" @(eligibleCount == 0 ? "disabled" : "")>
                    <i class="cil-media-play me-1"></i> Run Bulk Billing (@eligibleCount)
                </button>
                <button type="button" class="btn btn-success btn-sm text-white" data-bs-toggle="modal" data-bs-target="#confirmBulkPubModal">
                    <i class="cil-check-all me-1"></i> Bulk Publish Bills
                </button>
                <a href="~/Billing" class="btn btn-outline-secondary btn-sm">
                    <i class="cil-arrow-left me-1"></i> Invoices Directory
                </a>
            </div>
        </div>

        <!-- Sub-Navigation Tabs -->
        <div class="card-footer bg-light border-top px-4 py-2">
            <ul class="nav nav-pills card-header-pills small gap-2">
                <li class="nav-item">
                    <a class="nav-link py-1 px-3 text-secondary" href="~/Billing">
                        <i class="cil-list me-1"></i> Invoices Directory
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active py-1 px-3" href="~/Billing/BulkBilling">
                        <i class="cil-layers me-1"></i> Bulk Generation &amp; Publishing
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-1 px-3 text-secondary" href="~/Billing/Payments">
                        <i class="cil-credit-card me-1"></i> Payments &amp; Advance Credit
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-1 px-3 text-secondary" href="~/Billing/Reports">
                        <i class="cil-chart-line me-1"></i> Reports &amp; Collections
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Cycle Selector & Filter Form -->
    <div class="card border-0 bg-white shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="BulkBilling" class="row g-3 align-items-center">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Target Billing Month</label>
                    <select name="month" class="form-select form-select-sm">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(Model.Month == m ? "selected" : null)">
                                @(new DateTime(2026, m, 1).ToString("MMMM"))
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Target Billing Year</label>
                    <select name="year" class="form-select form-select-sm">
                        @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 1; y++)
                        {
                            <option value="@y" selected="@(Model.Year == y ? "selected" : null)">
                                @y
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1">Filter by Route (Optional)</label>
                    <select name="routeId" class="form-select form-select-sm">
                        <option value="">All Active Routes</option>
                        @foreach (var r in Model.Routes)
                        {
                            <option value="@r.RouteId" selected="@(Model.RouteId == r.RouteId ? "selected" : null)">
                                @r.RouteName (@r.RouteCode)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex align-self-end">
                    <button type="submit" class="btn btn-sm btn-primary w-100">
                        <i class="cil-reload me-1"></i> Refresh Roster
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Eligibility Statistics Summary -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card-stat p-3 h-100 bg-white shadow-sm border-0">
                <span class="stat-label text-success">Ready for Generation</span>
                <div class="stat-value font-tabular text-success fs-3 fw-bold">@eligibleCount</div>
                <div class="stat-subtitle text-muted small">Active customers with unbilled deliveries</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-stat p-3 h-100 bg-white shadow-sm border-0">
                <span class="stat-label text-info">Already Billed</span>
                <div class="stat-value font-tabular text-info fs-3 fw-bold">@alreadyBilledCount</div>
                <div class="stat-subtitle text-muted small">Invoices exist (Protected from duplicate billing)</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-stat p-3 h-100 bg-white shadow-sm border-0">
                <span class="stat-label text-muted">Total Evaluated Accounts</span>
                <div class="stat-value font-tabular text-dark fs-3 fw-bold">@Model.EligibleCustomers.Count</div>
                <div class="stat-subtitle text-muted small">Period: @(new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy"))</div>
            </div>
        </div>
    </div>

    <!-- Eligibility Roster Table -->
    <div class="card border-0 bg-white shadow-sm">
        <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="cil-people text-primary"></i>
                <span class="fw-semibold text-dark">Customer Billing Eligibility Roster</span>
                <span class="badge bg-light text-secondary border font-tabular">@Model.EligibleCustomers.Count records</span>
            </div>
            <div class="small text-muted">
                Evaluated against completed morning/evening delivery shifts
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase text-muted border-bottom">
                    <tr>
                        <th class="ps-3">Customer Code</th>
                        <th>Customer Name</th>
                        <th>Phone</th>
                        <th>Route</th>
                        <th class="text-center">Deliveries Count</th>
                        <th class="text-end">Delivered Litres</th>
                        <th class="text-center">Billing Status</th>
                        <th class="text-end pe-3">Action</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model.EligibleCustomers.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <div class="py-3">
                                    <i class="cil-ban fs-1 mb-2 d-block"></i>
                                    <h6>No Customers Found for this Selection</h6>
                                    <p class="small mb-0">No active delivery accounts exist for the specified month, year, and route filter.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var c in Model.EligibleCustomers)
                        {
                            <tr class="@(c.HasExistingBill ? "bg-light bg-opacity-50" : "")">
                                <td class="ps-3 font-tabular fw-semibold">
                                    @c.CustomerId
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@c.FullName</div>
                                </td>
                                <td class="text-muted font-tabular">
                                    @(string.IsNullOrEmpty(c.Phone) ? "N/A" : c.Phone)
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border">@(string.IsNullOrEmpty(c.RouteName) ? "Unassigned" : c.RouteName)</span>
                                </td>
                                <td class="text-center font-tabular fw-medium">
                                    @c.CompletedDeliveriesCount
                                </td>
                                <td class="text-end font-tabular fw-semibold text-dark">
                                    @c.DeliveredLitres.ToString("N3") L
                                </td>
                                <td class="text-center">
                                    @if (c.HasExistingBill)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                            <i class="cil-check me-1"></i> Bill #@c.ExistingBillId (@c.ExistingBillStatus)
                                        </span>
                                    }
                                    else if (c.IsEligible)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="cil-media-play me-1"></i> Ready to Bill
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            No Deliveries
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    @if (c.HasExistingBill && c.ExistingBillId.HasValue)
                                    {
                                        <a href="~/Billing/Details/@c.ExistingBillId.Value" class="btn btn-sm btn-outline-secondary">
                                            <i class="cil-eye"></i> View Bill
                                        </a>
                                    }
                                    else if (c.IsEligible)
                                    {
                                        <form method="post" asp-action="GenerateBill" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="customerId" value="@c.CustomerId" />
                                            <input type="hidden" name="month" value="@Model.Month" />
                                            <input type="hidden" name="year" value="@Model.Year" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                <i class="cil-plus"></i> Bill Single
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Confirm Bulk Generation -->
<div class="modal fade" id="confirmBulkGenModal" tabindex="-1" aria-labelledby="confirmBulkGenLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="GenerateBulk">
                @Html.AntiForgeryToken()
                <input type="hidden" name="month" value="@Model.Month" />
                <input type="hidden" name="year" value="@Model.Year" />
                @if (Model.RouteId.HasValue)
                {
                    <input type="hidden" name="routeId" value="@Model.RouteId.Value" />
                }
                <div class="modal-header bg-light">
                    <h6 class="modal-title fw-bold" id="confirmBulkGenLabel">
                        <i class="cil-layers text-primary me-1"></i> Confirm Bulk Monthly Bill Generation
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-3">
                        You are about to generate draft monthly bills for <strong>@eligibleCount eligible customers</strong> for the billing period <strong>@(new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy"))</strong>.
                    </p>
                    <div class="alert alert-info border-info-subtle small mb-0">
                        <ul class="mb-0 ps-3">
                            <li>Accounts with existing bills for this month will be safely skipped.</li>
                            <li>Generated bills will remain in <strong>Draft</strong> status until explicitly published.</li>
                            <li>Historical unit prices and packaging quantities will be snapshotted immutably.</li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Start Bulk Generation</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Confirm Bulk Publishing -->
<div class="modal fade" id="confirmBulkPubModal" tabindex="-1" aria-labelledby="confirmBulkPubLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="BulkPublish">
                @Html.AntiForgeryToken()
                <input type="hidden" name="month" value="@Model.Month" />
                <input type="hidden" name="year" value="@Model.Year" />
                @if (Model.RouteId.HasValue)
                {
                    <input type="hidden" name="routeId" value="@Model.RouteId.Value" />
                }
                <div class="modal-header bg-light">
                    <h6 class="modal-title fw-bold" id="confirmBulkPubLabel">
                        <i class="cil-check-all text-success me-1"></i> Confirm Bulk Invoice Publishing
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-3">
                        This action will transition all <strong>Draft</strong> invoices for <strong>@(new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy"))</strong> to <strong>Published</strong> status.
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Payment Due Date / Grace Period (Optional)</label>
                        <div class="input-group">
                            <input type="number" name="graceDays" class="form-control" placeholder="Leave empty for no due date" min="1" max="90" value="" />
                            <span class="input-group-text small text-muted">days grace</span>
                        </div>
                        <div class="form-text small text-muted mt-1">
                            <i class="cil-info me-1"></i> <strong>Optional Admin Choice:</strong> Enter grace days to snapshot an authoritative due date for all newly published bills. If left blank, invoices will be published without a due date (<code>PaymentDueDate = NULL</code>) and will never be marked Overdue.
                        </div>
                    </div>
                    <div class="alert alert-warning border-warning-subtle small mb-0">
                        <i class="cil-warning me-1"></i> Once published, invoices cannot be modified without formal audited revisions, and completed delivery records are locked.
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-success text-white">Publish All Draft Invoices</button>
                </div>
            </form>
        </div>
    </div>
</div>
