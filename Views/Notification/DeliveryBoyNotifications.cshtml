@model IReadOnlyList<Dairy_Management_System.Models.Notification.NotificationListItemDto>
@{
    Layout = "_LayoutDeliveryBoy";
    ViewData["Title"] = "Route Bulletins & Notifications";
    ViewData["ActiveMenu"] = "Notifications";

    var unreadCount = Model.Count(n => !n.IsAcknowledged);
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a href="~/Home/Privacy" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Notifications</li>
            </ol>
        </nav>
        <h4 class="mb-0 fw-bold text-dark"><i class="cil-bell text-primary me-2"></i>Route Bulletins &amp; Alerts</h4>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span id="unreadAlertsBadge" data-unread-count="@unreadCount" class="badge @(unreadCount > 0 ? "bg-primary text-white" : "bg-light text-secondary border") px-3 py-2 font-tabular">
            @unreadCount Unread Alerts
        </span>
        @if (unreadCount > 0)
        {
            <form asp-controller="Notification" asp-action="MarkAllRead" method="post" id="markAllReadForm" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary btn-sm">
                    <i class="cil-check-double me-1"></i> Mark All Read
                </button>
            </form>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-3" role="alert">
        <i class="cil-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-coreui-dismiss="alert" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-3" role="alert">
        <i class="cil-warning me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-coreui-dismiss="alert" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 bg-white shadow-sm mb-4">
    <div class="card-body p-3 p-md-4">
        <div class="text-muted small">
            <i class="cil-info me-1 text-primary"></i> Acknowledging an alert records your read receipt for audit tracking. Read status changes never modify customer payment or balance data.
        </div>
    </div>
</div>

<!-- Notification Stream List -->
<div class="d-flex flex-column gap-3 mb-4" id="notificationsList">
    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="cil-check-circle fs-2 text-success d-block mb-2"></i>
                <h5 class="fw-bold text-dark">No Notifications</h5>
                <p class="text-muted small mb-0">Your route bulletin stream is completely up-to-date.</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var notif in Model)
        {
            <div class="card border-0 shadow-sm @(!notif.IsAcknowledged ? "border-start border-4 border-primary" : "")" id="notif-card-@notif.NotificationId">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2">
                        <div class="d-flex align-items-center gap-2">
                            @if (notif.NotificationType == "BillPublished")
                            {
                                <span class="badge bg-primary text-white">
                                    <i class="cil-description me-1"></i> Bill Published
                                </span>
                            }
                            else if (notif.NotificationType == "UrgentAlert")
                            {
                                <span class="badge bg-danger text-white">
                                    <i class="cil-warning me-1"></i> Urgent Alert
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-secondary border">
                                    <i class="cil-bullhorn me-1"></i> Announcement
                                </span>
                            }
                            <span class="text-muted small font-tabular">@notif.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>

                        <div id="status-badge-container-@notif.NotificationId">
                            @if (notif.IsAcknowledged)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="cil-check me-1"></i> Acknowledged
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                    <i class="cil-clock me-1"></i> Unread
                                </span>
                            }
                        </div>
                    </div>

                    <h5 class="fw-bold text-dark mb-2">@notif.Title</h5>
                    <p class="text-secondary mb-3">@notif.Message</p>

                    @if (notif.BillId.HasValue)
                    {
                        <div class="p-3 rounded bg-light border mb-3">
                            <div class="row g-2 align-items-center font-tabular small">
                                <div class="col-12 col-sm-6">
                                    <span class="text-muted">Customer:</span>
                                    <strong class="text-dark ms-1">@(string.IsNullOrWhiteSpace(notif.CustomerNameSnapshot) ? "Customer" : notif.CustomerNameSnapshot)</strong>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <span class="text-muted">Cycle:</span>
                                    <span class="badge bg-white border text-dark ms-1">@notif.BillingMonthYear</span>
                                </div>
                                <div class="col-6 col-sm-3 text-sm-end">
                                    <span class="text-muted">Balance:</span>
                                    <strong class="text-danger ms-1">₹ @(notif.NewTotalOutstandingBalance.HasValue ? notif.NewTotalOutstandingBalance.Value.ToString("N2") : "0.00")</strong>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                        <small class="text-muted">
                            <i class="cil-user me-1"></i> Dispatched by: @(string.IsNullOrEmpty(notif.CreatedByName) ? "System" : notif.CreatedByName)
                        </small>

                        @if (!notif.IsAcknowledged)
                        {
                            <button type="button" class="btn btn-outline-primary btn-sm px-3 btn-ack-notif" data-notif-id="@notif.NotificationId">
                                <i class="cil-check me-1"></i> Acknowledge
                            </button>
                        }
                        else
                        {
                            <small class="text-muted font-tabular">
                                Acknowledged @(notif.AcknowledgedAt.HasValue ? notif.AcknowledgedAt.Value.ToString("MMM dd, HH:mm") : "")
                            </small>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            document.querySelectorAll('.btn-ack-notif').forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    const notifId = this.getAttribute('data-notif-id');
                    if (!notifId) return;

                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Processing...';

                    try {
                        const formData = new URLSearchParams();
                        formData.append('notificationId', notifId);
                        formData.append('__RequestVerificationToken', token);

                        const response = await fetch('/Notification/Acknowledge', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: formData
                        });

                        const res = await response.json();
                        if (res.success) {
                            // Update badge
                            const container = document.getElementById('status-badge-container-' + notifId);
                            if (container) {
                                container.innerHTML = '<span class="badge bg-success-subtle text-success border border-success-subtle"><i class="cil-check me-1"></i> Acknowledged</span>';
                            }

                            // Update card border
                            const card = document.getElementById('notif-card-' + notifId) || btn.closest('.card');
                            if (card) {
                                card.classList.remove('border-start', 'border-4', 'border-primary');
                            }

                            // Update top unread counter badge
                            const unreadBadge = document.getElementById('unreadAlertsBadge');
                            if (unreadBadge) {
                                let cur = parseInt(unreadBadge.getAttribute('data-unread-count') || '0', 10);
                                let next = Math.max(0, cur - 1);
                                unreadBadge.setAttribute('data-unread-count', String(next));
                                unreadBadge.textContent = next + ' Unread Alerts';
                                if (next === 0) {
                                    unreadBadge.className = 'badge bg-light text-secondary border px-3 py-2 font-tabular';
                                    const markAllForm = document.getElementById('markAllReadForm');
                                    if (markAllForm) {
                                        markAllForm.classList.add('d-none');
                                    }
                                }
                            }

                            // Replace button with text
                            btn.outerHTML = '<small class="text-muted font-tabular">Acknowledged just now</small>';
                        } else {
                            btn.disabled = false;
                            btn.innerHTML = '<i class="cil-warning me-1"></i> Retry';
                        }
                    } catch (e) {
                        console.error('Failed to acknowledge notification', e);
                        btn.disabled = false;
                        btn.innerHTML = '<i class="cil-warning me-1"></i> Error (Retry)';
                    }
                });
            });
        });
    </script>
}
