@model IReadOnlyList<Dairy_Management_System.Models.Notification.NotificationListItemDto>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Notification Management Console";
    ViewData["ActiveMenu"] = "Notifications";

    var routes = ViewBag.Routes as IReadOnlyList<Dairy_Management_System.Models.Route.RouteLookupModel>
                 ?? Array.Empty<Dairy_Management_System.Models.Route.RouteLookupModel>();
}

<!-- Notification Hub Header -->
<div class="card border-0 bg-white shadow-sm mb-4">
    <div class="card-body py-3 px-3 px-md-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle p-2 text-white bg-success d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background-color: #059669 !important;">
                <i class="cil-bell fs-4"></i>
            </div>
            <div>
                <h5 class="mb-0 fw-bold text-dark">Notification &amp; Broadcast Console</h5>
                <div class="text-muted small">Dispatch system announcements and audit automatic bill publication alerts</div>
            </div>
        </div>

        <div>
            <button type="button" class="btn btn-success btn-sm px-3" data-coreui-toggle="modal" data-coreui-target="#composeNoticeModal">
                <i class="cil-plus me-1"></i> Compose Announcement
            </button>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="cil-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="cil-warning me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Notification Ledger Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
        <h6 class="mb-0 fw-bold text-dark">
            <i class="cil-list me-2 text-secondary"></i>Recent Notification History &amp; Delivery Log
        </h6>
        <span class="badge bg-light text-secondary border font-tabular">@Model.Count Notifications</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 font-tabular">
                <thead class="table-light fs-7 text-uppercase text-secondary">
                    <tr>
                        <th class="ps-3">Type / Date</th>
                        <th>Title &amp; Message</th>
                        <th>Target Audience</th>
                        <th>Target Route</th>
                        <th>Dispatched By</th>
                        <th class="text-center pe-3">Read Status</th>
                    </tr>
                </thead>
                <tbody class="fs-6">
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="cil-bell fs-3 d-block mb-2 text-secondary"></i>
                                No notifications found in the database. Use the Compose button to broadcast a bulletin.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var n in Model)
                        {
                            <tr>
                                <td class="ps-3 text-nowrap">
                                    <div class="fw-semibold text-dark">@n.CreatedAt.ToString("yyyy-MM-dd")</div>
                                    <div class="text-muted small">@n.CreatedAt.ToString("HH:mm:ss")</div>
                                    @if (n.NotificationType == "BillPublished")
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-7 mt-1">
                                            <i class="cil-description me-1"></i> Bill Published
                                        </span>
                                    }
                                    else if (n.NotificationType == "UrgentAlert")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-7 mt-1">
                                            <i class="cil-warning me-1"></i> Urgent Alert
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border fs-7 mt-1">
                                            <i class="cil-bullhorn me-1"></i> Announcement
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@n.Title</div>
                                    <div class="text-muted small" style="max-width: 400px;">@n.Message</div>
                                    @if (n.BillId.HasValue)
                                    {
                                        <div class="mt-1 small">
                                            <span class="text-secondary">Ref Bill #@n.BillId:</span>
                                            <span class="fw-medium text-dark">@(n.CustomerNameSnapshot ?? "Customer")</span> &bull;
                                            <span class="fw-bold text-danger">₹ @(n.NewTotalOutstandingBalance.HasValue ? n.NewTotalOutstandingBalance.Value.ToString("N2") : "0.00")</span>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border">
                                        @n.TargetRole
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(n.TargetRouteName))
                                    {
                                        <span class="badge bg-light text-secondary border">@n.TargetRouteName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">All Routes</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-secondary small">@(string.IsNullOrEmpty(n.CreatedByName) ? "System Auto" : n.CreatedByName)</span>
                                </td>
                                <td class="text-center pe-3">
                                    @if (n.IsAcknowledged)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="cil-check me-1"></i> Acknowledged (@n.AcknowledgementCount)
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(n.AcknowledgedByNames))
                                        {
                                            <div class="text-dark small fw-medium fs-7 mt-1">Read by: @n.AcknowledgedByNames</div>
                                        }
                                        @if (n.AcknowledgedAt.HasValue)
                                        {
                                            <div class="text-muted small font-tabular fs-7">@n.AcknowledgedAt.Value.ToString("MMM dd HH:mm")</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                            <i class="cil-clock me-1"></i> Pending
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Compose Notification Modal -->
<div class="modal fade" id="composeNoticeModal" tabindex="-1" aria-labelledby="composeNoticeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="Notification" asp-action="Broadcast">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white py-3" style="background-color: #059669 !important;">
                    <h5 class="modal-title fw-bold" id="composeNoticeModalLabel">
                        <i class="cil-bullhorn me-2"></i> Compose System Broadcast
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-coreui-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-3 p-md-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Announcement Title <span class="text-danger">*</span></label>
                        <input type="text" name="Title" class="form-control" placeholder="e.g. Morning Shift Dispatch Notice" required maxlength="100" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Alert Classification</label>
                            <select name="NotificationType" class="form-select">
                                <option value="GeneralAnnouncement" selected>General Announcement</option>
                                <option value="UrgentAlert">Urgent Operational Alert</option>
                                <option value="RouteUpdate">Route Assignment Update</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Target Role</label>
                            <select name="TargetRole" class="form-select">
                                <option value="All" selected>All Users (Staff &amp; Partners)</option>
                                <option value="DeliveryBoy">Delivery Boys Only</option>
                                <option value="Admin">Administrators Only</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Route Targeting (Optional)</label>
                        <select name="TargetRouteId" class="form-select">
                            <option value="">All Operational Routes</option>
                            @foreach (var r in routes)
                            {
                                <option value="@r.RouteId">@r.RouteName</option>
                            }
                        </select>
                        <div class="form-text small">Leave as 'All Operational Routes' to broadcast across all assigned delivery runs.</div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-secondary">Notification Message <span class="text-danger">*</span></label>
                        <textarea name="Message" class="form-control" rows="4" placeholder="Enter broadcast message body..." required maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-3">
                    <button type="button" class="btn btn-outline-secondary" data-coreui-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success px-4" style="background-color: #059669; border-color: #059669;">
                        <i class="cil-send me-1"></i> Dispatch Broadcast
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
